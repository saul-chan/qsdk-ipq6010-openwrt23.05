                            CallbackID  = HCI_RegisterEventCallback(HCIDriverID, HCI_DriverCallback, (unsigned long)&CallbackInfo);
-                           ret_val     = 0;
-                        }
+                           //ret_val     = 0;
+                        //}
                      }
                   }
                }
@@ -966,7 +968,7 @@ int Qualcomm_DownloadDevice(HCI_DriverIn
