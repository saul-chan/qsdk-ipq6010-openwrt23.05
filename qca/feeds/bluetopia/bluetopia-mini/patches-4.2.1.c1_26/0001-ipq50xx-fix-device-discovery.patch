From 79c8adc02adcdca59ecc5f45dba8b9e1a61baf48 Mon Sep 17 00:00:00 2001
From: Atchaya R <ratchaya@qti.qualcomm.com>
Date: Wed, 3 Aug 2022 18:50:02 +0530
Subject: [PATCH] bluetopia : Fix device discovery issue for IPQ50xx BT

Recently BT driver has introduced update boot/shutdown
flow to open/close along with ioctl, this has made the
device to power on/off with open/close() functions.

In order to handle this change in application, we should
open the device node once and should close only during
application quit/exit, this change helps to fix the open/close()
calls in IPQ50xx BT device.

Index: bluetopia-4.2.1.c1_26/bt_host/Build/Core/ss1btps/BSC.c
===================================================================
--- bluetopia-4.2.1.c1_26.orig/bt_host/Build/Core/ss1btps/BSC.c
+++ bluetopia-4.2.1.c1_26/bt_host/Build/Core/ss1btps/BSC.c
@@ -1668,6 +1668,9 @@ int BTPSAPI BSC_Initialize(HCI_DriverInf
    BD_ADDR_t      BD_ADDR;       /* For reading BD_ADDR for cert        */
    AccessDate_t   AccessDate;
    unsigned char *TempCert;
+#if POWER_RESET
+   extern int bt_fd;
+#endif
 
    /* If the Stack has not been Initialized, then we need to try to     */
    /* Initialize that Stack.                                            */
@@ -1703,6 +1706,9 @@ int BTPSAPI BSC_Initialize(HCI_DriverInf
             /* * NOTE We do not hold any Mutex'es at this point.  If    */
             /*        this function requires a lock, it can acquire the */
             /*        list lock.                                        */
+#if POWER_RESET
+            bt_fd = (unsigned int)HCI_OpenDriver(HCI_DriverInformation);
+#endif
             if(HCI_VS_InitializeBeforeHCIOpen(HCI_DriverInformation))
             {
 
@@ -1730,7 +1736,11 @@ int BTPSAPI BSC_Initialize(HCI_DriverInf
 
                   /* Before proceding any further make sure that an HCI */
                   /* Driver Can be opened.                              */
+#if POWER_RESET
+                  BTStackInfo->HCIDriverID = bt_fd;
+#else
                   BTStackInfo->HCIDriverID = (unsigned int)HCI_OpenDriver(HCI_DriverInformation);
+#endif
 
                   if((int)BTStackInfo->HCIDriverID > 0)
                   {
Index: bluetopia-4.2.1.c1_26/bt_host/Build/Linux/hcidrv_lin/HCIDRV.c
===================================================================
--- bluetopia-4.2.1.c1_26.orig/bt_host/Build/Linux/hcidrv_lin/HCIDRV.c
+++ bluetopia-4.2.1.c1_26/bt_host/Build/Linux/hcidrv_lin/HCIDRV.c
@@ -120,6 +120,9 @@ static Boolean_t HCITTYInitialized;
    /* Internal Function Prototypes.                                     */
 static size_t _strlcpy(char *Destination, BTPSCONST char *Source, size_t DstSize);
 
+#if POWER_RESET
+extern int bt_fd;
+#endif
 static unsigned int GetNextDriverID(void);
 static unsigned int GetNextCallbackID(void);
 static unsigned int GetNextPacketID(void);
@@ -1741,9 +1744,15 @@ int BTPSAPI HCI_OpenDriver(HCI_DriverInf
                      else
                         ret_val = 0;
 
+#if POWER_RESET
+                     if((!ret_val) && (bt_fd == -1))
+                        bt_fd = OpenComm(&(DriverInformation->DriverInformation.COMMDriverInformation), HCI_DriverCallback, DriverInfo.DriverID);
+                     ret_val = bt_fd;
+#else
                      /* Try to Open a COMM Driver.                      */
                      if(!ret_val)
                         ret_val = OpenComm(&(DriverInformation->DriverInformation.COMMDriverInformation), HCI_DriverCallback, DriverInfo.DriverID);
+#endif
 
                      if(ret_val > 0)
                      {
Index: bluetopia-4.2.1.c1_26/bt_host/Build/Ports/Platform/Maple/btpsvend/BTPSVEND.c
===================================================================
--- bluetopia-4.2.1.c1_26.orig/bt_host/Build/Ports/Platform/Maple/btpsvend/BTPSVEND.c
