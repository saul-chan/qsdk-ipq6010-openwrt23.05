[ -z "$LOG" ] && LOG="logger -t routing[$$] "

ROUTINGROOT="$DMROOT.Routing"

prefix_list="$prefix_list $ROUTINGROOT."
entry_execute_method_list="$entry_execute_method_list entry_execute_method_root_Routing"
entry_execute_method_list_forcedinform="$entry_execute_method_list_forcedinform entry_execute_method_root_Routing"

entry_execute_method_headparam_list="$entry_execute_method_headparam_list entry_execute_method_headparam_list_Routing"
entry_execute_method_tailparam_list="$entry_execute_method_tailparam_list entry_execute_method_tailparam_list_Routing"

entry_execute_method_root_Routing() {
	case "$1" in ""|"$DMROOT."|"$ROUTINGROOT."*)
		common_execute_method_obj "$ROUTINGROOT." "0"
		common_execute_method_param "$ROUTINGROOT.RouterNumberOfEntries" "0" "routing_get_numberofentries" "" "xsd:unsignedInt" "0"
        common_execute_method_obj "$ROUTINGROOT.Router." "0" "" "" "routing_browse_router_table_entries $1"
		return 0
		;;
	esac
	return $E_INVALID_PARAMETER_NAME
}

routing_get_numberofentries(){
    local num=0
    local table name
    while read line ; do
        if [ ${line:0:1} != "#" ]; then
            table=$(echo $line | awk -F ' ' '{print$1}')
            name=$(echo $line | awk -F ' ' '{print$2}' )
            if [ -n "$table" ] && [ -n "$name" ]; then
                let num++
            fi
	    fi	
    done < /etc/iproute2/rt_tables
    echo "$num"
}

routing_browse_router_table_entries(){
    local table name
    while read line ; do
        if [ ${line:0:1} != "#" ]; then
            table=$(echo $line | awk -F ' ' '{print$1}')
            name=$(echo $line | awk -F ' ' '{print$2}' )
            if [ -n "$table" ] && [ -n "$name" ]; then
                common_execute_method_obj "$ROUTINGROOT.Router.$table." "0" "" "" "routing_browse_router_table $table $name"
            fi
        fi
    done < /etc/iproute2/rt_tables
    return 0
}

routing_browse_router_table(){
    local table=$1
    local name=$2
    local num
    common_execute_method_param "$ROUTINGROOT.Router.$table.Enable" "1" "routing_table_get_enable $table" "routing_table_set_enable $table" "xsd:boolean" "0"
    common_execute_method_param "$ROUTINGROOT.Router.$table.Status" "0" "routing_table_get_status $table" "" "xsd:string" "0"
    common_execute_method_param "$ROUTINGROOT.Router.$table.Alias" "0" "echo $name" "" "xsd:string" "0"
    common_execute_method_param "$ROUTINGROOT.Router.$table.IPv4ForwardingNumberOfEntries" "0" "get_ipv4fwd_numberofentries $table" "" "xsd:unsignedInt" "0"
    common_execute_method_param "$ROUTINGROOT.Router.$table.IPv6ForwardingNumberOfEntries" "0" "get_ipv6fwd_numberofentries $table" "" "xsd:unsignedInt" "0"
    common_execute_method_obj "$ROUTINGROOT.Router.$table.IPv4Forwarding." "0" "" "" "routing_browse_ipv4_forwarding $table $name"
    common_execute_method_obj "$ROUTINGROOT.Router.$table.IPv6Forwarding." "0" "" "" "routing_browse_ipv6_forwarding $table $name"
}

routing_table_get_enable(){
    local table=$1
    echo "1"
}

routing_table_set_enable(){
    return E_INVALID_PARAMETER_NAME
}

routing_table_get_status(){
    #Disabled,Enabled,Error
    echo "Enabled"
}

get_ipv4fwd_numberofentries(){
    local table=$1
    ipv4_table_entries=$(ip route show table $table|grep -E "^[0-9]")
    local num=$(echo "$ipv4_table_entries" | wc -l )
    echo "$num"
}

get_ipv6fwd_numberofentries(){
    local table=$1
    ipv6_table_entries=$(ip route show table $table|grep -E "^[0-9a-z:]+" | grep -v -E '^local|broad')
    local num=$(echo "$ipv6_table_entries" | wc -l )
    echo "$num"
}

set_ipv4_forwarding(){
    return E_INVALID_PARAMETER_NAME
}

set_ipv6_forwarding(){
    return E_INVALID_PARAMETER_NAME
}

routing_browse_ipv4_forwarding(){
    local table=$1
    local name=$2
    ip route show table $table|grep -E "^[0-9]" | sub_ipv4_forwarding $table
}

sub_ipv4_forwarding(){
    local table=$1
    local i=0
    while read line; do
        let i++
        common_execute_method_param "$ROUTINGROOT.Router.$table.IPv4Forwarding.$i.Enable" "1" "echo 1" "set_ipv4_forwarding $table" "xsd:boolean" "0"
        common_execute_method_param "$ROUTINGROOT.Router.$table.IPv4Forwarding.$i.Status" "0" "echo Enabled" "" "xsd:string" "0"
        common_execute_method_param "$ROUTINGROOT.Router.$table.IPv4Forwarding.$i.StaticRoute" "0" "ipfwd_is_staticroute $line" "" "xsd:boolean" "0"
        common_execute_method_param "$ROUTINGROOT.Router.$table.IPv4Forwarding.$i.DestIPAddress" "0" "ipfwd_get_destipaddr $line" "" "xsd:string" "0"
        common_execute_method_param "$ROUTINGROOT.Router.$table.IPv4Forwarding.$i.DestSubnetMask" "0" "ipfwd_get_destsubnetmask $line" "" "xsd:string" "0"
        common_execute_method_param "$ROUTINGROOT.Router.$table.IPv4Forwarding.$i.GatewayIPAddress" "0" "ipfwd_get_gateway $line" "" "xsd:string" "0"
        common_execute_method_param "$ROUTINGROOT.Router.$table.IPv4Forwarding.$i.Interface" "0" "ipfwd_get_interface $line" "" "xsd:string" "0"
        common_execute_method_param "$ROUTINGROOT.Router.$table.IPv4Forwarding.$i.ForwardingMetric" "0" "ipfwd_get_metric $line" "" "xsd:unsignedInt" "0"
    done
}

routing_browse_ipv6_forwarding(){
    local table=$1
    local name=$2
    ip route show table $table|grep -E "^[0-9a-z:]+" | grep -v -E '^local|broad'| sub_ipv6_forwarding $table
}

sub_ipv6_forwarding(){
    local table=$1
    local i=0
    while read line; do
        let i++
        common_execute_method_param "$ROUTINGROOT.Router.$table.IPv6Forwarding.$i.Enable" "1" "echo 1" "set_ipv6_forwarding $table" "xsd:boolean" "0"
        common_execute_method_param "$ROUTINGROOT.Router.$table.IPv6Forwarding.$i.Status" "0" "echo Enabled" "" "xsd:string" "0"
        common_execute_method_param "$ROUTINGROOT.Router.$table.IPv6Forwarding.$i.DestIPPrefix" "0" "ipfwd_get_destipaddr $line" "" "xsd:string" "0"
        common_execute_method_param "$ROUTINGROOT.Router.$table.IPv4Forwarding.$i.Interface" "0" "ipfwd_get_interface $line" "" "xsd:string" "0"
        common_execute_method_param "$ROUTINGROOT.Router.$table.IPv6Forwarding.$i.NextHop" "0" "ipfwd_get_gateway $line" "" "xsd:string" "0"
    done
}

ipfwd_is_staticroute(){
    local line=$*
    echo "$line" | grep -q "proto static" && echo "1" && return 
    echo "0"
}

ipfwd_get_destipaddr(){
    local line=$*
    local addr=$(echo "$line" | awk -F ' dev ' '{print $1}')
    [ -n "$addr" ] && {
        eval "$(ipcalc.sh $addr)" ;  addr=$IP
    }
    echo ${addr##* }
}

ipfwd_get_destsubnetmask(){
    local line=$*
    local addr=$(echo "$line" | awk -F ' dev ' '{print $1}')
    [ -n "$addr" ] && {
        eval "$(ipcalc.sh $addr)" ; addr=$NETMASK
    }
    echo ${addr##* }
}

ipfwd_get_gateway(){
    local line="$*"
    if echo "$line" | grep -q " via ";  then
        local addr=$(echo "$line" | awk -F ' via ' '{print $2}')
        addr=${addr%% *}
        echo "$addr"
    else
        echo ""
    fi
}

config_interface(){
    local ifname
    local ip_int_instance
    config_get ifname           "$1" ifname
    config_get ip_int_instance  "$1" ip_int_instance
    if [ "$ifname" == "lan" ]; then
        ifname="br-lan"
    fi
    if [ "$ifname" == "$2" ]; then
        if [ -z "$ip_int_instance" ]; then
            echo "$ifname"
        else
            echo "Device.IP.Interface.$ip_int_instance"
        fi
    fi
}

ipfwd_get_interface(){
    local line=$*
    if echo "$line" | grep -q " dev ";  then
        local dev=$(echo "$line" | awk -F ' dev ' '{print $2}')
        dev=${dev%% *}
 #       echo "$dev"
        config_load network
        config_foreach config_interface interface $dev
    else
        echo ""
    fi

}

ipfwd_get_metric(){
    local line=$*
    if echo "$line" | grep -q " metric ";  then
        local metric=$(echo "$line" | awk -F ' metric ' '{print $2}')
        metric=${metric%% *}
        echo "$metric"
    else
        echo "0"
    fi
}