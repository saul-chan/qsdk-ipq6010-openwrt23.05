function vpn_wireguard_set_publickey(){
    local wg_if=$(vpn_wireguard_get_current_wireguard)
    if [ -z "$wg_if" ]; then
        wg_if=$(vpn_wireguard_create_wgobj)
    else
        local suffix=`$UCI_GET network.wgserver${wg_if:+_$wg_if} | cut -d '_' -f 2`
        [ "$suffix" != $wg_if ] &&{
