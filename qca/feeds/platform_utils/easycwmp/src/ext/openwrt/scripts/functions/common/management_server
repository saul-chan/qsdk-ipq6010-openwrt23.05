# 应用ACL规则到系统
acl_control_apply_rules() {
    # 重启bwlist服务以应用新规则
    if [ -f /etc/init.d/firewallon ]; then
        /etc/init.d/firewallon restart >/dev/null 2>&1
    fi
    
    # 同时重启防火墙以确保规则生效
    #/etc/init.d/firewall restart >/dev/null 2>&1
    
    $LOG "ACL rules applied via UCI bwlist"
    return 0
}

