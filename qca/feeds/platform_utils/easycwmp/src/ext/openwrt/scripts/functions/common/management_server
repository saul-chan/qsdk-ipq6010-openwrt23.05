			let m++
		done
		
		return 0;
		;;
	esac
	return $E_INVALID_PARAMETER_NAME;
}

# ACL实例浏览方法
acl_control_browse_instance() {
    local path="$1"
    local objid="$2"
    local mac="$3"
    
    common_execute_method_obj "$DMROOT.ManagementServer.ACL_Control.$objid." "0" "" ""
    common_execute_method_param "$DMROOT.ManagementServer.ACL_Control.$objid.MACAddress" "1" "acl_control_get_mac $objid" "acl_control_set_mac $2 $3" "xsd:string" "0"
    common_execute_method_param "$DMROOT.ManagementServer.ACL_Control.$objid.Target" "1" "acl_control_get_target $objid" "acl_control_set_target $2" "xsd:string" "0"
    
    return 0
}

#######################################
#   Data model parameters functions   #
#######################################
management_server_set_url() {
	local val=$1
	
	local chk=`echo $val | grep "[a-zA-Z0-9_]://.*"`
	[ "$chk" = "" ] && return $E_INVALID_PARAMETER_VALUE

	$UCI_SET easycwmp.@acs[0].url=$val
	return 0
}

management_server_set() {
	local cfg=$1
	local val=$2
	$UCI_SET $cfg="$val"
	return 0
}

management_server_set_periodic_enable() {
	local val=$1
	common_set_bool "easycwmp.@acs[0].periodic_enable" "$val" "1" "0"
	return 0
}

management_server_set_systemtime(){
	local time="$1"
#先判断是否启用了NTP时间同步,若启用的话就放弃用ACS时间设置成系统时间
	local pids=`ps w | grep ntpd | grep -v grep | awk '{print $1}'`
	if [ -n "$pids" ]; then
		return 0
	fi
	if [ -n "$time" ]; then
#从ACS收到的时间是毫秒的时间，需要转换成秒
		time=$((time / 1000))
#-d参数必须加@符号，否则时间会不正确
		local fmttime=$(date -d @"$time" "+%Y-%m-%d %H:%M:%S")
		if [ -n "$fmttime" ]; then
			date -s "$fmttime" 
		fi
	fi
	return 0
}

management_server_get_connection_request_url() {
	local val
	if [ -z "$default_management_server_connection_request_url" ]; then
		local intf=`$UCI_GET easycwmp.@local[0].interface 2> /dev/null`
		local ip=`ifconfig "$intf" | grep inet | sed 's/^ *//g' | cut -f 2 -d ' '|cut -f 2 -d ':'`
		local port=`$UCI_GET easycwmp.@local[0].port 2> /dev/null`

		if [ -n "$ip" -a -n "$port" ]; then
			val="http://$ip:$port/"
		fi
	else
		val=$default_management_server_connection_request_url
	fi
	echo $val
}

management_stun_set() {
    local cfg=$1
    local val=$2
    $UCI_SET $cfg="$val"
    /etc/init.d/stun-client restart
    return 0
}

management_stun_get() {
    local cfg=$1

    if [ "$cfg" == "ucra" ]; then
        ucra=`cat /tmp/stun_ucra 2> /dev/null`
        echo ${ucra:-""}
    elif [ "$cfg" == "natdetected" ]; then
        nat=`cat /tmp/stun_natdetected 2> /dev/null`
        if [ "$nat" != "" ]; then
            stun_enable=`$UCI_GET easycwmp.@local[0].stun_enable`
            if [ "$stun_enable" == "1" ]; then
                echo ${nat:-0}
            else
                echo "0"
            fi
        else
        	echo "0"
        fi
    else
        echo ""
    fi
}

management_x_service_control(){
	local service=${1%% *}
	local action=${1#* }
	# echo "$service " > /tmp/test_acl
	# echo "$action" >> /tmp/test_acl
	if [ "$service" == "bwlist" ];then
		sub_action="${action% *}"   # "delete 4" → "delete"
		param="${action#* }"        # "delete 4" → "4"
	fi
	#开列禁止停掉、禁用的服务,这些服务不可以停掉，否则设备将不能正常工作
	local PROHIBIT_STOP_SERVICE="network easycwmpd bwlist"
	local ALLOW_ACTIONS="start stop restart reload enable disable boot delete"
	if [ -z "$service" ] || [ -z "$action" ]; then
		return
	fi
	# echo "$service $action" >> /tmp/test
	if [ "$service" == "dropbear" ] && [ "$action" == "start" ];then
		# echo $service >> /tmp/test
		local res=$(uci -q show dropbear)
		if [ -z "$res" ];then
uci -q batch <<-EOF >/dev/null
        add dropbear dropbear
        set dropbear.@dropbear[-1].Port=22
        set dropbear.@dropbear[-1].PasswordAuth=on
        commit dropbear
EOF
		fi
	fi
	if [ "$action" = "stop" ] || [ "$action" = "disable" ]; then
		for svc in $PROHIBIT_STOP_SERVICE; do
			if [ "$svc" = "$service" ]; then
				return
			fi
		done
	fi
	if [ "$service" == "bwlist" ];then
		# echo $service >> /tmp/test_acl
		# echo $sub_action >> /tmp/test_acl
		# echo $param >> /tmp/test_acl
		if [ "$sub_action" == "delete" ];then
			uci -q delete bwlist.$param
			uci commit bwlist
			/etc/init.d/firewallon restart &
			return
		fi
	fi
	[ -x /etc/init.d/${service} ] && {
		for cmd in $ALLOW_ACTIONS; do
			if [ $cmd = $action ]; then
				# echo ${action} >> /tmp/test
				/etc/init.d/${service} ${action} >/dev/null
				return
			fi
		done
	}
	
}

