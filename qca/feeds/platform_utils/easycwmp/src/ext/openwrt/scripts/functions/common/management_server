# 初始化bwlist配置
acl_control_init_uci() {
    # 检查bwlist配置是否存在
    if ! uci -q get bwlist.main >/dev/null; then
        uci set bwlist.main=bwlist
        uci set bwlist.main.mode='black'  # 默认黑名单模式
        uci commit bwlist
    fi
}

# 获取ACL条目数量（基于启用的规则）
acl_control_get_count() {
    acl_control_init_uci
    
    # 计算启用的规则数量
    local count=0
    local i=0
    
    # 遍历所有规则
    while uci -q get "bwlist.@rule[$i]" >/dev/null; do
        local enabled=$(uci -q get "bwlist.@rule[$i].enabled")
        # 如果没有enabled字段或者enabled=1，则认为是启用的
        if [ -z "$enabled" ] || [ "$enabled" = "1" ]; then
            count=$((count + 1))
        fi
        i=$((i + 1))
    done
    
    echo $count
}

# 获取指定索引的MAC地址（基于启用的规则）
acl_control_get_mac() {
    local index="$1"
    acl_control_init_uci
    
    # 验证索引
    if [ -z "$index" ] || [ "$index" -lt 1 ]; then
        echo ""
        return
    fi
    
    if uci -q get "bwlist.$index" >/dev/null; then
        local enabled=$(uci -q get "bwlist.$index.enabled")
        
        # 检查是否启用
        if [ -z "$enabled" ] || [ "$enabled" = "1" ]; then
            local mac=$(uci -q get "bwlist.$index.src_mac")
            echo "$mac"
            return 0
        fi
    fi
    
    echo ""  # 没有找到对应的规则
}

# 设置指定索引的MAC地址
acl_control_set_mac() {
    local index="$1"
    local mac="$2"
    acl_control_init_uci
    
    # 验证MAC地址格式
    if ! echo "$mac" | grep -qiE '^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$'; then
        return $E_INVALID_PARAMETER_VALUE
    fi
    #echo $mac > /tmp/test
    # 转换为大写，保持一致性
    mac=$(echo "$mac" | tr '[:lower:]' '[:upper:]' | sed 's/-/:/g')
    
    if uci -q get "bwlist.$1" >/dev/null; then
        # 更新现有规则
        uci set "bwlist.$1.src_mac=$mac"
        uci set "bwlist.$1.proto=all"
        uci set "bwlist.$1.src=lan"
        uci set "bwlist.$1.src_mac=$mac"
        uci set "bwlist.$1.dest=wan"
        uci set "bwlist.$1.enabled=1"
		
		# 根据模式设置默认target
        local mode=$(uci -q get bwlist.main.mode)
        if [ "$mode" = "white" ]; then
            uci set "bwlist.$1.target=REJECT"
        else
            uci set "bwlist.$1.target=ACCEPT"
        fi
    else
        # 创建新规则
        uci set "bwlist.$1=rule"
        uci set "bwlist.$1.proto=all"
        uci set "bwlist.$1.src=lan"
        uci set "bwlist.$1.src_mac=$mac"
        uci set "bwlist.$1.dest=wan"
        # 默认启用
        uci set "bwlist.$1.enabled=1"
        
        # 根据模式设置默认target
        local mode=$(uci -q get bwlist.main.mode)
        if [ "$mode" = "white" ]; then
            uci set "bwlist.$1.target=REJECT"
        else
            uci set "bwlist.$1.target=ACCEPT"
        fi
    fi
    
    # 提交更改
    uci commit bwlist
    
    # 应用ACL规则
    acl_control_apply_rules
    return 0
}

# 获取指定索引的Target
acl_control_get_target() {
    local index="$1"
    acl_control_init_uci
    
    # 验证索引
    if [ -z "$index" ] || [ "$index" -lt 1 ]; then
        echo "REJECT"
        return
    fi
    
    if uci -q get "bwlist.$1" >/dev/null; then
        # 更新现有规则
        local target=$(uci -q get bwlist.$1.target)
        # 确保规则是启用的
		echo "$target"
		return
        
    fi
    
    echo "REJECT"  # 默认值
}

# 设置指定索引的Target
acl_control_set_target() {
    local index="$1"
    local target="$2"
    acl_control_init_uci
    
    # 验证Target值
    if [ "$target" != "ACCEPT" ] && [ "$target" != "REJECT" ]; then
        return $E_INVALID_PARAMETER_VALUE
    fi
	
	if uci -q get "bwlist.$1" >/dev/null; then
        # 更新现有规则
        uci set "bwlist.$1.target=$target"
        # 确保规则是启用的
        uci set "bwlist.$1.enabled=1"
    else
        # 创建新规则
        uci set "bwlist.$1=rule"
        uci set "bwlist.$1.proto=all"
        uci set "bwlist.$1.src=lan"
        uci set "bwlist.$1.target=$target"
        uci set "bwlist.$1.dest=wan"
        # 但不启用
        uci set "bwlist.$1.enabled=0"
    fi
    
    # 提交更改
    uci commit bwlist
    
    # 应用ACL规则
    acl_control_apply_rules
    return 0
}

# 获取指定索引的Enabled状态
acl_control_get_enabled() {
    local index="$1"
    acl_control_init_uci
    
    # 验证索引
    if [ -z "$index" ] || [ "$index" -lt 1 ]; then
        echo "0"
        return
    fi
    
    local enabled_count=0
    local i=0
    
    while uci -q get "bwlist.@rule[$i]" >/dev/null; do
        local enabled=$(uci -q get "bwlist.@rule[$i].enabled")
        
        if [ -z "$enabled" ] || [ "$enabled" = "1" ]; then
            enabled_count=$((enabled_count + 1))
            
            if [ "$enabled_count" -eq "$index" ]; then
                echo "1"
                return 0
            fi
        fi
        i=$((i + 1))
    done
    
    echo "0"
}

# 设置指定索引的Enabled状态
acl_control_set_enabled() {
    local index="$1"
    local enabled="$2"
    acl_control_init_uci
    
    # 验证Enabled值
    if [ "$enabled" != "0" ] && [ "$enabled" != "1" ] && 
       [ "$enabled" != "true" ] && [ "$enabled" != "false" ]; then
        return $E_INVALID_PARAMETER_VALUE
    fi
    
    # 转换为数字格式
    if [ "$enabled" = "true" ]; then
        enabled="1"
    elif [ "$enabled" = "false" ]; then
        enabled="0"
    fi
    
    # 按顺序查找第index个规则（不考虑启用状态）
    local rule_count=0
    local target_uci_index=-1
    local i=0
    
    while uci -q get "bwlist.@rule[$i]" >/dev/null; do
        rule_count=$((rule_count + 1))
        if [ "$rule_count" -eq "$index" ]; then
            target_uci_index=$i
            break
        fi
        i=$((i + 1))
    done
    
    if [ "$target_uci_index" -ge 0 ]; then
        # 设置启用状态
        uci set "bwlist.@rule[$target_uci_index].enabled=$enabled"
    elif [ "$enabled" = "1" ]; then
        # 如果规则不存在但需要启用，创建新规则
        uci add bwlist rule
        uci set "bwlist.@rule[-1].proto=all"
        uci set "bwlist.@rule[-1].src=lan"
        uci set "bwlist.@rule[-1].src_mac=00:00:00:00:00:00"
        uci set "bwlist.@rule[-1].dest=wan"
        uci set "bwlist.@rule[-1].enabled=1"
        
        # 根据模式设置默认target
        local mode=$(uci -q get bwlist.main.mode)
        if [ "$mode" = "white" ]; then
            uci set "bwlist.@rule[-1].target=REJECT"
        else
            uci set "bwlist.@rule[-1].target=ACCEPT"
        fi
    fi
    
    # 提交更改
    uci commit bwlist
    
    # 应用ACL规则
    acl_control_apply_rules
    return 0
}

# 获取指定索引的Description
acl_control_get_description() {
    local index="$1"
    acl_control_init_uci
    
    local enabled_count=0
    local i=0
    
    while uci -q get "bwlist.@rule[$i]" >/dev/null; do
        local enabled=$(uci -q get "bwlist.@rule[$i].enabled")
        
        if [ -z "$enabled" ] || [ "$enabled" = "1" ]; then
            enabled_count=$((enabled_count + 1))
            
            if [ "$enabled_count" -eq "$index" ]; then
                local comment=$(uci -q get "bwlist.@rule[$i].comment")
                echo "$comment"
                return 0
            fi
        fi
        i=$((i + 1))
    done
    
    echo ""
}

# 设置指定索引的Description
acl_control_set_description() {
    local index="$1"
    local description="$2"
    acl_control_init_uci
    
    local enabled_count=0
    local i=0
    
    while uci -q get "bwlist.@rule[$i]" >/dev/null; do
        local enabled=$(uci -q get "bwlist.@rule[$i].enabled")
        
        if [ -z "$enabled" ] || [ "$enabled" = "1" ]; then
            enabled_count=$((enabled_count + 1))
            
            if [ "$enabled_count" -eq "$index" ]; then
                # 设置comment字段作为description
                uci set "bwlist.@rule[$i].comment=$description"
                uci commit bwlist
                return 0
            fi
        fi
        i=$((i + 1))
    done
    
    return 0
}

