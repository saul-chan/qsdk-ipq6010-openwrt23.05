gretunnel_get_name(){
	local section="$1"
	local name=`$UCI_GET network.$section.name`
	if [ -z "$name" ]; then
		name="$section"
	fi
	echo "$name"
}

gretunnel_set_name(){
	local section="$1"
	local name="$2"
	$UCI_SET network.$section.name="$name"
	$UCI_COMMIT network	
	return 0
}

gretunnel_get_peeraddr(){
	local section="$1"
	local peeraddr=`$UCI_GET network.$section.peeraddr`
	echo "$peeraddr"		
}

gretunnel_set_ipaddr(){
	local ipaddr
	ipaddr=$(manage_5glan_get_5gipaddr)
	[ -n "$ipaddr" ] && $UCI_SET network.$section.ipaddr="$ipaddr" && $UCI_COMMIT network && return 0 || return 1
}

gretunnel_set_peeraddr(){
	local section="$1"
	local peeraddr="$2"
	$UCI_SET network.$section.peeraddr="$peeraddr"
	gretunnel_set_ipaddr || $UCI_COMMIT network
	return 0
}

