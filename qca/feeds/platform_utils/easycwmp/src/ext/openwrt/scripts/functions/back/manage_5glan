#defined in src/bin/hamcore/strtable_en.stb
#PW_TYPE_0                               Anonymous Authentication
#PW_TYPE_1                               Standard Password Authentication
#PW_TYPE_2                               RADIUS or NT Domain Authentication
#PW_TYPE_3                               Client Certificate Authentication
#PW_TYPE_4                               Smart Card Authentication
#PW_TYPE_5                               Openssl Engine Authentication

softether_get_authentication_type(){
	local mode=$1
	local authtype
	if [ "$mode" == "client" ]; then
		softether_get_client_connection_setting
		authtype=`echo "$client_conn_setting" | grep "Authentication Type"`	
	else
		softether_get_bridge_cascadeconn_setting
		authtype=`echo "$cascade_conn_setting" | grep "Authentication Type"`	
	fi
	if [ -z "$authtype" ]; then
		echo "PW_TYPE_1"
	else
		case "$authtype" in
			*",Anonymous Authentication")
				echo "PW_TYPE_0"
				;;
			*",Standard Password Authentication")	
				echo "PW_TYPE_1"
				;;
			*",RADIUS or NT Domain Authentication")
				echo "PW_TYPE_2"
				;;
			*",Client Certificate Authentication")
				echo "PW_TYPE_3"
				;;
			*",Smart Card Authentication")
				echo "PW_TYPE_4"
				;;
			*",Openssl Engine Authentication")
				echo "PW_TYPE_5"
				;;
			*)
				echo "PW_TYPE_UNKNOWN"
				;;
		esac
		
	fi
}

softether_get_bridge_authtype(){
	local authtype=$(softether_get_authentication_type "bridge") 
	case "$authtype" in
		"PW_TYPE_1"|"PW_TYPE_2")
			echo "0"
			;;
		"PW_TYPE_3")
			echo "1"
			;;
		*)
			echo "-1"
			;;
	esac		
}

