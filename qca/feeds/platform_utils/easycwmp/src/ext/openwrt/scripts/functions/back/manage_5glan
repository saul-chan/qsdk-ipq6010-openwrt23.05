softether_set_client_maxconnection(){
	if [ $(softether_get_enable "client") == "0" ]; then
		return 0
	fi
#AccountDetailSet [name] [/MAXTCP:max_connection] [/INTERVAL:additional_interval] [/TTL:disconnect_span] [/HALF:yes|no] [/BRIDGE:yes|no] [/MONITOR:  yes|no] [/NOTRACK:yesno] [/NOQOS:yes|no]
	local maxconn=$1
	if [ -z "$maxconn" ]; then
		return 0
	fi
	ensure_client_connname_exist
	softether_get_client_connection_setting
	local interval ttl half bridge monitor notrack qos 
	interval=$(echo "$client_conn_setting" | grep "Interval between Establishing Each TCP Connection" | awk -F ',' '{print $2}')
	[ -z "$interval" ] && interval="1"			
	ttl=$(echo "$client_conn_setting" | grep "Connection Life of Each TCP Connection" | awk -F ',' '{print $2}'| tr '[A-Z]' '[a-z]')
	if [ "$ttl" == "infinite" ]; then
		ttl="0"
	fi
	[ -z "$ttl" ] && ttl="-1"
	half=$(echo "$client_conn_setting" | grep "Use Half Duplex Mode" | awk -F ',' '{print $2}' | tr '[A-Z]' '[a-z]')
	if [ "$half" == "enable" ];then
		half="yes"
	else
		half="no"
	fi
	bridge=$(echo "$client_conn_setting" | grep "Connect by Bridge" | awk -F ',' '{print $2}' | tr '[A-Z]' '[a-z]')
	if [ "$bridge" == "enable" ]; then
		bridge="yes"
	else
		bridge="no"
	fi
	monitor=$(echo "$client_conn_setting" | grep "Connect by Monitoring Mode" | awk -F ',' '{print $2}' | tr '[A-Z]' '[a-z]') 
	if [ "$monitor" == "enable" ]; then
		monitor="yes"
	else
		monitor="no"
	fi	

	notrack=$(echo "$client_conn_setting" | grep "No Adjustment for Routing Table" | awk -F ',' '{print $2}' | tr '[A-Z]' '[a-z]')
	if [ "$notrack" == "enable" ]; then
		notrack="yes"
	else
		notrack="no"
	fi
	qos=$(echo "$client_conn_setting" | grep "Do not Use QoS Control Function" | awk -F ',' '{print $2}' | tr '[A-Z]' '[a-z]')
	if [ "$qos" == "enable" ]; then
		qos="yes"
	else
		qos="no"
	fi
	local msg=`$VPNCMD $LOCALHOST:$SERVER_PORT /CLIENT /CSV /CMD AccountDetailSet $CLIENT_CONN_NAME /MAXTCP:$maxconn /INTERVAL:$interval /TTL:$ttl /HALF:$half /BRIDGE:$bridge /MONITOR:$monitor /NOTRACK:$notrack /NOQOS:$qos`
	destroy_client_conn_setting
	return 0
}

