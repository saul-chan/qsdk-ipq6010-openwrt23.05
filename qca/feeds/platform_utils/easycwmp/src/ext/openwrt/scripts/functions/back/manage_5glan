_getErrorCode(){
        local msg="$1"
        local errcode=$(echo "$msg" | grep -i "Error code:")
        [ -z "$errcode" ] && echo "" && return
        errcode=${errcode#*:}
        errcode=${errcode%%\)}
        echo "$errcode"
}

_isCmdCompleted(){
        local msg=$1
        local num=$2
        if [ -z num ]; then
                num=1
        fi
        local ret=$(echo "$msg" | grep -i "command completed successfully" | wc -l)
        if [ -z "$ret" ]; then
                echo "0"
        elif [ $ret -ge $num ]; then
                echo "1"
        else
                echo "0"
        fi
}

manage_5glan_get_enable(){
	local val=`$UCI_GET ssw.@ssw[0].enable`
	if [ -z "$val" ]; then
		val="0"
	fi
	echo "$val"
}

manage_5glan_set_enable(){
	local val=$1
	if [ "$val" == "true" -o "$val" == 1 ]; then
		/etc/init.d/ssw enable
		/etc/init.d/ssw restart
	else
		/etc/init.d/ssw disable
		/etc/init.d/ssw stop
	fi	
	return 0
}

manage_5glan_get_5gipaddr(){
        local network ipaddr 
        network=`$UCI_GET network.5g.ifname` 
        if [ -z "$network" ]; then
		echo ""
		return 1	
	else
        	ipaddr=$(get_interface_inetaddr $network)
		echo "$ipaddr"
		return 0
	fi
}

is_bridge_connname_exist(){
	local val
	create_bridge_cascadeget_tmp_file
	val=`$VPNCMD localhost:$SERVER_PORT /SERVER /PASSWORD:$BRIDGE_ADMIN_PWD /IN:"$bridge_cascadeget_tmp_file" /CSV`
	local errcode=$(_getErrorCode "$val")                                                                                                 
        if [ -n "$errcode" ]; then                                                                                                            
                #error occured, not go next                                                                                                   
		echo "0"
                return                                                                                                                        
        fi
	val=`echo "$val" | grep "Object not found." | wc -l`
	if [ "$val" == "1" ]; then
		echo "0"
	else
		echo "1"		
	fi
}

is_client_connname_exist(){
	local msg val
	msg=`$VPNCMD $LOCALHOST:$SERVER_PORT /CLIENT /CSV /CMD AccountList`
	local errcode=$(_getErrorCode "$msg")                                                                                                 
        if [ -n "$errcode" ]; then                                                                                                            
                #error occured, not go next                                                                                                   
		echo "0"
                return                                                                                                                        
        fi
	val=$(echo "$msg" | tail -n +4 | cut -d ',' -f1)
	local found=0
	for c in $val ;do
		if [ "$c" == "$CLIENT_CONN_NAME" ]; then
			found=1
			break
		fi
	done
	[ $found == 1 ] && echo "1" || echo "0"
}

