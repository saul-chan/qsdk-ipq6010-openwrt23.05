softether_set_cascadecert(){
	local cert="$1"
	local key="$2"
	local fault=0
	local tmpval
	tmpval=$(echo "$cert" | base64 -d) 
	if [ $? == 0 ]; then 
		cert="$tmpval"
	else
		$LOG "set cascadeconn cert fail,reason decode cert fail.[crt=$cert]"
		return 
	fi 
	tmpval=$(echo "$key" | base64 -d) 
    if [ $? == 0 ]; then 
    	key="$tmpval"  
    else
    	$LOG "set cascadeconn cert fail,reason decode key fail.[key=$key]"
        return
    fi 

    wget -P /tmp/ -O bridge.crt -T 5 "$cert"
    fault="$?"
    if [ "$fault" == "0" ]; then
    	wget -P /tmp/ -O bridge.key -T 5 "$key"
        fault="$?" 
        if [ "$fault" == "0" ]; then
			rm -f "$bridge_cascade_generic_cmd_file"
cat >> "$bridge_cascade_generic_cmd_file" <<EOF
hub bridge
CascadeCertSet $BRIDGE_CONN_NAME /LOADCERT:/tmp/bridge.crt /LOADKEY:/tmp/bridge.key
EOF
			ensure_bridge_connname_exist
			local msg=`$VPNCMD localhost:$SERVER_PORT /SERVER /PASSWORD:$BRIDGE_ADMIN_PWD /IN:"$bridge_cascade_generic_cmd_file"`
		fi
	fi
	rm -f /tmp/bridge.crt
	rm -f /tmp/bridge.key
}

