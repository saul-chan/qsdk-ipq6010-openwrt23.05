softether_set_client_certkey(){
	local cert="$1"
	local key="$2"
	local fault=0
	local tmpval
	tmpval=$(echo "$cert" | base64 -d)
	if [ $? == 0 ]; then
		cert="$tmpval"
	else
		$LOG "set client cert fail,reason decode cert fail"
		return
	fi	
	tmpval=$(echo "$key" | base64 -d)
	if [ $? == 0 ]; then
		key="$tmpval"
	else
		$LOG "set client cert fail,reason decode key fail" 
		return
	fi
	wget -P /tmp/ -O client.crt -T 5 "$cert"
	fault="$?"
	if [ "$fault" == "0" ]; then
		wget -P /tmp/ -O client.key -T 5 "$key"	
		fault="$?"
		if [ "$fault" == "0" ]; then
			ensure_client_connname_exist
			local msg=`$VPNCMD $LOCALHOST:$SERVER_PORT /CLIENT /CSV /CMD AccountCertSet $CLIENT_CONN_NAME /LOADCERT:/tmp/client.crt /LOADKEY:/tmp/client.key`
		fi
	fi 	
	rm -f /tmp/client.crt
	rm -f /tmp/client.key
}

