        $UCI_COMMIT network
        return 0                                                                                     
}  

gretunnel_get_connectionstatus(){
	local devname="gre4t-$1"	
	local brifname=`$UCI_GET network.lan.ifname`
	local status="0"
	for if in $brifname;do
		if [ "$if" == "$devname" ]; then
			status="1"	
			break
		fi
	done	
	echo "$status"
}

gretunnel_set_connectionstatus(){
	local devname="gre4t-$1"
	local status="$2"
	local brifname=`$UCI_GET network.lan.ifname`
	local nwbrifname=""
	local found=0
	for if in $brifname; do
		if [ "$if" != "$devname" ]; then
			[ -z "$nwbrifname" ] && nwbrifname="$if" || nwbrifname="$nwbrifname $if"
		else
			found=1
		fi
	done	
	if [ "$status" == "1" -o "$status" == "true" ]; then
		nwbrifname="$nwbrifname $devname"
		local ipaddr1=`$UCI_GET network.$1.ipaddr`
		local ipaddr2=$(manage_5glan_get_5gipaddr)
		if [ -n "$ipaddr2" -a "$ipaddr1" != "$ipaddr2" ]; then
			$UCI_SET network.$1.ipaddr="$ipaddr2"
		fi	
	elif [ $found == 0 ]; then
		return 0
	fi
	$UCI_SET network.lan.ifname="$nwbrifname"
	$UCI_COMMIT network
	/etc/init.d/network reload
	return 0
}

