ssw_get(){
	local val=`$UCI_GET $1`
	echo "${val:-$2}"
}

ssw_set(){
	if [ -n "$2" ]; then
		$UCI_SET "$1"="$2"
	else
		$UCI_DELETE "$1"
	fi
	if [ $(echo "$1" | grep -E "^ssw\.@ssw\[0\]\.br") ]; then
		$UCI_SET ssw.@ssw[0].brdirty='1'
	elif [ $(echo "$1" | grep -E "^ssw\.@ssw\[0\]\.cli") ]; then
		$UCI_SET ssw.@ssw[0].clidirty='1'
	fi
	return 0
}

softether_get_enable(){
	local opt=$1
	if [ -z "opt" ]; then
		echo "0"
		return
	fi
	local options=`$UCI_GET ssw.@ssw[0].options`
	for o in $options; do
		if [ "$o" == "$opt" ];then
			echo "1"
			return
		fi
	done
	echo "0"
}

softether_set_enable(){
	local opt=$1
	local val=$2
	local options=`$UCI_GET ssw.@ssw[0].options`
	local newopts=""
	local isserver=0
	[ "$opt" == "server" ] && isserver=1

	if [ "$val" == "true" -o "$val" == "1" ]; then
		val=1
	else
		val=0
	fi
	local msg=""
	for o in $options; do
		if [ $isserver == 1 -a "$o" != "server" ]; then
			msg=`/usr/bin/env LANG=en_US.UTF-8 /usr/libexec/ssw/ssw_$o stop`
		fi
		if [ "$o" != "$opt" ]; then
			if [ -z "$newopts" ]; then
				newopts="$o"
			else
				newopts="$newopts $o"
			fi
		elif [ $val == 0 ]; then
			msg=`/usr/bin/env LANG=en_US.UTF-8 /usr/libexec/ssw/ssw_$o stop`
		elif [ $val == 1 ]; then
			msg=`/usr/bin/env LANG=en_US.UTF-8 /usr/libexec/ssw/ssw_$o start`
		fi
	done
	
	if [ $val == 1 ]; then
		[ -z "$newopts" ] && newopts="$opt" || newopts="$newopts $opt"
		msg=`/usr/bin/env LANG=en_US.UTF-8 /usr/libexec/ssw/ssw_$opt start`

	fi	
	$UCI_SET ssw.@ssw[0].options="$newopts"
	return 0
}

