gretunnel_add_tunnel(){
#$LOG "#### gretunnel_add_tunnel i=$i instance=$instance , param1=$1"
	local instance=$(gretunnel_alloc_instid)
	local network section
	local instid=$(gretunnel_alloc_ip_int_instance)
	network=`$UCI_GET network.5g.ifname` 
	section="tun"$instance
	$UCI_SET network.$section="interface"
	$UCI_SET network.$section.proto="gretap"
	$UCI_SET network.$section.mtu=1482
	$UCI_SET network.$section.df=0
	$UCI_SET network.$section.network="$network"
	$UCI_SET network.$section.ip_int_instance="$instid"
	$UCI_COMMIT network
#$LOG "#### gretunnel_add_tunnel ok, instid=$instid, section=$section"
	echo "$instid"
}

gretunnel_del_tunnel(){
	local section="$1"
	if [ -n "$section" ]; then
		gretunnel_set_connectionstatus $section "0"
		$UCI_DELETE network.$section	
		$UCI_COMMIT network
	fi
	return 0
}

gretunnel_alloc_instid(){
	local from=$1
	if [ -z "$from" ]; then
		from=1
	fi
	local instance=$from
	local index=0
	local type objid found section
	local proto
#$LOG ">>>>>> alloc instid "
	while [ 1 ]; do
		found=0
		index=0
		section="tun"$instance
		type=`$UCI_GET network.$section`
		if [ -z "$type" ]; then
			break
		fi
		let instance++
	done
#$LOG ">>>>> alloc instid=$instance"
	echo "$instance"
}

gretunnel_alloc_ip_int_instance(){
	local from=$1
	if [ -z "$from" ]; then
		from=0
	fi
	local ipinstance=$from
	local val indeax type
	local intval
	index=0
	while [ 1 ];do
		type=`$UCI_GET network.@interface[$index]`
		if [ -z "$type" ]; then
			break
		fi
		val=`$UCI_GET network.@interface[$index].ip_int_instance`
		if [ -n "$val" ]; then
			intval=$(echo "$val" | awk '{print int($0)}')
			if [ $intval -gt $ipinstance ]; then
				ipinstance=$intval
			fi
		fi	
		let index++
	done	
	let ipinstance++
	echo "$ipinstance"
}


gretunnel_browse_instance(){
	local index=0
	local proto
	local section
	local instid=1
	local interface
	local changed=0
	while [ $index != -1 ]; do
		interface=`$UCI_GET network.@interface[$index]`
		if [ -z "$interface" ]; then
			index=-1
			continue
		fi
		proto=`$UCI_GET network.@interface[$index].proto`
		if [ "$proto" != "gretap" ]; then
			let index++
			continue
		fi
		section=`$UCI_SHOW network.@interface[$index] | grep "=interface" | awk -F '=' '{print $1}'| awk -F '.' '{print $2}' `
		if [ -n "$section" ]; then
			instid=`$UCI_GET network.@interface[$index].ip_int_instance`
			if [ -z "$instid" ]; then
				instid=$(gretunnel_alloc_ip_int_instance)
				$UCI_SET network.@interface[$index].ip_int_instance="$instid"	
				changed=1
			fi
			sub_entry_gretap "$1" "$instid" "$section"
		fi
		let index++
	done
	if [ $changed != 0 ]; then
		$UCI_COMMIT network
	fi
	return 0
}

