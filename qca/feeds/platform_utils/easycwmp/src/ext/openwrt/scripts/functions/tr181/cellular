cellular_iface_Dial(){
	local action=$2
	case $action in 
		Requested)
			$UCI_SET_VARSTATE easycwmp.@local[0].X_Dial=Requested
#发起拨号			
			common_execute_command_in_apply_service "/bin/sh $FUNCTION_PATH/cellular_launch dial &"
			return 0
		;;
		Cancel)
			cellular_stop_dial
			return 0
		;;
	esac
	return $E_INVALID_PARAMETER_VALUE;
}

