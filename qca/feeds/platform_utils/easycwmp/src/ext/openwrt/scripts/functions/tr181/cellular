cellular_iface_get_max_instance() {
	local max=`$UCI_SHOW modem | grep "iface_int_instance" | cut -d'=' -f2 | sed 's/[^0-9]*//g' | sort -nru | head -1`
	echo ${max:-0}
}


cellular_add_interface(){
	local instance=`cellular_iface_get_max_instance`
	$UCI_SET  modem.iface_$instance=interface
	$UCI_SET  modem.iface_$instance.iface_int_instance=$((++instance))
    $UCI_COMMIT modem
	echo $instance
}

