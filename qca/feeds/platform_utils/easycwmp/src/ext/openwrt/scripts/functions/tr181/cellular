cellular_iface_get_PreferredAccessTech(){
	local smode=$(uci -q get modem.$section_name.smode)
	local technology
	##Edit by Saul
	local modulename=$(uci -q get system.@system[0].module_name)
	if [[ ${modulename/"668"//} != $modulename ]];then
		case $smode in
			"0") technology="AUTO"		
			;;
			"1") technology="GSM"	
			;;
			"2") technology="UMTS"		
			;;
			"3") technology="LTE"		
			;;
			"4") technology="GSM&WCDMA"		
			;;
			"5") technology="WCDMA&LTE"		
			;;
			"6") technology="GSM&LTE"		
			;;
			"7") technology="GSM&WCDMA&LTE"		
			;;
			"8") technology="TD-SCDMA"		
			;;
			"11") technology="CDMA"
			;;
			"12") technology="CDMA&EVDO"
			;;
			"13") technology="EVDO"		
			;;
		esac
	elif [[ ${modulename/"7600"//} != $modulename ]];then
		case $smode in
			"0") technology="AUTO"		
			;;
			"1") technology="WCDMA"	
			;;
			"2") technology="LTE"		
			;;
			"3") technology="WCDMA&LTE"		
			;;
			"5") technology="GSM"		
			;;
			"8") technology="GSM&WCDMA"		
			;;
			"9") technology="GSM&LTE"
			;;
			"10") technology="GSM&WCDMA&LTE"
			;;
		esac
	elif [[ ${modulename/"EC20"//} != $modulename ]];then
		case $smode in
			"0") technology="AUTO"		
			;;
			"1") technology="WCDMA"	
			;;
			"2") technology="LTE"		
			;;
			"5") technology="GSM"
			;;
			"10") technology="GSM&WCDMA&LTE"
			;;
		esac
	else
		case $smode in
			"0") technology="AUTO"		
			;;
			"1") technology="WCDMA"	
			;;
			"2") technology="LTE"		
			;;
			"3") technology="WCDMA&LTE"		
			;;
			"4") technology="NR"		
			;;
			"6") technology="LTE&NR"
			;;
			"7") technology="WCDMA&LTE&NR"
			;;
		esac
	fi
	echo ${technology:-"AUTO"}
}

cellular_iface_get_RSSI(){
#	local rssi=$(cat $output_file 2>/dev/null | grep -m 1 "+RSSI:" | awk -F ": " '{print$2}')
	local rssi=$($UCI_GET_CELLULAR $output_file.RSSI | grep +RSSI | awk '{print $2}')
	if [ -n "$rssi" ]; then
		$UCI_SET_VARSTATE easycwmp.@local[0].RSSI="$rssi"
	else
		rssi=$(cat $output_file 2>/dev/null| grep +CSQ | awk '{print $2}' | awk -F ',' '{print$1}')
		if [ -n "$rssi" ];then
			if [ $rssi -eq 99 ] || [ $rssi -eq 0 ];then
				rssi="-113"
			else
				rssi=`expr $rssi \* 2 `
				rssi=`expr $rssi - 113 `
			fi
			$UCI_SET_VARSTATE easycwmp.@local[0].RSSI="$rssi"
		fi
	fi
	echo ${rssi:-"-113"}   #TODO:按照NL668文档，默认值取-113(dBm)
}

