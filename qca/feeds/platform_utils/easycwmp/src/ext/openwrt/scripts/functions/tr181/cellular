cellular_get_stat(){
	local dev=""
	local res=`ubus call network.interface.modem status`
	if [ "$?" != 0 ]; then
		return
	fi
	json_init
	json_load "$res" &> /dev/null
	if [ "$?" != 0 ]; then
		return
	fi
	json_get_var dev device
	res=`ubus call network.device status`
	json_init
	json_load "$res" &> /dev/null
	json_select "$dev" &> /dev/null
	json_select statistics &> /dev/null  
	json_get_vars tx_dropped rx_bytes tx_errors rx_packets rx_dropped tx_packets rx_errors tx_bytes
}

get_cellular_tx_byte_stats() {
	echo ${tx_bytes:-0}
}

get_cellular_rx_byte_stats() {
	echo ${rx_bytes:-0}
}

get_cellular_rx_packet_stats() {
	echo ${rx_packets:-0}
}

get_cellular_tx_packet_stats() {
	echo ${tx_packets:-0}
}

get_cellular_rx_error_stats() {
	echo ${rx_errors:-0}
}

get_cellular_tx_error_stats() {
