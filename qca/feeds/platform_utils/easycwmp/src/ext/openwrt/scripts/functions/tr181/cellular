set_modem_option(){
	local opt=$1
	local val="$2"
	[ -z "$opt" ] &&{
		return 0
	}
	if [ -z "$val" ] ; then
		$UCI_DELETE modem.$opt
	else
		$UCI_SET modem.$opt=$val
	fi
	return 0
}

get_modem_option(){
