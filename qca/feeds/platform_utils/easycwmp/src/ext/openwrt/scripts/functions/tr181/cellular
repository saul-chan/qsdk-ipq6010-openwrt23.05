entry_execute_method_root_Cellular() {
	case "$1" in ""|"$DMROOT."|"$CELLULARROOT."*)
		common_execute_method_obj "$CELLULARROOT." "0"
		common_execute_method_param "$CELLULARROOT.RoamingEnabled" "1" "cellular_get_roamingenabled" "cellular_set_roamingenabled" "xsd:boolean" "1"
		common_execute_method_param "$CELLULARROOT.RoamingStatus" "0" "cellular_get_roamingstatus" "cellular_set_roamingstatus" "xsd:boolean" "1"
		common_execute_method_param "$CELLULARROOT.InterfaceNumberOfEntries" "0" "cellular_get_ifacenumber" "" "xsd:unsignedInt" "1"
		common_execute_method_obj "$CELLULARROOT.Interface." "0" "" "" "cellular_browse_interface_instance $1"
		common_execute_method_param "$CELLULARROOT.AccessPointNumberOfEntries" "0" "echo 1" "" "xsd:unsignedInt" "1"
		common_execute_method_obj "$CELLULARROOT.AccessPoint." "0" "" "" "cellular_browse_accesspoint_instance $1"
		return 0
		;;
	esac
	return $E_INVALID_PARAMETER_NAME;
}

