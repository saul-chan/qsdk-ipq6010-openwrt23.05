}

cellular_iface_set_enable(){
	local val="$1"
	if [ "$val" == "true" -o "$val" == 1 ] ; then
		val=1
	else
		val=0
	fi
	$UCI_SET modem.$section_name.enable="$val"
	$UCI_COMMIT modem
}

