function vpn_get_name_by_proto(){
	local vpn=$1
    local if=`$UCI_SHOW network | grep proto=\'$1\' | awk -F '.' '{print$2}'`
    for n in $if; do
        echo $n
        return 0
    done
    echo ""
    return 0
}

function vpn_get_name_by_name(){
	local vpn=$1
    local if=`$UCI_SHOW network | grep network.${vpn}.ifname | awk -F "'" '{print$2}'`
    for n in $if; do
        echo $n
        return 0
    done
    echo ""
    return 0
}

function vpn_wireguard_create_wgobj(){
    local if
    if="wg"
    $UCI_SET network.${if}="interface"
    $UCI_SET network.${if}.proto="wireguard"

    $UCI_DELETE network.@wireguard${if:+_$if}[0]
    section=`$UCI_ADD network wireguard_${if}`
    $UCI_SET network.$section.name="@wireguard${if:+_$if}[0]"

    $UCI_DEL_LIST firewall.wan.network="${if}"
    $UCI_ADD_LIST firewall.wan.network="${if}"
    echo ${if}
}


function vpn_get_enabled(){
	local vpn=$1
    local if=$(vpn_get_name_by_proto $vpn)
	[ -z "$if" ] && {
		if=$(vpn_get_name_by_name $vpn)
	}
    local auto=1
    [ -n "$if" ] &&{
        auto=`$UCI_GET network.${if}.auto`
    }
	[ -z "$auto" ] &&{
        auto=`$UCI_GET network.${if}.enable`
    }
    if [ "$auto" = 1 ] || "$auto" = 'true' ]; then
        echo "1"
    else
        echo 0
    fi
}

function vpn_wireguard_set_enabled(){
    local if=$(vpn_get_name_by_proto wireguard)
    local enable="$1"
    [ -z "$if" ] &&{
        if=$(vpn_wireguard_create_wgobj)
    }
    common_set_bool "network.${if}.auto" "$enable" "1" "0"
}

function vpn_p2pvpn_set_enabled(){
    local if=$(vpn_get_name_by_name p2pvpn)
    local enable="$1"
    
    common_set_bool "network.${if}.enable" "$enable" "1" "0"
