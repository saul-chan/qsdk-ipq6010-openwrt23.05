function vpn_restart(){
	local vpn=$1
    local if=$(vpn_get_name_by_proto $vpn)
	[ -z "$if" ] && {
		if=$(vpn_get_name_by_name $vpn)
	}
    if [ $2 = 'true' ] || [ $2 = 1 ]; then
		if [ "$vpn" == "p2pvpn" ];then
			$UCI_COMMIT network.p2pvpn
			/etc/init.d/tailscale_init restart &
		else
			$UCI_COMMIT network
			ifup $if &
		fi
    else
        $UCI_REVERT network
    fi
    return 0
}

vpn_device_get_txsize(){
	local vpn=$1
    local if=$(vpn_get_name_by_proto $vpn)
	[ -z "$if" ] && {
		if=$(vpn_get_name_by_name $vpn)
