}

function vpn_get_status(){
	local vpn=$1
    local if=$(vpn_get_name_by_proto $vpn)
	[ -z "$if" ] && {
		if=$(vpn_get_name_by_name $vpn)
	}
    local devstatus=`ubus call network.device status | tr "." "_"`
    local up=`jsonfilter -s "${devstatus:-{}}" -e @.$if.up` 
    local addr=`ifconfig $if | grep "inet addr:" | awk -F " " '{print $2}'| awk -F ':' '{print $2}'`
	if [ -n "$addr" ] && [ "$up" == "true" ] ; then
		if [ "$vpn" == "wireguard" ];then
			local handshake=`wg show $if | grep "latest handshake:"`
			if [ -z "$handshake" ]; then
				echo "Disconnected"
			else
				echo "Connected"
			fi
		else
			echo "Connected"
		fi
	else
		echo "Disconnected"
	fi
}

