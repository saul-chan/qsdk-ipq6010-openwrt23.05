function vpn_get_mtu(){
	local vpn=$1
    local if=$(vpn_get_name_by_proto $vpn)
	[ -z "$if" ] && {
		if=$(vpn_get_name_by_name $vpn)
	}
    local mtu=`$UCI_GET network.${if}.mtu`
    [ -z "$mtu" ] && [ -n "$if" ] && {
        mtu=`ifconfig $if 2>/dev/null | grep -F 'MTU:' | awk -F ':' '{print$2}' | sed 's/[^0-9]*//g'`
    }
    echo ${mtu:-0}
}

