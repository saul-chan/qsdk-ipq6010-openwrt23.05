wifi_ssid_get_Enable() {
	local val=`$UCI_GET $1.disabled`
	[ "$val" = "1" ] && echo "0" || echo "1"
}

wifi_ssid_set_Enable() {
	local ret
	
	#common_set_bool "$1.disabled" "$2" "1" ""
	local ifidx=`echo "$1" | grep 'wireless' | awk -F '.' '{print $2}' `
	local ifidx0=`uci show wireless.@wifi-iface[0] | grep 'wireless' |awk -F '.' '{print $2}' | sed -n '2p'`
	local ifidx1=`uci show wireless.@wifi-iface[1] | grep 'wireless' |awk -F '.' '{print $2}' | sed -n '2p'`
	
	if 	[ "$ifidx" == "$ifidx0" ]; then
			common_set_bool "wificonfig.@wifi-iface[1].en" "$2" "1" ""
	elif [ "$ifidx" == "$ifidx1" ];then
			common_set_bool "wificonfig.@wifi-iface[0].en" "$2" "1" ""
	else
			common_set_bool "wificonfig.sta0.en" "$2" "1" ""
	fi
			
	
	ret=$?
	if [ $ret == 1 ]; then                                                                 
        echo "wrong-type"                                                                                                                                                       
    else    
		
         $UCI_COMMIT wificonfig		
		 /etc/init.d/wifi_init start >/dev/null &
		
    fi 
	
	return $ret
}

wifi_ssid_get_Status() {
	local name=`wifi_ssid_get_Name $1`
	[ "$name" != "" ] && [ $(wifi_ssid_get_Enable $1) == "1" ] && echo Up || echo Down
}

wifi_ssid_get_Name() {
	local iface=$1
	local res ifname section device e i=0

	device=`$UCI_GET $1.device`
	[ "$device" = "" ] && return 0
	res=`ubus call network.wireless status`
	[ "$res" = "" ] && return 0
	json_init
	json_load "$res" >&2
	json_select "$device" >&2
	json_select "interfaces" >&2
	while [ 1 ]; do
		let i++
		json_select "$i"  >&2
		e=$?
		[ "$e" != 0 ] && break
		json_get_var section section >&2
		[ "$section" != "${iface#*.}" ] && { json_select ".." >&2; continue; }
		json_get_var ifname ifname >&2
#Del by Saul
#		echo $ifname
#Del end
		break;
	done
#Add by Saul
	[ -z "$ifname" ] && ifname=$($UCI_GET $1.ifname)
	[ -z "$ifname" ] && ifname=$(get_radio_wdev $device)
	echo $ifname
#Add end
}

