wifi_radio_get_X_SupportedTxpowers(){
#Add by Saul
	#local index=$(get_radio_index $*) 
	#local dev=$(iw dev | grep phy#$index -A 2 | grep "Interface" | awk '{print$2}')
	local dev=$(get_radio_wdev $*)
#Add end
	local txpowers=""
	if [ -n "$dev" ]; then
		 
		txpowers=$(iwinfo $dev txpowerlist 2>/dev/null | tr '*' ' ' | awk '{print$1}' | tr '\n' ',') 
	fi 
	echo ${txpowers%,}
}

wifi_radio_get_X_TXPower(){
	local txpower=`$UCI_GET $1.txpower`
	if [ -z "$txpower" ]; then
		local index=$(get_radio_index $*)
		local dev=$(iw dev | grep phy#$index -A 2 | grep "Interface" | awk '{print$2}')
		if [ -n "$dev" ]; then
			txpower=$(iw dev $dev info 2>/dev/null | grep txpower | awk '{print$2}')	
		fi
	fi
	echo ${txpower:-0}
}

wifi_radio_set_X_TXPower(){
	$UCI_SET $1.txpower=$2
	return 0
}

