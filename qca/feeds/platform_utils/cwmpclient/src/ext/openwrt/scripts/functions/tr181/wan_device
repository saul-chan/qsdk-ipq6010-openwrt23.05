wan_device_get_interface_maps() {
	#should return a list like this: "<interface1>:<instance1>:<protocol>:<default interface? 1 : 0> <interface2>:<instance>:<protocol>:<default interface? 1 : 0>"
#	echo "mng:1:IP:1 wan:2:PPP:0"
	local inst=1
	local isdef=1
	local maps
	local cnt=1
	for m in $WAN_DEVICES; do
		$UCI_GET network.${m} >/dev/null && {
			#判断/etc/config/network中是否定义有config interface '5g'、'modem'、...
			[ -n "$maps" ] && maps="${maps} "
			#判断网卡状态，仅显示在线和wan口
			local status=`wan_device_get_ipcx_status $m`
			if [ "$status" == "Connected" ] || [ "$m" == "wan" ];then
				maps="${maps}${m}:${inst}:IP:${isdef}"
				isdef=0
				let inst++
			fi
		}
	done

	echo "$maps"

#        echo "5g:1:IP:1 wan:2:IP:0 modem:3:IP:1"
#        local ret=`ifconfig | grep qmimux0 | wc -l`
#        if [[ $ret == 1 ]]; then
#                echo "qmimux0:1:IP:1 eth0.2:2:IP:0"
#        else
#                echo "wwan0:1:IP:1 eth0.2:2:IP:0"
#        fi
}

wan_device_get_ipcx_type(){
	#取值: IP_Bridged 或 IP_Routed 或 Unconfigured
	#local type="$1"
	#echo "$type"
	local type=`$UCI_GET network.$1.type`
	if [ "$type" == "bridge" ]; then
		echo "IP_Bridged"
	else
		echo "IP_Routed"
	fi
}

wan_device_get_ipcx_status() {
    local iface="$1"
    local ifname=`$UCI_GET network.$iface.ifname | tr "." "_"`
    local devstatus=`ubus call network.device status | tr "." "_"`
    local up=`jsonfilter -s "${devstatus:-{}}" -e "@.$ifname.up"` 
	local ipaddr=$(wan_device_get_ipcx_ipaddr $iface)	
	if [ -n "$ipaddr" ] && [ "$up" == "true" ] ; then
		echo "Connected"
	else
		echo "Disconnected"
	fi
}

wan_device_get_ipcx_ipaddr() {
	local iface="$1"
	local ifname=`$UCI_GET network.$iface.ifname`
    if [ -n "$ifname" ]; then
        local addr=`ifconfig $ifname | grep "inet addr:" | awk -F " " '{print $2}'| awk -F ':' '{print $2}'`      
		echo "$addr"
    else                                                                                                              
        echo ""    
    fi    
}

