wan_device_get_ipcx_netmask(){
	local iface="$1"
	local ifname=`$UCI_GET network.$iface.ifname`
	if [ -n "$ifname" ]; then
		local mask=`ifconfig $ifname | grep "Mask:" | awk -F "Mask:" '{print $2}'`	
		echo "$mask"
	else
		echo ""
	fi
}

