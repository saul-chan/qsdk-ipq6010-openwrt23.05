
config wifidogx 'common'
	option gateway_interface 'br-lan'
	option auth_server_hostname '43.138.186.207'
	option auth_server_port '8001'
	option auth_server_path '/wifidog/'
	option long_conn_mode 'none'
	option check_interval '60'
	option client_timeout '1'
	option wired_passed '1'
	option enabled '1'
	option log_level '7'
	option js_filter '0'
	option apple_cna '1'
	option enable_websocket '0'
	option enable_dns_forward '0'
	option auth_server_mode 'cloud'
	option enable_anti_nat '0'
	option ttl_values '64,128,255'
	option enable_qos '0'
	option channel_path 'apfree'
	option upload_limit '2'
	option trial_period '3'
	option trial_url '4'
	option redirect_url '6'
	option selected_auth_server 'server'
	option disable_portal_auth '0'
	option enable_event_log '0'
	option external_interface 'wific'

config group 'wechat'
	option g_type '3'
	list wildcard_domain '.weixin.qq.com'
	option g_desc '微信泛域名'

config group 'wechat2'
	option g_type '1'
	list domain_name 'weixin.qq.com'
	option g_desc '微信域名'

config group 'dingtalk'
	option g_type '3'
	list wildcard_domain '.dingtalk.com'
	option g_desc '钉钉'

config group 'dingtalk2'
	option g_type '1'
	list domain_name 'dingtalk.com'
	option g_desc '钉钉域名'

config group 'alipay'
	option g_type '3'
	list wildcard_domain '.alipay.com'
	list wildcard_domain '.alipayobjects.com'
	list wildcard_domain '.alipaydev.com'
	option g_desc '支付宝'

config group 'alipay2'
	option g_type '1'
	list domain_name 'alipay.com'
	list domain_name 'alipayobjects.com'
	list domain_name 'alipaydev.com'
	option g_desc '支付宝域名'

config group 'macdemo'
	option g_type '2'
	list mac_address 'A0:B0:C0:D0:E0:F0'
	option g_desc 'mac group demo'

config gateway 'apfree'
	option gateway_auth_enabled '1'
	option gateway_name 'br-lan'
	option gateway_channel 'apfree'
	option gateway_subnetv4 '192.168.2.1/24'

config auth 'server'
	option auth_server_hostname '43.138.186.207'
	option auth_server_port '8001'
	option auth_server_path '/wifidog/'
	option long_conn_mode 'mqtt'
	option mqtt_server_hostname '43.138.186.207'
	option mqtt_server_port '1883'
	option mqtt_username 'apfree'
	option mqtt_password 'apfree'
