#!/bin/sh /etc/rc.common
START=30
USE_PROCD=1
#STOP=10
#USE_PROCD=0
BIN=dialing
kill_exe()
{	
	if [ $(pgrep -f "$1" | wc -l) -ne 0 ];then
		echo $(pgrep -f "$1")
		kk=$(pgrep -f "$1")
		echo $kk
		kill -9 $kk
	fi
}

start_dial()
{
	procd_open_instance
	if [ -n "$1" ];then
		procd_set_param command $BIN $1
	else
		procd_set_param command $BIN
	fi
	procd_set_param respawn
	procd_close_instance
}

config_cellular()
{
	uci -q -P /var/state set cellular.$1.CPIN="+CPIN: SIM IS BUSY"
	uci -q -P /var/state set cellular.$1.CPSI="+CPSI:  "
	uci -q -P /var/state set cellular.$1.BAND="+BAND:  "
	uci -q -P /var/state set cellular.$1.C5GREG="+5GREG:  "
	uci -q -P /var/state set cellular.$1.ARFCN="+ARFCN:  "
	uci -q -P /var/state set cellular.$1.PCI="+PCI:  "
	uci -q -P /var/state set cellular.$1.eNB="+eNB:  "
	uci -q -P /var/state set cellular.$1.cellID="+cellID:  "
	uci -q -P /var/state set cellular.$1.SVAL="+SVAL: 0"
	uci -q -P /var/state set cellular.$1.RSRP="+RSRP: 0"
	uci -q -P /var/state set cellular.$1.RSRQ="+RSRQ: 0"
	uci -q -P /var/state set cellular.$1.RSSI="+RSSI: 0"
	uci -q -P /var/state set cellular.$1.SINR="+SINR: 0"
	uci -q -P /var/state set cellular.$1.CSQ="+CSQ: 0"
	uci -q -P /var/state set cellular.$1.COPS="+COPS:  "
	uci -q -P /var/state set cellular.$1.CEREG="+CEREG: "
	uci -q -P /var/state set cellular.$1.CGREG="+CGREG: "
	uci -q -P /var/state set cellular.$1.CGREG="+C5GREG: "
	uci -q -P /var/state set cellular.$1.CCID="+CCID:  "
	uci -q -P /var/state set cellular.$1.IMSI="+IMSI:  "
	uci -q -P /var/state set cellular.$1.SLOT="+SLOT:  "
}

start_service()
{
	
	if [ -n "$(uci -q get modem.@default[0])" ];then
		config_cellular SIM
		start_dial
	fi
	if [ -n "$(uci -q get modem.SIM1)" ];then
		config_cellular SIM1
		start_dial SIM1
	fi
	if [ -n "$(uci -q get modem.SIM2)" ];then
		config_cellular SIM2
		start_dial SIM2
	fi
	if [ -n "$(uci -q get modem.SIM3)" ];then
		config_cellular SIM3
		start_dial SIM3
	fi
	if [ -n "$(uci -q get modem.SIM4)" ];then
		config_cellular SIM4
		start_dial SIM4
	fi
}

stop_service() {

	kill_exe fibocom-dial
	kill_exe quectel-CM
	if [ -n "$(uci -q get modem.@default[0])" ];then
		ifdown SIM
		sleep 1s
		ifup SIM
		rm -rf /tmp/*SIM
	fi
	if [ -n "$(uci -q get modem.SIM1)" ];then
		ifdown SIM1
		sleep 1s
		ifup SIM1
		rm -rf /tmp/*SIM1
	fi
	if [ -n "$(uci -q get modem.SIM2)" ];then
		ifdown SIM2
		sleep 1s
		ifup SIM2
		rm -rf /tmp/*SIM2
	fi
	if [ -n "$(uci -q get modem.SIM3)" ];then
		ifdown SIM3
		sleep 1s
		ifup SIM3
		rm -rf /tmp/*SIM3
	fi
	if [ -n "$(uci -q get modem.SIM4)" ];then
		ifdown SIM4
		sleep 1s
		ifup SIM4
		rm -rf /tmp/*SIM4
	fi

}

