#!/bin/sh

uci -q batch <<-EOF >/dev/null
	delete ucitrack.@ipsec[-1]
	add ucitrack ipsec
	set ucitrack.@ipsec[-1].init=ipsec
	delete ucitrack.@ipsec_rule[-1]
	add ucitrack ipsec_rule
	set ucitrack.@ipsec_rule[-1].init=firewall_init
	commit ucitrack
EOF

rm -rf /tmp/luci-indexcache /tmp/luci-modulecache
exit 0
