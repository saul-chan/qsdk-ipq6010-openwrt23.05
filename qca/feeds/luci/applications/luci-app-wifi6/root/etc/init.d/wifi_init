#!/bin/sh /etc/rc.common
# Copyright (C) 2014 OpenWrt.org

START=50
STOP=90
USE_PROCD=1
ssid_init()
{
	wifissid=$(uci -q get wificonfig.wlan0.ssid)
	if [ -z "$wifissid" ];then
		wifi2g=$(uci -q get wireless.@wifi-iface[1].ssid)
		wifi5g=$(uci -q get wireless.@wifi-iface[0].ssid)
		uci set wificonfig.wlan0.ssid=$wifi5g
		uci set wificonfig.wlan1.ssid=$wifi2g
		uci commit wificonfig	
	fi
}

kill_exe()
{	
	if [ $(pgrep -f "$1" | wc -l) -ne 0 ];then
		echo $(pgrep -f "$1")
		kk=$(pgrep -f "$1")
		echo $kk
		kill -9 $kk
	fi
}

wifi_seting()
{
	###waln1设置
	en2=$(uci -q get wificonfig.wlan1.en)
	if [ -n "$en2" ] && [ $en2 -eq 1 ];then
		echo "wifi on"
		uci set wireless.@wifi-iface[0].device='wifi1'
	else
		echo "wifi down"
		uci -q del wireless.@wifi-iface[0].device
	fi
	ssid2=$(uci -q get wificonfig.wlan1.ssid)
	if [ -n "$ssid2" ];then
		uci set wireless.@wifi-iface[0].ssid="$ssid2"
	fi
	security2=$(uci -q get wificonfig.wlan1.security)
	if [ -n "$security2" ];then
	if [ $security2 == "none" ];then
		uci set wireless.@wifi-iface[0].encryption='none'
		uci -q del wireless.@wifi-iface[0].key	
	else 
		
		if [ $security2 == "WPA2" ];then
		uci set wireless.@wifi-iface[0].encryption='psk2+ccmp' ##'psk-mixed'	
		fi
		
		if [ $security2 == "WPA/WPA2PSK" ];then
		uci set wireless.@wifi-iface[0].encryption='psk+tkip+ccmp' ##'psk-mixed'
		fi
		key2=$(uci -q get wificonfig.wlan1.key)
		if [ -z "$key2" ];then
			uci set wificonfig.wlan1.security='none'
			uci set wireless.@wifi-iface[0].encryption='none'
			uci -q del wireless.@wifi-iface[0].key
		else
			uci set wireless.@wifi-iface[0].key=$key2
		fi
	fi
	fi
	hidden2=$(uci -q get wificonfig.wlan1.hidden)
	if [ -n "$hidden2" ];then
		uci set wireless.@wifi-iface[0].hidden=$hidden2
	fi
	
	channel2=$(uci -q get wificonfig.wlan1.channel)
	if [ -n "$channel2" ];then
		uci set wireless.wifi1.channel=$channel2
	fi
	
	htmode2=$(uci -q get wificonfig.wlan1.htmode)
	if [ -n "$htmode2" ];then
		uci set wireless.wifi1.htmode=$htmode2
	fi
	#txpower2=$(uci -q get wificonfig.wlan1.txpower)
		#uci set wireless.wifi1.txpower=$txpower2
	wds2=$(uci -q get wificonfig.wlan1.wds)
	if [ -n "$wds2" ];then
		uci set wireless.@wifi-iface[0].wds=$wds2
	fi
	macfilter2=$(uci -q get wificonfig.wlan1.macfilter)
	if [ -n "$macfilter2" ];then
		uci set wireless.@wifi-iface[0].macfilter=$macfilter2
		maclist2=$(uci -q get wificonfig.wlan1.maclist)
		uci set wireless.@wifi-iface[0].maclist="$maclist2"
	else
		uci -q del wireless.@wifi-iface[0].macfilter
		uci -q del wireless.@wifi-iface[0].maclist
	fi
	wpa_group_rekey2=$(uci -q get wificonfig.wlan1.wpa_group_rekey)
	if [ -n "$wpa_group_rekey2" ];then
		uci set wireless.@wifi-iface[0].wpa_group_rekey="$wpa_group_rekey2"
	else
		uci set wireless.@wifi-iface[0].wpa_group_rekey=0
	fi
	wpa_pair_rekey2=$(uci -q get wificonfig.wlan1.wpa_pair_rekey)
	if [ -n "$wpa_pair_rekey2" ];then
		uci set wireless.@wifi-iface[0].wpa_pair_rekey="$wpa_pair_rekey2"
	else
		uci set wireless.@wifi-iface[0].wpa_pair_rekey=0
	fi
	wpa_master_rekey2=$(uci -q get wificonfig.wlan1.wpa_master_rekey)
	if [ -n "$wpa_master_rekey2" ];then
		uci set wireless.@wifi-iface[0].wpa_master_rekey="$wpa_master_rekey2"
	else
		uci set wireless.@wifi-iface[0].wpa_master_rekey=0
	fi
	###waln0设置
	en1=$(uci -q get wificonfig.wlan0.en)
	if [ -n "$en1" ] && [ $en1 -eq 1 ];then
		echo "wifi on"
		uci set wireless.@wifi-iface[1].device='wifi0'
	else
		echo "wifi off"
		uci -q del wireless.@wifi-iface[1].device
	fi
	ssid1=$(uci -q get wificonfig.wlan0.ssid)
	if [ -n "$ssid1" ];then
		uci set wireless.@wifi-iface[1].ssid="$ssid1"
	fi
	security1=$(uci -q get wificonfig.wlan0.security)
	if [ -n "$security1" ];then
	if [ $security1 == "none" ];then
		uci set wireless.@wifi-iface[1].encryption='none'
		uci -q del wireless.@wifi-iface[1].key
	else
		if [ $security1 == "WPA2" ];then
		uci set wireless.@wifi-iface[1].encryption='psk2+ccmp' ##'psk-mixed'	
		fi
		if [ $security1 == "WPA/WPA2PSK" ];then
		uci set wireless.@wifi-iface[1].encryption='psk+tkip+ccmp' ##'psk-mixed'
		fi	
		key1=$(uci -q get wificonfig.wlan0.key)
		if [ -z "$key2" ];then
			uci set wificonfig.wlan0.security='none'
			uci set wireless.@wifi-iface[1].encryption='none'
			uci -q del wireless.@wifi-iface[1].key
		else
			uci set wireless.@wifi-iface[1].key=$key1	
		fi
	fi
	fi
	hidden1=$(uci -q get wificonfig.wlan0.hidden)
	if [ -n "$security1" ];then
		uci set wireless.@wifi-iface[1].hidden=$hidden1
	fi
	channel1=$(uci -q get wificonfig.wlan0.channel)
	if [ -n "$channel1" ];then
		uci set wireless.wifi0.channel=$channel1
	fi
	htmode1=$(uci -q get wificonfig.wlan0.htmode)
	if [ -n "$htmode1" ];then
		uci set wireless.wifi0.htmode=$htmode1
	fi
	#txpower1=$(uci -q get wificonfig.wlan0.txpower)
		#uci set wireless.wifi0.txpower=$txpower1
	wds1=$(uci -q get wificonfig.wlan0.wds)
	if [ -n "$wds1" ];then
		uci set wireless.@wifi-iface[1].wds=$wds1
	fi
	macfilter1=$(uci -q get wificonfig.wlan0.macfilter)
	if [ -n "$macfilter1" ];then
		uci set wireless.@wifi-iface[1].macfilter=$macfilter1
		maclist1=$(uci -q get wificonfig.wlan0.maclist)
		uci set wireless.@wifi-iface[1].maclist="$maclist1"
	else
		uci -q del wireless.@wifi-iface[1].macfilter
		uci -q del wireless.@wifi-iface[1].maclist
	fi
	wpa_group_rekey1=$(uci -q get wificonfig.wlan0.wpa_group_rekey)
	if [ -n "$wpa_group_rekey1" ];then
		uci set wireless.@wifi-iface[1].wpa_group_rekey="$wpa_group_rekey1"
	else
		uci set wireless.@wifi-iface[1].wpa_group_rekey=0
	fi
	wpa_pair_rekey1=$(uci -q get wificonfig.wlan0.wpa_pair_rekey)
	if [ -n "$wpa_pair_rekey1" ];then
		uci set wireless.@wifi-iface[1].wpa_pair_rekey="$wpa_pair_rekey1"
	else
		uci set wireless.@wifi-iface[1].wpa_pair_rekey=0
	fi
	wpa_master_rekey1=$(uci -q get wificonfig.wlan0.wpa_master_rekey)
	if [ -n "$wpa_master_rekey1" ];then
		uci set wireless.@wifi-iface[1].wpa_master_rekey="$wpa_master_rekey1"
	else
		uci set wireless.@wifi-iface[1].wpa_master_rekey=0
	fi
	en3=$(uci -q get wificonfig.sta0.en)
	if [ -z "$en3" ] || [ "$en3" == "0" ];then
		echo "sta off"
		uci -q set wireless.sta0.disabled='1'
		uci -q set network.wific.device=''
		uci -q del wireless.sta0.ifname
	else
		echo "sta on"
		uci -q del wireless.sta0.disabled
		proto=$(uci -q get wificonfig.wific.proto)
		country=$(uci -q get wificonfig.wific.country)
		[ -n "$country" ] && iw reg set $country
		[ -n "$country" ] && uci -q set wireless.sta0.country=$country
		[ -n "$country" ] && uci -q set wireless.wifi0.country=$country
		[ -n "$country" ] && uci -q set wireless.wifi1.country=$country
		
		if [ -n "$country" -a "$country" != "CN"  ];then
			channel_5=$(uci -q get wificonfig.wific.channel_55)
			uci -q set wificonfig.wific.channel_5="$channel_5"
			uci commit wificonfig
		fi
		
		if [ "$proto" == "bridgelan" ]; then
			uci set network.wific.proto='dhcp'
			uci set wireless.sta0.network='lan'
			uci set wireless.sta0.extap='1'
			uci set wireless.sta0.vap_ind='1'
			
			gateway=$(uci -q get wificonfig.wific.gateway)
			if [ -n "$gateway" ];then
				uci set network.lan.gateway=$gateway
			fi
			dns=$(uci -q get wificonfig.wific.dns)
			if [ -n "$dns" ];then
				uci set network.lan.dns=$dns
			fi
		else
			uci set wireless.sta0.network='wific'
			uci set network.wific.proto=$proto
			ipaddr=$(uci -q get wificonfig.wific.ipaddr)
			if [ -n "$ipaddr" ];then
				uci set network.wific.ipaddr=$ipaddr
			fi
			netmask=$(uci -q get wificonfig.wific.netmask)
			if [ -n "$netmask" ];then
				uci set network.wific.netmask=$netmask
			fi
			gateway=$(uci -q get wificonfig.wific.gateway)
			if [ -n "$gateway" ];then
				uci set network.wific.gateway=$gateway
			fi
			dns=$(uci -q get wificonfig.wific.dns)
			if [ -n "$dns" ];then
				uci set network.wific.dns=$dns
			fi
			metric=$(uci -q get wificonfig.wific.metric)
			if [ -n "$metric" ];then
				uci set network.wific.metric=$metric
			fi
			uci -q del wireless.sta0.extap
			uci -q del wireless.sta0.vap_ind
			uci -q del network.lan.gateway
			uci -q del network.lan.dns
		fi
		device=$(uci -q get wificonfig.sta0.device)
		if [ "$device" == "wifi0" ];then
			if [ -n "$en1" ];then
				uci set wireless.sta0.ifname='ath01'
				uci set network.wific.device='ath01'
			else
				uci set wireless.sta0.ifname='ath0'
				uci set network.wific.device='ath0'
			fi
			uci set wireless.sta0.device='wifi0'
		elif [ "$device" == "wifi1" ];then
			if [ -n "$en2" ];then
				uci set wireless.sta0.ifname='ath11'
				uci set network.wific.device='ath11'
			else
				uci set wireless.sta0.ifname='ath1'
				uci set network.wific.device='ath1'
			fi
			uci set wireless.sta0.device='wifi1'
		fi
		ssid3=$(uci -q get wificonfig.sta0.ssid)
			uci set wireless.sta0.ssid="$ssid3"
		security3=$(uci -q get wificonfig.sta0.security)
		if [ $security3 == "WPA2" ];then
			uci set wireless.sta0.encryption='psk2+ccmp' ##'psk-mixed'
			key3=$(uci -q get wificonfig.sta0.key)
			uci set wireless.sta0.key=$key3
		elif [ $security3 == "WPA/WPA2-PSK" ];then
			uci set wireless.sta0.encryption='psk+tkip+ccmp' ##'psk-mixed'
			key3=$(uci -q get wificonfig.sta0.key)
			uci set wireless.sta0.key=$key3
		else
			uci set wireless.sta0.encryption='none'
			uci -q del wireless.sta0.key
		fi
		wds3=$(uci -q get wificonfig.sta0.wds)
		uci set wireless.sta0.wds=$wds3
		#开关wifi客户端阀值
		# wific_en=$(uci -q get wificonfig.wific.en)
		# if [ $wific_en -eq 1 ];then
			# /etc/rssi_level &
		# fi
	fi
	#访客模式配置
	en4=$(uci -q get wificonfig.guest0.en)
	if [ -n "$en4" ] && [ $en4 -eq 1 ];then
		echo "guest on"
		if [ -z "$(uci -q get wireless.guest)" ];then
			uci set wireless.guest=wifi-iface
			uci set wireless.guest.mode=ap
		fi
		if [ -z "$(uci -q get network.guest)" ];then
			uci set network.guest=interface
		fi
		ipaddr_guest=$(uci -q get wificonfig.guest.ipaddr)
		if [ -n "$ipaddr_guest" ];then
			uci set network.guest.proto='static'
			uci set network.guest.ipaddr=$ipaddr_guest
		fi
		netmask_guest=$(uci -q get wificonfig.guest.netmask)
		if [ -n "$netmask_guest" ];then
			uci set network.guest.netmask=$netmask_guest
		else
			uci set network.guest.netmask='255.255.255.0'
		fi
		if [ -z "$(uci -q get dhcp.guest)" ];then
			uci set dhcp.guest=dhcp
			uci set dhcp.guest.interface='guest'
			uci set dhcp.guest.start='100'
			uci set dhcp.guest.limit='150'
			uci set dhcp.guest.leasetime='12h'
		fi
		device=$(uci -q get wificonfig.guest0.device)
		if [ "$device" == "wifi0" ];then
			uci set wireless.guest.device='wifi0'
			uci set network.guest.device='ath01'
		elif [ "$device" == "wifi1" ];then
			uci set wireless.guest.device='wifi1'
			uci set network.guest.device='ath11'
			
		fi
		uci set wireless.guest.network='guest'
	else
		echo "wifi down"
		uci -q del wireless.guest
		uci -q del network.guest
	fi
	ssid4=$(uci -q get wificonfig.guest0.ssid)
	if [ -n "$ssid2" ];then
		uci set wireless.guest.ssid="$ssid4"
	fi
	security4=$(uci -q get wificonfig.guest0.security)
	if [ -n "$security4" ];then
	if [ $security4 == "none" ];then
		uci set wireless.guest.encryption='none'
		uci -q del wireless.guest.key	
	else 
		
		if [ $security4 == "WPA2" ];then
		uci set wireless.guest.encryption='psk2+ccmp' ##'psk-mixed'	
		fi
		
		if [ $security4 == "WPA/WPA2PSK" ];then
		uci set wireless.guest.encryption='psk+tkip+ccmp' ##'psk-mixed'
		fi
		key4=$(uci -q get wificonfig.guest0.key)
		if [ -z "$key4" ];then
			uci set wificonfig.guest0.security='none'
			uci set wireless.guest.encryption='none'
			uci -q del wireless.guest.key
		else
			uci set wireless.guest.key=$key4
		fi
	fi
	fi
	hidden4=$(uci -q get wificonfig.guest0.hidden)
	if [ -n "$hidden4" ];then
		uci set wireless.guest.hidden=$hidden4
	fi
	
	# channel4=$(uci -q get wificonfig.wlan1.channel)
	# if [ -n "$channel4" ];then
		# uci set wireless.wifi1.channel=$channel4
	# fi
	
	# htmode4=$(uci -q get wificonfig.wlan1.htmode)
	# if [ -n "$htmode4" ];then
		# uci set wireless.wifi1.htmode=$htmode4
	# fi
	#txpower2=$(uci -q get wificonfig.wlan1.txpower)
		#uci set wireless.wifi1.txpower=$txpower2
	wds4=$(uci -q get wificonfig.guest0.wds)
	if [ -n "$wds4" ];then
		uci set wireless.guest.wds=$wds4
	fi
	macfilter4=$(uci -q get wificonfig.guest0.macfilter)
	if [ -n "$macfilter4" ];then
		uci set wireless.guest.macfilter=$macfilter4
		maclist4=$(uci -q get wificonfig.guest0.maclist)
		uci set wireless.guest.maclist="$maclist4"
	else
		uci -q del wireless.guest.macfilter
		uci -q del wireless.guest.maclist
	fi
	wpa_group_rekey4=$(uci -q get wificonfig.guest0.wpa_group_rekey)
	if [ -n "$wpa_group_rekey4" ];then
		uci set wireless.guest.wpa_group_rekey="$wpa_group_rekey4"
	else
		uci set wireless.guest.wpa_group_rekey=0
	fi
	wpa_pair_rekey4=$(uci -q get wificonfig.guest0.wpa_pair_rekey)
	if [ -n "$wpa_pair_rekey4" ];then
		uci set wireless.guest.wpa_pair_rekey="$wpa_pair_rekey4"
	else
		uci set wireless.guest.wpa_pair_rekey=0
	fi
	wpa_master_rekey4=$(uci -q get wificonfig.guest0.wpa_master_rekey)
	if [ -n "$wpa_master_rekey4" ];then
		uci set wireless.guest.wpa_master_rekey="$wpa_master_rekey4"
	else
		uci set wireless.guest.wpa_master_rekey=0
	fi
	
	# MAC=$(uci -q get wificonfig.wific.MAC) 
	# echo "$MAC" >/tmp/MAC_match
	
	uci commit
	sync
}

service_triggers() {
	procd_add_reload_trigger wificonfig
}

start_service()
{

	ssid_init

	if [ ! -f /tmp/wifi_initialized ]; then
        touch /tmp/wifi_initialized
    else
		wifi_seting
        sleep 1
        wifi up
    fi
	
}

stop_service()
{
	wifi down
}


