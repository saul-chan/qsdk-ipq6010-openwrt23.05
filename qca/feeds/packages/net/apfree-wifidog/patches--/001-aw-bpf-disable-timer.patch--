@@ -158,10 +160,14 @@
     now_sec = now_sec ? now_sec : 1; 
 
     if (now_sec >= val->last_time + TCP_CONN_TIMEOUT_SEC) {
+		#ifndef NO_BPF_TIMER
         bpf_timer_cancel(&val->timer);
         bpf_map_delete_elem(map, key);
+		#endif
     } else {
+		#ifndef NO_BPF_TIMER
         bpf_timer_start(&val->timer, TCP_CONN_TIMEOUT_NS, 0);
+		#endif
     }
 
     return 0;
