                         bpf_timer_init(&conn->timer, &tcp_conn_map, CLOCK_MONOTONIC);
                         bpf_timer_set_callback(&conn->timer, tcp_conn_timer_cb);
                         bpf_timer_start(&conn->timer, TCP_CONN_TIMEOUT_NS, 0);
+						#endif
                     }
                 } 
             }
