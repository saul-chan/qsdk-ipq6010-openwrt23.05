ifeq ($(obj),)
obj := .
endif

DEPTH := ../..

ifeq ($(strip ${QCA_PARTNER_MAKE_F_SUPPORT}),1)
export QCA_PARTNER_MAKE_F_INC=1
endif
include $(obj)/$(DEPTH)/os/linux/Makefile-linux.common

INCS += -I$(ATH_PKTLOG)

INCS += -I$(obj)/$(DEPTH)/umac/include
INCS += -I$(obj)/$(DEPTH)/offload/wlan/lmac_offload_if
