+bool wpa_bss_deployment_match(struct wpa_supplicant *wpa_s,
+			       struct wpa_bss *bss)
+{
+	const u8* ie = wpa_bss_get_ie_ext(bss, WLAN_EID_EXT_HE_OPERATION);
+	struct ieee80211_he_operation  *heop = NULL;
+	struct ieee80211_heop_6g_param *he_oper_6g = NULL;
+	u8 he_regulatory_info;
+
+	u8 pos = 9;
+
+	if (ie && ie[1] >= 6) {
+		heop = (struct ieee80211_he_operation *)(&ie[3]);
+		if (heop->he_oper_params & HE_INFO_HE_OPERATION_PARAM_VHT_OP)
+			pos += 3;
+
+		if (heop->he_oper_params &
+		    HE_INFO_HE_OPERATION_PARAM_CO_HOSTED_BSS)
+			pos += 1;
+
+		if ((heop->he_oper_params & HE_INFO_HE_OPERATION_PARAM_6G_INFO)
+		    && (is_6ghz_freq(bss->freq))) {
+			u8 *num_reg_power_rules = wpa_s->num_reg_power_rules;
+
+			he_oper_6g = (struct ieee80211_heop_6g_param *)
+					(ie + pos);
+			he_regulatory_info = he_oper_6g->regulatory_info;
+
+			/* Check whether bss' operating power is supported by
+			 * the supplicant, based on power rules received from
+			 * the driver.
+			 *
+			 * Note: If an AP advertises itself as an Indoor SP AP
+			 * deployment (SP + LPI), read it as SP.
+			 */
+			if (he_regulatory_info == DEP_INDOOR_SP_AP)
+				he_regulatory_info = DEP_STANDARD_POWER_AP;
+
+			/* Match the power mode of the AP with STA supported
+			 * power rules agnostic of the deployment.
+			 */
+			if (!num_reg_power_rules[he_regulatory_info])
+				return false;
+		}
+	}
+	return true;
+}
