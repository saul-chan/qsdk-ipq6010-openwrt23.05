+static int mlo_6ghz_dep_type_match(struct wpa_supplicant *wpa_s,
+				    u8 bssid[ETH_ALEN],
+				    struct wpa_ssid *assoc_ssid)
+{
+	struct wpa_ssid *ssid = wpa_ml_ssid(wpa_s, bssid, assoc_ssid);
+	struct wpa_bss *bss = NULL;
+
+	if (!ssid) {
+		wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: Network profile not found");
+		return -1;
+	}
+
+	if (wpas_network_disabled(wpa_s, ssid)) {
+		wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA:   skip - disabled");
+		return -1;
+	}
+
+	if (wpas_temp_disabled(wpa_s, ssid) > 0) {
+		wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: skip - disabled temporarily");
+		return -1;
+	}
+
+	bss = wpa_bss_get(wpa_s, bssid, assoc_ssid->ssid, assoc_ssid->ssid_len);
+
+	if (!bss) {
+		wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: %s Link scan-entry not found",
+			__func__);
+		return -1;
+	}
+
+	if (!wpa_bss_deployment_match(wpa_s, bss)) {
+		wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: %s 6GHz Regulatory Deployment mismatch",
+			__func__);
+		return 1;
+	}
+
+	return 0;
+}
