 		return;
-	wpa_ft_rrb_rx(hapd->wpa_auth, ethhdr->h_source, buf + sizeof(*ethhdr),
-		      len - sizeof(*ethhdr));
+
+	if (wpa_ft_rrb_rx(hapd->wpa_auth, ethhdr->h_source, buf + sizeof(*ethhdr),
+			  len - sizeof(*ethhdr)))
