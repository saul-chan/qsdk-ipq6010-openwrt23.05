+static bool hostapd_rrb_receive_filter(struct hostapd_data *hapd, struct l2_ethhdr *ethhdr)
+{
+	if (is_multicast_ether_addr(ethhdr->h_dest) ||
+	    os_memcmp(hapd->own_addr, ethhdr->h_dest, ETH_ALEN) == 0)
+		return false;
+
+#ifdef CONFIG_MLO
+	if (hapd->mlo_link &&
+	    (os_memcmp(hapd->mlo_link->mld->mld_mac_addr, ethhdr->h_dest,
+		       ETH_ALEN) == 0) &&
+	    (hapd->mlo_link->mld->first_hapd == hapd))
+		return false;
+#endif
+	return true;
+}
