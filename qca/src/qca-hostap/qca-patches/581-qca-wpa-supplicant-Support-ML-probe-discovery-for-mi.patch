+#ifdef CONFIG_MLO
+static int ml_link_probe_activate_missing_links(struct wpa_supplicant *wpa_s)
+{
+	struct wpa_bss *bss = wpa_s->ml_connect_probe_bss;
+	struct wpa_scan_results *scan_res = NULL;
+	u8 missing;
+	int i;
+
+	missing = bss->n_missing_mld_links;
+	for (i = 0; i < bss->n_missing_mld_links; i++) {
+		/*struct wpa_supplicant *link_wpa_s = bss->missing_mld_links[i].link_wpa_s;*/
+		struct missing_mld_link *l = &bss->missing_mld_links[i];
+		struct wpa_bss *neigh_bss;
+		struct wpa_ssid *local_ssid;
+
+		wpa_dbg(l->link_wpa_s, MSG_DEBUG,
+			"ML_STA: Getting scan res for missing link id=%u",
+			l->link_id);
+		scan_res = wpa_supplicant_get_scan_results(l->link_wpa_s, NULL, 0);
+		if (!scan_res)
+			continue;
+		wpa_scan_results_free(scan_res);
+
+		neigh_bss = wpa_bss_get_bssid(l->link_wpa_s, l->bssid);
+		if (!neigh_bss) {
+			wpa_dbg(l->link_wpa_s, MSG_DEBUG,
+				"ML_STA: Scan entry found after ML probe response");
+			continue;
+		}
+
+		local_ssid = wpa_ml_ssid(l->link_wpa_s, l->bssid, wpa_s->ml_connect_probe_ssid);
+		if (!local_ssid) {
+			wpa_dbg(l->link_wpa_s, MSG_DEBUG,
+				"ML STA: Invalid conf - not choosing the link");
+			continue;
+		}
+
+		if (l->found) {
+			wpa_dbg(l->link_wpa_s, MSG_ERROR,
+				"ML_STA: Scan entry for " MACSTR " marked "
+				"found already; ignore this link. Investigate!",
+				MAC2STR(l->bssid));
+			continue;
+		}
+		l->found = true;
+		l->link_wpa_s->active_ml_sta = true;
+		l->link_wpa_s->wpa->active_ml_sta = true;
+		l->link_wpa_s->ml_connect = true;
+		l->link_wpa_s->link_id = l->link_id;
+		os_memcpy(l->link_wpa_s->bssid, l->bssid, ETH_ALEN);
+		l->link_wpa_s->assoc_freq = neigh_bss->freq;
+		wpa_dbg(l->link_wpa_s, MSG_DEBUG, "ML_STA: Link ID: %d", l->link_wpa_s->link_id);
+		wpa_dbg(l->link_wpa_s, MSG_DEBUG, "ML_STA: Link BSSID: " MACSTR, MAC2STR(l->link_wpa_s->bssid));
+		missing--;
+	}
+
+	return missing;
+}
 
