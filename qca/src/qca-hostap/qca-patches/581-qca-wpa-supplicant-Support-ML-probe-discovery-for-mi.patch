+static void wpa_mlo_post_connect_on_partners(struct wpa_supplicant *selected_wpa_s, struct wpa_bss *selected)
+{
+	struct wpa_supplicant *local_wpa_s;
+	struct wpa_global *global;
+
+	if (!selected_wpa_s || !selected) {
+		wpa_printf(MSG_DEBUG, "ML_STA: Selected wpa_s or BSS null; "
+			   "cannot post connect on partners");
+		return;
+	}
+
+	if (is_zero_ether_addr(selected->ml_info.ap_mld_addr))
+		return;
+
+	global = selected_wpa_s->global;
+
+	wpa_msg(selected_wpa_s, MSG_DEBUG, "ML_STA: Associating with ML-AP " MACSTR,
+		MAC2STR(selected->ml_info.ap_mld_addr));
+	os_memcpy(selected_wpa_s->ap_mld_mac , selected->ml_info.ap_mld_addr, ETH_ALEN);
+
+	selected_wpa_s->ml_connect = true;
+	selected_wpa_s->primary_link = true;
+	selected_wpa_s->active_ml_sta = true;
+	wpa_for_each_mlo_link(local_wpa_s, global) {
+		if (!wpa_partner_mlo_link(selected_wpa_s, local_wpa_s))
+			continue;
+
+		local_wpa_s->ml_connect = true;
+	}
+
+	/* Update Partner Link SM */
+	wpa_msg(selected_wpa_s, MSG_DEBUG, "ML_STA: Update Assoc-Link wpa_sm");
+	selected_wpa_s->wpa->ml_connect = true;
+	selected_wpa_s->wpa->active_ml_sta = true;
+	os_memcpy(selected_wpa_s->wpa->sta_mld_mac, selected_wpa_s->conf->sta_mld_addr, ETH_ALEN);
+	os_memcpy(selected_wpa_s->wpa->ap_mld_mac, selected_wpa_s->ap_mld_mac, ETH_ALEN);
+
+	wpa_for_each_mlo_link(local_wpa_s, global) {
+		if(local_wpa_s == selected_wpa_s)
+			continue;
+		if(!wpa_partner_mlo_link(selected_wpa_s, local_wpa_s))
+			continue;
+		/* in MLO-RNR parser active-link already set */
+		if (!local_wpa_s->active_ml_sta)
+			continue;
+		wpa_msg(local_wpa_s, MSG_DEBUG, "ML_STA: Update MLO-Link Dev wpa_sm");
+		local_wpa_s->wpa->ml_connect = true;
+		os_memcpy(local_wpa_s->wpa->sta_mld_mac, local_wpa_s->conf->sta_mld_addr, ETH_ALEN);
+		os_memcpy(local_wpa_s->wpa->ap_mld_mac, selected_wpa_s->ap_mld_mac, ETH_ALEN);
+		os_memcpy(local_wpa_s->ap_mld_mac, selected_wpa_s->ap_mld_mac, ETH_ALEN);
+
+		/* Update Non-Assoc Links to Logical WPA_MLO_WAIT state */
+		wpa_dbg(selected_wpa_s, MSG_DEBUG, "ML_STA: Update Partner Links to ASSOCIATING State");
+		wpa_supplicant_set_state(local_wpa_s, WPA_ASSOCIATING);
+		wpa_set_mlo_link_wdev_bssid(local_wpa_s);
+	}
+
+	/* Update Non-Assoc Links to MLO_LINK_DEVICE */
+	wpa_dbg(selected_wpa_s, MSG_DEBUG, "ML_STA: Update Partner Links as MLO_LINK_DEVICE");
+	wpa_mlo_updata_partner_link_state(selected_wpa_s);
+}
 
