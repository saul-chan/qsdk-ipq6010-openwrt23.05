diff --git a/wpa_supplicant/wpa_supplicant.c b/wpa_supplicant/wpa_supplicant.c
index f88f4be6..9a56561f 100644
--- a/wpa_supplicant/wpa_supplicant.c
+++ b/wpa_supplicant/wpa_supplicant.c
@@ -188,6 +188,27 @@ bool wpa_is_mlo_link(struct wpa_supplicant *wpa_s_first , struct wpa_supplicant
 	}
 	return false;
 }
+
+u8 sta_num_links_mlo(struct wpa_supplicant *wpa_s, bool active)
+{
+	struct wpa_global *global = wpa_s->global;
+	struct wpa_supplicant *local_wpa_s = global->ifaces;
+	u8 count = 1;
+
+	wpa_for_each_mlo_link(local_wpa_s, global) {
+		if (wpa_s == local_wpa_s)
+			continue;
+		if (!wpa_partner_mlo_link(wpa_s , local_wpa_s))
+			continue;
+		if (active && !wpa_s->active_ml_sta)
+			continue;
+		count++;
+	}
+
+	wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: Is a %d link ML-STA active_flag=%d", count, active);
+	return count;
+}
