+bool op_class_found(int *opclasses, int opp_class)
+{
+	int i;
+	for (i = 0; opclasses && opclasses[i]; i++) {
+		if (opclasses[i] == opp_class)
+			return true;
+	}
+	return false;
+}
+
+struct wpa_supplicant *get_wpas_ml(struct wpa_supplicant *wpa_s,
+				   int op_class, int chan_no)
+{
+	int *supp_op_classes;
+	struct wpa_global *global = wpa_s->global;
+	struct wpa_supplicant *local_wpa_s = global->ifaces;
+
+	supp_op_classes = wpas_supp_op_classes(wpa_s);
+
+	if (op_class_found(supp_op_classes, op_class)) {
+		os_free(supp_op_classes);
+		return wpa_s;
+	}
+
+	os_free(supp_op_classes);
+
+	wpa_for_each_mlo_link(local_wpa_s, global) {
+
+		if (wpa_s == local_wpa_s)
+			continue;
+
+		if(!wpa_partner_mlo_link(wpa_s , local_wpa_s))
+			continue;
+
+		supp_op_classes = wpas_supp_op_classes(local_wpa_s);
+
+		if (op_class_found(supp_op_classes, op_class)) {
+			os_free(supp_op_classes);
+			return local_wpa_s;
+		}
+		os_free(supp_op_classes);
+	}
+
+	return NULL;
+}
+
+
+bool global_opp_class(u8 target_opp_class)
+{
+	u8 op;
+
+	for (op = 0; global_op_class[op].op_class; op++) {
+		if (global_op_class[op].op_class == target_opp_class)
+		return true;
+	}
+	return false;
+}
