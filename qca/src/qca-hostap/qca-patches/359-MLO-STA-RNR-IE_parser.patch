+struct rnr_tbtt_information {
+	u8 tbtt_offset;
+	u8 bssid[ETH_ALEN];
+	u8 short_ssid[4];
+	u8 bss_params;
+	u8 psd_20mhz;
+
+	/* MLD Info */
+	u8 mld_id;
+	u8 link_id:4;
+	u8 bss_param_change_cnt;
+
+	u8 opp_class;
