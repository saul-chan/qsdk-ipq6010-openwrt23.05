+/* Map Vdev with the Link-ID from RNR-IE for MLO STA */
+static int wpa_mlo_vdev_per_sta_mapping(struct wpa_supplicant *wpa_s,
+					struct wpa_bss *selected)
+{
+	/* Pick RNR-IE from beacon IE's */
+	const u8 *rnr_ie = wpa_bss_get_ie(selected, WLAN_EID_REDUCED_NEIGHBOR_REPORT);
+	const u8 *country_ie = wpa_bss_get_ie(selected, WLAN_EID_COUNTRY);
+
+	char country[2];
+	u8 *pos;
+	struct rnr_neighbour_ap_info ap_info;
+	struct rnr_tbtt_information tbtt_info;
+	struct wpa_supplicant *local_wpa_s = NULL;
+	int i = 0;
+	u8 opp_class;
+
+
+	if(!rnr_ie) {
+		wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: No RNR-IE");
+		return -1;
+	}
+
+	pos = (u8 *)rnr_ie+2;  /* starting of Neighbor AP Info */
+
+	if (!pos) {
+		wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: No RNR-IE");
+		return -1;
+	}
+
+	if (country_ie) {
+		memcpy(country, country_ie + 2, 2);
+	}
+
+	wpa_hexdump(MSG_DEBUG, "ML_STA: Beacon RNR-IE", rnr_ie, rnr_ie[1]+2);
+
+	while (pos <= (rnr_ie + rnr_ie[1] + 1)) {
+		ap_info.tbtt_info_fieldtype = pos[0] & TBTT_INFO_FIELD_TYPE;
+		ap_info.filtered_neighbour_ap = (pos[0] & TBTT_INFO_FIL_NAP_MASK)>>TBTT_INFO_FIL_NAP_SHIFT;
+		ap_info.tbtt_info_count = (pos[0] & TBTT_INFO_COUNT_MASK)>>TBTT_INFO_COUNT_SHIFT;
+		ap_info.tbtt_info_len = pos[1];
+		ap_info.opp_class = pos[2];
+		ap_info.chan_no = pos[3];
+
+		pos += 4; /* Moving to TBTT Info Section SKIP 4B */
+
+		/* The MLD beacon is supposed to have TBTT_INFO_LEN as 16 */
+		if (ap_info.tbtt_info_len != TBTT_NEIGHBOR_BSSID_SSID_BSSP_PSD_MLD) {
+			wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: Unsupported TBTT Info Len Skip to next");
+			pos += (ap_info.tbtt_info_count + 1) * ap_info.tbtt_info_len;
+			continue;
+		}
+
+		if (!global_opp_class(ap_info.opp_class)) {
+			wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: Convert Country Opp-Code to Global Opp-Code");
+			opp_class = country_to_global_op_class(country, ap_info.opp_class);
+			ap_info.opp_class = opp_class;
+		}
+
+		for(i = 0; i <(ap_info.tbtt_info_count + 1); i++) {
+
+			local_wpa_s = get_wpas_ml(wpa_s, ap_info.opp_class, ap_info.chan_no);
+
+			if (!local_wpa_s)
+				goto skip_ap_info;
+
+			wpa_dbg(local_wpa_s, MSG_DEBUG, "Selected interface");
+
+			switch(ap_info.tbtt_info_len) {
+
+				case TBTT_NEIGHBOR_BSSID_SSID_BSSP_PSD_MLD:
+					tbtt_info.tbtt_offset = pos[0];
+					os_memcpy(tbtt_info.bssid, pos+1, ETH_ALEN);
+					os_memcpy(tbtt_info.short_ssid, pos+7, 4);
+					tbtt_info.bss_params = pos[11];
+					tbtt_info.psd_20mhz = pos[12];
+					tbtt_info.opp_class = ap_info.opp_class;
+					tbtt_info.chan_no = ap_info.chan_no;
+
+					tbtt_info.mld_id = pos[13];
+
+					if(tbtt_info.mld_id)
+						goto skip_ap_info;
+
+					tbtt_info.link_id = (pos[14] & TBTT_MLD_LINK_ID_MASK);
+					tbtt_info.bss_param_change_cnt = (pos[14] & 0xf0)>>TBTT_MLD_BSS_P_CHANGE_SHIFT | (pos[15] & 0x0f);
+
+					wpa_dbg(local_wpa_s, MSG_DEBUG, "ML_STA: Updating BSSID & Link_ID from RNR-IE in beacon");
+					local_wpa_s->link_id = tbtt_info.link_id;
+					os_memcpy(local_wpa_s->bssid, tbtt_info.bssid, ETH_ALEN);
+					wpa_dbg(local_wpa_s, MSG_DEBUG, "Link-ID = %d", local_wpa_s->link_id);
+					break;
+				default:
+					wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: Unsupported TBTT Info Len");
+			}
+skip_ap_info:
+			pos += ap_info.tbtt_info_len;
+		}
+	}
+	return 1;
+}
