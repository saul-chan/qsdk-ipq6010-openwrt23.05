+};
+
+struct rnr_neighbour_ap_info {
+	/* TBTT Information Header */
+	u8 tbtt_info_fieldtype:2;
+	u8 filtered_neighbour_ap:1;
+	u8 reserved:1;
+	u8 tbtt_info_count:4;
+	u8 tbtt_info_len;
+
+	u8 opp_class;
+	u8 chan_no;
+};
