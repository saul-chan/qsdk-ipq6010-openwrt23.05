+
+#define TBTT_INFO_FIELD_TYPE	0x03
+#define TBTT_INFO_FIL_NAP_MASK	0x04
+#define TBTT_INFO_FIL_NAP_SHIFT	2
+#define TBTT_INFO_COUNT_MASK	0xf0
+#define TBTT_INFO_COUNT_SHIFT	4
+#define TBTT_MLD_LINK_ID_MASK	0x0f
