+static int hostapd_ctrl_add_r0kh(struct hostapd_data *hapd, char *fname)
+{
+	char r0kh_data[128];
+	FILE *f;
+	f = fopen(fname, "r");
+	if (f == NULL) {
+		wpa_printf(MSG_ERROR, "Could not open configuration file '%s' "
+			   "for reading.", fname);
+		return -1;
+	}
+	while(fgets(r0kh_data, sizeof(r0kh_data), f)) {
+		if ((strlen(r0kh_data) > 1) && add_r0kh(hapd->conf, r0kh_data) < 0) {
+			wpa_printf(MSG_DEBUG, "Invalid r0kh");
+			return -1;
+		}
+	}
+
+	return 0;
+}
+
+static int hostapd_ctrl_add_r1kh(struct hostapd_data *hapd, char *fname)
+{
+	char r1kh_data[128];
+	FILE *f;
+	f = fopen(fname, "r");
+	if (f == NULL) {
+		wpa_printf(MSG_ERROR, "Could not open configuration file '%s' "
+			   "for reading.", fname);
+		return -1;
+	}
+	while(fgets(r1kh_data, sizeof(r1kh_data), f)) {
+		if ((strlen(r1kh_data) > 1) && add_r1kh(hapd->conf, r1kh_data) < 0) {
+			wpa_printf(MSG_DEBUG, "Invalid r1kh");
+			return -1;
+		}
+	}
+
+	return 0;
+}
 
