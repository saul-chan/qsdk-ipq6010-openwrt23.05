+static int hostapd_cli_cmd_add_r1kh(struct wpa_ctrl *ctrl, int argc,
+				    char *argv[])
+{
+	char buf[64];
+	if (argc != 1) {
+		printf("Invalid 'r1kh' command - exactly one argument, R1KH "
+		       "is required.\n");
+		return -1;
+	}
+	snprintf(buf, sizeof(buf), "R1KH %s", argv[0]);
+	return wpa_ctrl_command(ctrl, buf);
+}
+
+static int hostapd_cli_cmd_add_r0kh(struct wpa_ctrl *ctrl, int argc,
