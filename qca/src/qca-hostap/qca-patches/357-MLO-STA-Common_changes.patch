+#ifdef CONFIG_MLO
+/* Identify if both interfaces are part of the same active MLD Connection */
+bool wpa_partner_mlo_link(struct wpa_supplicant *wpa_s_first , struct wpa_supplicant *wpa_s_second)
+{
+	if(wpa_s_first != wpa_s_second
+	   && !is_zero_ether_addr(wpa_s_first->conf->sta_mld_addr)
+	   && !is_zero_ether_addr(wpa_s_second->conf->sta_mld_addr)
+	   && !os_memcmp(wpa_s_first->conf->sta_mld_addr, wpa_s_second->conf->sta_mld_addr, ETH_ALEN)) {
+		return true;
+	}
+
+	if(wpa_s_first != wpa_s_second
+	   && (wpa_s_first->conf->mld_id == wpa_s_second->conf->mld_id)
+	   && wpa_s_first->conf->mld_id && wpa_s_second->conf->mld_id) {
+		return true;
+	}
+
+	return false;
+}
+#endif /* CONFIG_MLO */
 
