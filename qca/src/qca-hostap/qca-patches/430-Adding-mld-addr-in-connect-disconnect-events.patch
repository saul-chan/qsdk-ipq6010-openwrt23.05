diff --git a/wpa_supplicant/ap.c b/wpa_supplicant/ap.c
index ff7c756..d3ec348 100644
--- a/wpa_supplicant/ap.c
+++ b/wpa_supplicant/ap.c
@@ -1184,9 +1184,21 @@ void wpa_supplicant_ap_deinit(struct wpa_supplicant *wpa_s)
