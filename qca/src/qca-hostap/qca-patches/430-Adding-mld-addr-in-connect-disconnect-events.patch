 	wpa_s->ap_iface = NULL;
 	wpa_drv_deinit_ap(wpa_s);
+#ifdef CONFIG_MLO
+	if (wpa_s->ml_connect)
+		wpa_msg(wpa_s, MSG_INFO, WPA_EVENT_DISCONNECTED "bssid=" MACSTR
+			" reason=%d locally_generated=1" " mld_addr=" MACSTR,
+			MAC2STR(wpa_s->own_addr), WLAN_REASON_DEAUTH_LEAVING,
+			MAC2STR(wpa_s->ap_mld_mac));
+	else
+		wpa_msg(wpa_s, MSG_INFO, WPA_EVENT_DISCONNECTED "bssid=" MACSTR
+			" reason=%d locally_generated=1",
+			MAC2STR(wpa_s->own_addr), WLAN_REASON_DEAUTH_LEAVING);
+#else
 	wpa_msg(wpa_s, MSG_INFO, WPA_EVENT_DISCONNECTED "bssid=" MACSTR
 		" reason=%d locally_generated=1",
 		MAC2STR(wpa_s->own_addr), WLAN_REASON_DEAUTH_LEAVING);
+#endif /* CONFIG_MLO */
 }
 
 
diff --git a/wpa_supplicant/events.c b/wpa_supplicant/events.c
index 3419d25..6ae6ee7 100644
--- a/wpa_supplicant/events.c
+++ b/wpa_supplicant/events.c
@@ -4511,10 +4511,24 @@ static void wpa_supplicant_event_disassoc(struct wpa_supplicant *wpa_s,
 
 	if (!is_zero_ether_addr(bssid) ||
 	    wpa_s->wpa_state >= WPA_AUTHENTICATING) {
+#ifdef CONFIG_MLO
+		if (wpa_s->ml_connect)
+			wpa_msg(wpa_s, MSG_INFO, WPA_EVENT_DISCONNECTED "bssid="
+				MACSTR " reason=%d%s" " mld_addr=" MACSTR,
+				MAC2STR(bssid), reason_code,
+				locally_generated ? " locally_generated=1" : "",
+				MAC2STR(wpa_s->ap_mld_mac));
+		else
+			wpa_msg(wpa_s, MSG_INFO, WPA_EVENT_DISCONNECTED "bssid="
+				MACSTR " reason=%d%s",
+			MAC2STR(bssid), reason_code,
+			locally_generated ? " locally_generated=1" : "");
+#else
 		wpa_msg(wpa_s, MSG_INFO, WPA_EVENT_DISCONNECTED "bssid=" MACSTR
 			" reason=%d%s",
 			MAC2STR(bssid), reason_code,
 			locally_generated ? " locally_generated=1" : "");
+#endif /* CONFIG_MLO */
 	}
 }
 
