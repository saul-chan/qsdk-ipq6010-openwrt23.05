--- a/wpa_supplicant/config.c
+++ b/wpa_supplicant/config.c
@@ -353,6 +353,29 @@ static char * wpa_config_write_addr_list(const struct parse_data *data,
 }
 #endif /* NO_CONFIG_WRITE */
 
+#ifdef CONFIG_MLO
+static int wpa_config_parse_preferred_ap_mld_addr(const struct parse_data *data,
+						  struct wpa_ssid *ssid, int line,
+						  const char *value)
+{
+	if (value[0] == '\0' || os_strcmp(value, "\"\"") == 0 ||
+	    os_strcmp(value, "any") == 0) {
+		ssid->preferred_ap_mld_addr_set = 0;
+		wpa_printf(MSG_MSGDUMP, "Preferred AP MLD addr any");
+		return 0;
+	}
+	if (hwaddr_aton(value, ssid->preferred_ap_mld_addr)) {
+		wpa_printf(MSG_ERROR, "Line %d: Invalid ADDR '%s'.",
+			   line, value);
+		return -1;
+	}
+	ssid->preferred_ap_mld_addr_set = 1;
+	wpa_hexdump(MSG_MSGDUMP, "Preferred AP MLD ADDR",
+		    ssid->preferred_ap_mld_addr, ETH_ALEN);
+	return 0;
+}
+#endif
+
 static int wpa_config_parse_bssid(const struct parse_data *data,
 				  struct wpa_ssid *ssid, int line,
 				  const char *value)
@@ -373,7 +396,28 @@ static int wpa_config_parse_bssid(const struct parse_data *data,
 	return 0;
 }
 
+#ifdef CONFIG_MLO
+static char * wpa_config_write_preferred_ap_mld_addr(const struct parse_data *data,
+						     struct wpa_ssid *ssid)
+{
+	char *value;
+	int res;
+
+	if (!ssid->preferred_ap_mld_addr_set)
+		return NULL;
 
+	value = os_malloc(20);
+	if (value == NULL)
+		return NULL;
+	res = os_snprintf(value, 20, MACSTR, MAC2STR(ssid->preferred_ap_mld_addr));
+	if (os_snprintf_error(20, res)) {
+		os_free(value);
+		return NULL;
+	}
+	value[20 - 1] = '\0';
+	return value;
+}
+#endif
 #ifndef NO_CONFIG_WRITE
