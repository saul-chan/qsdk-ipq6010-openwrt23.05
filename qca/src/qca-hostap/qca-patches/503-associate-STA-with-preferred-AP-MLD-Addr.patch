diff --git a/wpa_supplicant/ctrl_iface.c b/wpa_supplicant/ctrl_iface.c
index 490a9c7..8f931ba 100644
--- a/wpa_supplicant/ctrl_iface.c
+++ b/wpa_supplicant/ctrl_iface.c
@@ -2611,6 +2611,40 @@ static int wpa_supplicant_ctrl_iface_status(struct wpa_supplicant *wpa_s,
 	return pos - buf;
 }
 
+#ifdef CONFIG_MLO
+static int wpa_supplicant_ctrl_iface_preferred_ap_mld_addr(struct wpa_supplicant *wpa_s,
+							   char *cmd)
+{
+	char *pos;
+	int id;
+	struct wpa_ssid *ssid;
+	u8 preferred_ap_mld_addr[ETH_ALEN];
+
+	/* cmd: "<network id> <BSSID>" */
+	pos = os_strchr(cmd, ' ');
+	if (pos == NULL)
+		return -1;
+	*pos++ = '\0';
+	id = atoi(cmd);
+	wpa_printf(MSG_DEBUG, "CTRL_IFACE: id:%d preferred_ap_mld_addr='%s'", id, pos);
+	if (hwaddr_aton(pos, preferred_ap_mld_addr)) {
+		wpa_printf(MSG_DEBUG ,"CTRL_IFACE: invalid preferred ap mld bssid '%s'", pos);
+		return -1;
+	}
+
+	ssid = wpa_config_get_network(wpa_s->conf, id);
+	if (ssid == NULL) {
+		wpa_printf(MSG_DEBUG, "CTRL_IFACE: Could not find SSID id=%d "
+			   "to update", id);
+		return -1;
+	}
+
+	os_memcpy(ssid->preferred_ap_mld_addr, preferred_ap_mld_addr, ETH_ALEN);
+	ssid->preferred_ap_mld_addr_set = !is_zero_ether_addr(preferred_ap_mld_addr);
+
+	return 0;
+}
+#endif
 
