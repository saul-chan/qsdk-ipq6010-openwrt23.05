+#ifdef CONFIG_MLO
+static void clone_station_entry(struct hostapd_data *hapd,
+                                struct sta_info *sta_clone,
+                                struct sta_info *sta, uint8_t link_id)
+{
+	sta->ml->link_count++;
+	sta_clone->multi_link_id = link_id;
+	sta_clone->sae = sta->sae;
+	//sta_clone->eapol_sm = sta->eapol_sm;
+	sta_clone->auth_alg = sta->auth_alg;
+	sta_clone->wpa_sm = sta->wpa_sm;
+	if (sta_clone->wpa_sm && hapd->wpa_auth)
+		wpa_init_partner_link_group(sta_clone->wpa_sm,
+			hapd->wpa_auth, NULL);
+	sta_clone->listen_interval = sta->listen_interval;
+	sta_clone->ml = sta->ml;
+	hostapd_get_aid(hapd, sta_clone);
+
+}
+static int clone_on_partner_links(struct hostapd_data *hapd,
+				  struct sta_info *sta,
+				  int reassoc)
+{
+	struct link_info *item;
+
+	if (!hapd->mlo_link->mld) {
+		wpa_printf(MSG_ERROR, "ERROR!! %s: mld is NULL\n", __func__);
+		return WLAN_STATUS_UNSPECIFIED_FAILURE;
+	}
+
+	dl_list_for_each (item, &hapd->mlo_link->mld->links, struct link_info, list) {
+
+		uint8_t link_id;
+		struct hostapd_data *hapd_ptr;
+		hapd_ptr = item->hapd;
+		if (!hapd_ptr || (hapd_ptr == hapd))
+			continue;
+
+		link_id = hapd_ptr->mlo_link->link_id;
+		if (sta->ml->ie_assoc_reassoc_data[link_id]) {
+
+			struct sta_info *sta_clone;
+			/*
+			 * Add partner links only on links
+			 * which are indicated in the STA Profile
+			 * within the MLO IE
+			 *
+			 * ie_assoc_reassoc_data[link-id] will be set
+			 * only if we receive STA-PROFILE on the link-id
+			 */
+			sta_clone = ap_get_sta(hapd_ptr, sta->ml->partner_link_addr[link_id]);
+			if (!sta_clone) {
+				sta_clone =
+				ap_sta_add(hapd_ptr,
+					   sta->ml->partner_link_addr[link_id]);
+				if (sta_clone == NULL) {
+					wpa_printf(MSG_ERROR,
+						   "ERROR!! Failed to clone on "
+						   "partner link "
+						   MACSTR " \n",
+						   MAC2STR(hapd_ptr->own_addr));
+					return WLAN_STATUS_UNSPECIFIED_FAILURE;
+				}
+				clone_station_entry(hapd_ptr, sta_clone, sta, link_id);
+
+			} else if (sta_clone && !sta_clone->ml && !(sta_clone->flags & (WLAN_STA_ASSOC))){
+				wpa_printf(MSG_ERROR, "ERROR!! STA-CLONE "
+					   "already present but sta_info_ml "
+					   "is NULL! ");
+				clone_station_entry(hapd_ptr, sta_clone, sta, link_id);
+
+			} else if ((sta_clone->ml != sta->ml) ||
+				   (sta_clone->multi_link_id != link_id)) {
+
+				wpa_printf(MSG_ERROR, "ERROR!! STA-CLONE "
+					   "already present but with "
+					   "different link-id/ML Object "
+					   "%d %d\n",
+					   sta_clone->multi_link_id, link_id);
+				if (check_sa_query(hapd_ptr, sta_clone, 0))
+					/*
+					 * We need to send SA Query through
+					 * partner link, if the partner STA
+					 * is already associated with partner AP
+					 * through a different ML connection
+					 * or no-ML connection
+					 */
+					return WLAN_STATUS_ASSOC_REJECTED_TEMPORARILY;
+				else if (sta_clone->ml && (sta_clone->ml->assoc_link_sta == sta)) {
+					wpa_printf(MSG_ERROR, "ERROR!! %s:%d ASSERTION FAILURE\n",
+						   __func__, __LINE__);
+					return WLAN_STATUS_UNSPECIFIED_FAILURE;
+				} else {
+					ap_sta_disconnect(hapd_ptr, sta_clone, sta_clone->addr, WLAN_REASON_UNSPECIFIED);
+					return WLAN_STATUS_UNSPECIFIED_FAILURE;
+				}
+			}
+		}
+	}
+	return 0;
+}
+#endif
 
 
