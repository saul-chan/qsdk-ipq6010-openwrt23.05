diff --git a/wpa_supplicant/events.c b/wpa_supplicant/events.c
index b023e40..5e8ea26 100644
--- a/wpa_supplicant/events.c
+++ b/wpa_supplicant/events.c
@@ -2438,27 +2438,34 @@ struct wpa_supplicant *get_wpas_ml(struct wpa_supplicant *wpa_s,
 	int *supp_op_classes;
 	struct wpa_global *global = wpa_s->global;
 	struct wpa_supplicant *local_wpa_s = global->ifaces;
+	const struct oper_class_map *op;
+	struct hostapd_hw_modes *mode;
 
-	supp_op_classes = wpas_supp_op_classes(wpa_s);
-
-	if (op_class_found(supp_op_classes, op_class)) {
-		os_free(supp_op_classes);
-		return wpa_s;
+	op = get_oper_class(NULL, op_class);
+	if (!op) {
+		wpa_printf(MSG_DEBUG,
+			   "invalid operating class in beacon %d",
+			   op_class);
+		return NULL;
 	}
 
-	os_free(supp_op_classes);
-
 	wpa_for_each_mlo_link(local_wpa_s, global) {
 
-		if (wpa_s == local_wpa_s)
+		if(!wpa_is_mlo_link(wpa_s , local_wpa_s))
 			continue;
 
-		if(!wpa_partner_mlo_link(wpa_s , local_wpa_s))
-			continue;
+		mode = get_mode(local_wpa_s->hw.modes, local_wpa_s->hw.num_modes, op->mode,
+				is_6ghz_op_class(op_class));
+
+		if (!mode) {
+		    wpa_printf(MSG_DEBUG, "unable to fetch mode");
+		    continue;
+		}
 
 		supp_op_classes = wpas_supp_op_classes(local_wpa_s);
 
-		if (op_class_found(supp_op_classes, op_class)) {
+		if (op_class_found(supp_op_classes, op_class) &&
+		    (allow_channel(mode, op_class, chan_no, NULL) != NOT_ALLOWED)) {
 			os_free(supp_op_classes);
 			return local_wpa_s;
 		}
