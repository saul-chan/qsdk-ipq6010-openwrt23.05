+#ifdef CONFIG_MLO
+/* Identify if the interface is configured to be a ML non-AP STA */
+bool wpa_ml_sta(struct wpa_supplicant *wpa_s)
+{
+	if( !is_zero_ether_addr(wpa_s->conf->sta_mld_addr)
+	    || wpa_s->conf->mld_id )
+		return true;
+
+	return false;
+}
+
+#define MLD_ADDR_MASK 0xFF
+void wpa_update_ml_fields(struct wpa_bss *selected)
+{
+	const u8 *ml_ie;
+	ml_ie = get_ie_ext((const u8 *) (selected + 1), selected->ie_len, WLAN_EID_EXT_MULTI_LINK);
+	if(ml_ie[3] & MLD_ADDR_MASK) {
+		memcpy(selected->ml_info.ap_mld_addr, ml_ie+5, ETH_ALEN);
+	}
+	//get_ap_num_links(selected);
+}
+
+static int num_active_partner_links(struct wpa_supplicant *wpa_s, u8 ap_mld_mac[ETH_ALEN])
+{
+	struct wpa_global *global = wpa_s->global;
+	struct wpa_supplicant *local_wpa_s = global->ifaces;
+	int i, count=1;
+
+	wpa_for_each_mlo_link(local_wpa_s, global) {
+		if(wpa_partner_mlo_link(wpa_s , local_wpa_s)) {
+			for (i = 0; i < local_wpa_s->last_scan_res_used; i++) {
+				struct wpa_bss *bss = local_wpa_s->last_scan_res[i];
+				const u8 *ml_ie = get_ie_ext((const u8 *) (bss + 1), bss->ie_len, WLAN_EID_EXT_MULTI_LINK);
+				u8 temp_ap_mld_mac[ETH_ALEN];
+				if(ml_ie && (ml_ie[3] & MLD_ADDR_MASK)) {
+					memcpy(temp_ap_mld_mac, ml_ie+5, ETH_ALEN);
+					if(os_memcmp(temp_ap_mld_mac, ap_mld_mac, ETH_ALEN) == 0) {
+						count++;
+					}
+				}
+		       }
+               }
+       }
+       wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: Found on %d interfaces", count);
+       return count;
+}
+
+static int sta_num_links_mlo(struct wpa_supplicant *wpa_s)
+{
+	struct wpa_global *global = wpa_s->global;
+	struct wpa_supplicant *local_wpa_s = global->ifaces;
+	int count=1;
+
+	wpa_for_each_mlo_link(local_wpa_s, global) {
+		if (wpa_s == local_wpa_s)
+			continue;
+		if (!wpa_partner_mlo_link(wpa_s , local_wpa_s))
+			continue;
+		count++;
+	}
+	wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: Is a %d link ML-STA", count);
+	return count;
+}
+
+static void wpa_update_link_bssid(struct wpa_supplicant *wpa_s, u8 ap_mld_mac[ETH_ALEN])
+{
+	struct wpa_global *global = wpa_s->global;
+	struct wpa_supplicant *local_wpa_s = global->ifaces;
+	int i;
+
+	wpa_for_each_mlo_link(local_wpa_s, global) {
+		if(wpa_partner_mlo_link(wpa_s , local_wpa_s)) {
+			for (i = 0; i < local_wpa_s->last_scan_res_used; i++) {
+				struct wpa_bss *bss = local_wpa_s->last_scan_res[i];
+				const u8 *ml_ie = get_ie_ext((const u8 *) (bss + 1), bss->ie_len, WLAN_EID_EXT_MULTI_LINK);
+				u8 temp_ap_mld_mac[ETH_ALEN];
+				if(ml_ie && (ml_ie[3] & MLD_ADDR_MASK)) {
+					memcpy(temp_ap_mld_mac, ml_ie+5, ETH_ALEN);
+					if(os_memcmp(temp_ap_mld_mac, ap_mld_mac, ETH_ALEN) == 0) {
+						os_memcpy(local_wpa_s->bssid, bss->bssid, ETH_ALEN);
+						local_wpa_s->link_id = ml_ie[11] & 0x0f;
+					}
+				}
+		       }
+               }
+	}
+}
