+#ifdef CONFIG_MLO
+static int wpa_mlo_link_scan_done(struct wpa_supplicant *wpa_s)
+{
+	struct wpa_global *global = wpa_s->global;
+	struct wpa_supplicant *local_wpa_s = global->ifaces;
+	int ret = 1;
+
+	wpa_for_each_mlo_link(local_wpa_s, global) {
+		if(wpa_partner_mlo_link(wpa_s , local_wpa_s)) {
+			if(local_wpa_s->scan_done == false)
+				ret=0;
+		}
+	}
+	return ret;
+}
+
+static int wpa_update_link_device(struct wpa_supplicant *wpa_s)
+{
+	bool ret = false;
+
+	ret = wpa_drv_set_mlo_link_wdev(wpa_s);
+
+	return ret;
+}
+
+static int wpa_mlo_updata_partner_link_state(struct wpa_supplicant *wpa_s)
+{
+
+	struct wpa_global *global = wpa_s->global;
+	struct wpa_supplicant *local_wpa_s = global->ifaces;
+	bool ret = true;
+
+	wpa_for_each_mlo_link(local_wpa_s, global) {
+		if(wpa_partner_mlo_link(wpa_s , local_wpa_s)) {
+			if(!wpa_update_link_device(local_wpa_s))
+				ret = false;
+		}
+	}
+	return ret;
+}
+
+static void wpa_reset_ml_config(struct wpa_supplicant *wpa_s)
+{
+	u8 def_mac[ETH_ALEN] = { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 };
+
+	wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: Reset MLD ID and MLD Mac");
+	wpa_s->conf->mld_id = 0;
+	os_memcpy(wpa_s->conf->sta_mld_addr, def_mac, ETH_ALEN);
+	wpa_s->ml_connect = false;
+	wpa_s->primary_link = false;
+	os_memcpy(wpa_s->ap_mld_mac, def_mac, ETH_ALEN);
+	wpa_s->active_ml_sta = false;
+}
+
+static int wpa_mlo_common_candidate_selection(struct wpa_supplicant *wpa_s,
+					      union wpa_event_data *data,
+					      int new_scan,
+					      int own_request)
+{
+	struct wpa_global *global = wpa_s->global;
+	struct wpa_supplicant *local_wpa_s = global->ifaces;
+
+	int ref_thpt = 0;
+	struct wpa_bss *selected = NULL;
+	struct wpa_ssid *ssid = NULL;
+	struct wpa_ssid *selected_ssid = NULL;
+	struct wpa_supplicant *selected_wpa_s = wpa_s;
+	struct wpa_bss *temp_selected = NULL;
+
+	wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: MLO Candidate Selection - START");
+
+	/* if Single Link STA fall back to legacy */
+	if (sta_num_links_mlo(selected_wpa_s) == 1) {
+		wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: Single Link MLO STA - Fall back to legacy non-MLO mode");
+		wpa_reset_ml_config(wpa_s);
+		wpa_supplicant_req_new_scan(wpa_s, wpa_s->scan_interval, 0);
+		wpa_msg_ctrl(wpa_s, MSG_INFO, WPA_EVENT_NETWORK_NOT_FOUND);
+		return 0;
+	}
+
+	/**
+	 * The candidate selection aim's to find the best candidate per link
+	 * Then among the links the best candidate.
+	 * It is inevitably assumed that MLD capable AP's will have
+	 * higher estimated throughput which serves as the heart of the
+	 * candidate selection
+	 */
+	wpa_for_each_mlo_link(local_wpa_s, global) {
+		if( !is_zero_ether_addr(wpa_s->conf->sta_mld_addr)
+		    && !is_zero_ether_addr(local_wpa_s->conf->sta_mld_addr)
+		    && !os_memcmp(wpa_s->conf->sta_mld_addr, local_wpa_s->conf->sta_mld_addr, ETH_ALEN)) {
+
+			/* expecting ML Candidate */
+			temp_selected = wpa_supplicant_pick_network(local_wpa_s, &ssid);
+
+			if( temp_selected && (temp_selected->est_throughput > ref_thpt)) {
+				selected_wpa_s = local_wpa_s;
+				selected = temp_selected;
+				selected_ssid = ssid;
+				ref_thpt = selected->est_throughput;
+			}
+		}
+	}
+	wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: MLO Candidate Selection - END");
+
+	if (selected) {
+		wpa_dbg(selected_wpa_s, MSG_DEBUG, "ML_STA: Considerig MLO Connect selected network is MLD AP");
+
+		/* This is a WAR till ML IE parsing is done */
+		wpa_update_ml_fields(selected);
+		if(num_active_partner_links(selected_wpa_s, selected->ml_info.ap_mld_addr)<=1) {
+			wpa_dbg(selected_wpa_s, MSG_DEBUG, "ML_STA: Discard Candidate as it is 1 overlapping link Supported");
+			goto rescan;
+		}
+		wpa_update_link_bssid(selected_wpa_s, selected->ml_info.ap_mld_addr);
+		/* This is a WAR till RNR IE parsing is done */
+
+		if (wpa_supplicant_connect(selected_wpa_s, selected, selected_ssid) < 0) {
+			wpa_dbg(selected_wpa_s, MSG_DEBUG, "ML_STA: Connect failed");
+			return -1;
+		}
+
+		/* Work Around for ML_STA Now */
+		if(!is_zero_ether_addr(selected->ml_info.ap_mld_addr))
+		{
+			wpa_msg(selected_wpa_s, MSG_DEBUG, "ML_STA: Associating with ML-AP " MACSTR,
+				MAC2STR(selected->ml_info.ap_mld_addr));
+			os_memcpy(selected_wpa_s->ap_mld_mac , selected->ml_info.ap_mld_addr, ETH_ALEN);
+			selected_wpa_s->ml_connect = true;
+			selected_wpa_s->primary_link = true;
+			selected_wpa_s->active_ml_sta = true;
+			wpa_for_each_mlo_link(local_wpa_s, global) {
+				if(wpa_partner_mlo_link(selected_wpa_s, local_wpa_s)) {
+					local_wpa_s->ml_connect = true;
+					local_wpa_s->active_ml_sta = true;
+				}
+			}
+		}
+
+		/* Update Non-Assoc Links to MLO_LINK_DEVICE */
+		wpa_dbg(selected_wpa_s, MSG_DEBUG, "ML_STA: Update Partner Links as MLO_LINK_DEVICE");
+		wpa_mlo_updata_partner_link_state(selected_wpa_s);
+
+		/* Update Non-Assoc Links to Logical WPA_MLO_WAIT state */
+		wpa_for_each_mlo_link(local_wpa_s, global) {
+			if(wpa_partner_mlo_link(selected_wpa_s, local_wpa_s)) {
+				wpa_supplicant_set_state(local_wpa_s, WPA_MLO_WAIT);
+			}
+		}
+	} else {
+rescan:
+		wpa_s->no_suitable_network++;
+		wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: No suitable MLO - network found");
+		ssid = wpa_supplicant_pick_new_network(wpa_s);
+		if (ssid) {
+			wpa_dbg(wpa_s, MSG_DEBUG, "Setup a new network");
+			wpa_supplicant_associate(wpa_s, NULL, ssid);
+			if (new_scan)
+				wpa_supplicant_rsn_preauth_scan_results(wpa_s);
+		} else {
+			/* clear ML cap's and go to non-ML mode */
+			wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: Failed to connect");
+			wpa_dbg(local_wpa_s, MSG_DEBUG, "ML_STA: Re-start All wdev SCAN");
+
+			wpa_supplicant_req_new_scan(wpa_s, wpa_s->scan_interval, 0);
+			wpa_msg_ctrl(wpa_s, MSG_INFO, WPA_EVENT_NETWORK_NOT_FOUND);
+
+			wpa_for_each_mlo_link(local_wpa_s, global) {
+				if(wpa_partner_mlo_link(wpa_s , local_wpa_s)) {
+					if (wpa_supplicant_req_sched_scan(local_wpa_s))
+						wpa_supplicant_req_new_scan(local_wpa_s, local_wpa_s->scan_interval, 0);
+					wpa_msg_ctrl(local_wpa_s, MSG_INFO, WPA_EVENT_NETWORK_NOT_FOUND);
+				}
+			}
+		}
+	}
+
+	return 0;
+}
