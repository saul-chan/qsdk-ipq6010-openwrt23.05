+#ifdef CONFIG_MLO
+/* Place Holder ML-IE code on Connect Req */
+static int wpa_assoc_req_eid_basic_len(struct wpa_supplicant *wpa_s)
+{
+	/*
+	 * In Phase 1 the ML-IE in Connect will have ML-Control with MLD_Mac
+	 * and Link_ID, In Per-STA profile STA Control has only link_id & MAC Address
+	 * STA Profile IE's will be added in Subsequent Phases, Now Driver to find this
+	 * from scan entry
+	 */
+	int elen = 0;
+	struct wpa_global *global = wpa_s->global;
+	struct wpa_supplicant *local_wpa_s = global->ifaces;
+
+	elen += 5+ETH_ALEN+1; /* MLD MAC + Link_ID in Common-Info */
+	wpa_for_each_mlo_link(local_wpa_s, global) {
+		if(wpa_partner_mlo_link(wpa_s , local_wpa_s)
+		   && local_wpa_s->active_ml_sta) {
+			elen +=(2+2+ETH_ALEN);
+			/* Sub_Elem_ID + Length + STA_control + STA-Info(Link MAC) */
+		}
+	}
+
+	return elen;
+}
+
+static struct wpabuf * wpa_assoc_req_eid_basic(struct wpa_supplicant *wpa_s)
+{
+	/*
+	 * This Needs Major Revisit in Phase-2
+	 */
+	struct wpa_global *global = wpa_s->global;
+	struct wpa_supplicant *local_wpa_s = global->ifaces;
+
+	int elen = wpa_assoc_req_eid_basic_len(wpa_s);
+	struct wpabuf *ie = NULL;
+	u8 temp;
+
+	ie = wpabuf_alloc(elen);
+	if(!ie)
+		return NULL;
+	wpabuf_put_u8(ie, WLAN_EID_EXTENSION);
+	wpabuf_put_u8(ie,elen-2);
+	wpabuf_put_u8(ie, WLAN_EID_EXT_MULTI_LINK);
+	wpabuf_put_u8(ie, 0x30);
+	wpabuf_put_u8(ie, 0x0);
+	wpabuf_put_data(ie,wpa_s->conf->sta_mld_addr,ETH_ALEN);
+	wpabuf_put_u8(ie, wpa_s->link_id);
+
+	wpa_for_each_mlo_link(local_wpa_s, global) {
+		if(wpa_partner_mlo_link(wpa_s , local_wpa_s)
+		   && local_wpa_s->active_ml_sta) {
+			wpabuf_put_u8(ie,0x0);
+			wpabuf_put_u8(ie,8);
+			temp = (local_wpa_s->link_id & 0x0F) |  0x20;
+			wpabuf_put_u8(ie,temp);
+			wpabuf_put_u8(ie,0x0);
+			wpabuf_put_data(ie, local_wpa_s->own_addr, ETH_ALEN);
+		}
+	}
+
+	return ie;
+}
+#endif /* CONFIG_MLO */
 
