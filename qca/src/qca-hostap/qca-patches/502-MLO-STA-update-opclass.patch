 #ifdef CONFIG_MLO
+struct  wpa_ssid *wpa_ml_ssid(struct wpa_supplicant *wpa_s, u8 *bssid,
+				    struct wpa_ssid *assoc_ssid)
+{
+	size_t prio;
+	struct wpa_bss *bss = NULL;
+	struct wpa_ssid *ssid = NULL;
+	int i = 0;
+	
+	bss = wpa_bss_get(wpa_s, bssid, assoc_ssid->ssid, assoc_ssid->ssid_len);
+
+	if (bss) {
+		wpa_dbg(wpa_s, MSG_DEBUG, "%u: " MACSTR
+			" freq=%d level=%d snr=%d est_throughput=%u",
+			i, MAC2STR(bss->bssid), bss->freq, bss->level,
+			bss->snr, bss->est_throughput);
+	} else {
+		wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: No BSS Found");
+		return NULL;
+	}
+
+	for (prio = 0; prio < wpa_s->conf->num_prio; prio++) {
+		ssid = wpa_scan_res_match(wpa_s, 0, bss, wpa_s->conf->pssid[prio], 0, 1);
+		if (ssid) {
+			wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: MLO Link Network profile found");
+			return ssid;
+		}
+	}
+
+	wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: MLO Link No Network Profile found");
+	return NULL;
+}
+
+static int wpa_ml_per_sta_ie_len(struct wpa_supplicant *wpa_s, 
+				 struct wpa_ssid *assoc_ssid)
+{
+	struct wpa_bss *bss = NULL;
+	struct wpa_ssid *ssid = wpa_ml_ssid(wpa_s, wpa_s->bssid, assoc_ssid);
+	u8 max_op_ie_len = 255;
+	u8 *buf;
+	u8 ret;
+	int i = 0;
+
+
+	bss = wpa_bss_get(wpa_s, wpa_s->bssid, assoc_ssid->ssid, assoc_ssid->ssid_len);
+
+	if (!ssid) {
+		wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: Network Profile Not-Found, can't add Per-STA Profile");
+		return -1;
+	}
+
+	if (bss) {
+		buf = os_malloc(max_op_ie_len);
+
+		if (!buf)
+			return -1;
+
+		wpa_dbg(wpa_s, MSG_DEBUG, "%u: " MACSTR
+			" freq=%d level=%d snr=%d est_throughput=%u",
+			i, MAC2STR(bss->bssid), bss->freq, bss->level,
+			bss->snr, bss->est_throughput);
+		ret = wpas_supp_op_class_ie(wpa_s, ssid, bss, buf, max_op_ie_len);
+		os_free(buf);
+	} else {
+		wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: BSS scan-entry Not-Found, can't add Per-STA Profile");
+		ret = 0;
+	}
+
+	return ret;
+}
