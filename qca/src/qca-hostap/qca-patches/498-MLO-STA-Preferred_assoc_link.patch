+static struct wpa_supplicant *wpa_get_preffered_assoc_link(struct wpa_supplicant *wpa_s)
+{
+	struct wpa_global *global = wpa_s->global;
+	struct wpa_supplicant *local_wpa_s = global->ifaces;
+	struct wpa_supplicant *assoc_wpa_s = NULL;
+
+	wpa_for_each_mlo_link(local_wpa_s, global) {
+		if (!wpa_is_mlo_link(wpa_s , local_wpa_s))
