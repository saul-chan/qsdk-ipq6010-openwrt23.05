+static int check_other_mld_sa_query(struct hostapd_data *hapd,
+				    const u8 *sta_mld)
+{
+	struct hostapd_data *hapd_ptr;
+	int i;
+	struct sta_info_ml *sta_ml_obj;
+
+	for (i=0; i < hapd->iface->interfaces->count; i++) {
+		struct sta_info *osta;
+
+		hapd_ptr = hapd->iface->interfaces->iface[i]->bss[0];
+		if (hapd == hapd_ptr)
+			continue;
+
+		if (os_memcmp(hapd->conf->mld_mac_addr,
+			      hapd_ptr->conf->mld_mac_addr, ETH_ALEN) == 0)
+			continue;
+
+		sta_ml_obj = ap_get_sta_mlo_obj(hapd_ptr, sta_mld);
+		if (!sta_ml_obj)
+			continue;
+
+		osta = sta_ml_obj->assoc_link_sta;
+		return mlo_partner_sta_sa_query(hapd_ptr, osta->addr,
+						osta->multi_link_id);
+	}
+	return 0;
+}
