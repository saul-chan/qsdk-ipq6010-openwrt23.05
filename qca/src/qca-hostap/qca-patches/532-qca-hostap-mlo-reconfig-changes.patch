+struct mlo_link_removal_db
+{
+	uint8_t links_removed[MAX_MLO_LINKS];
+	struct hostapd_data *hapd;
+};
+
+
+/*
+ * function to mark the partner link as removed in the db
+ * (if the partner was dynamically removed)
+ */
+static void hostapd_track_mlo_link_removal_bss(struct hostapd_data *hapd,
+					      struct mlo_link_removal_db *db)
+{
+	int link_cnt = 0;
+
+	if (!hapd)
+		return;
+
+	if (db->hapd == hapd)
+		return;
+
+	/*
+	 * Check if this partner link belongs to the same
+	 * MLD
+	 */
+	if (os_memcmp(hapd->conf->mld_mac_addr,
+				db->hapd->conf->mld_mac_addr,
+				ETH_ALEN))
+		return;
+
+	/*
+	 * Figure out which is the link-id in the conf that matches
+	 * with this partner
+	 */
+	for (link_cnt = 0; link_cnt < MAX_MLO_LINKS; link_cnt++) {
+		if (os_memcmp(db->hapd->conf->mld_link_mac_list.addr[link_cnt],
+			      hapd->own_addr, ETH_ALEN) == 0)
+			break;
+	}
+
+	if (link_cnt >= MAX_MLO_LINKS)
+		return;
+
+	if (hapd->mlo_link_removed) {
+		uint8_t link_id;
+
+		link_id = db->hapd->conf->mld_link_id_list.link_id[link_cnt];
+		db->links_removed[link_id] = 1;
+	}
+	return;
+}
+
+static int hostapd_track_mlo_link_removal(struct hostapd_iface *iface, void *ctx)
+{
+	struct mlo_link_removal_db *db = ctx;
+	int i;
+
+	for(i = 0; i < iface->num_bss; i++)
+		hostapd_track_mlo_link_removal_bss(iface->bss[i], db);
+	return 0;
+}
