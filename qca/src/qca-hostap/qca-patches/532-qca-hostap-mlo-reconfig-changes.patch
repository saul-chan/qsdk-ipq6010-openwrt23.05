+#ifdef CONFIG_MLO
+static void mlo_reconfig_disassoc_timeout(void *eloop_ctx, void *timeout_ctx)
+{
+	struct hostapd_data *hapd = eloop_ctx;
+	uint8_t bcast_mac[] = {0xff, 0xff, 0xff, 0xff, 0xff, 0xff};
+	if (!hapd->mlo_link)
+		return;
+	/*
+	 * Mark that disassoc timeout has happened
+	 */
+	hapd->mlo_link->reconfig_remove.disassoc_timeout = 1;
+	if (hapd->mlo_link->reconfig_remove.tbtt_complete) {
+
+		/*
+		 * This happens in SCENARIO-1 (which is the most likely
+		 * scenario)
+		 *
+		 * SCENARIO-1 has following sequence of events
+		 * 1. TBTT=0 event (implying tbtt_complete = 1)
+		 * 2. Disassoc timeout
+		 * 3. BSS-Term timeout
+		 */
+		hostapd_drv_sta_disassoc(hapd, bcast_mac, WLAN_REASON_DEAUTH_LEAVING);
+		hapd->mlo_link->reconfig_remove.disassoc_done = 1;
+	}
+}
+
+
+static void mlo_reconfig_bssterm_timeout(void *eloop_ctx, void *timeout_ctx)
+{
+	struct hostapd_data *hapd = eloop_ctx;
+
+	if (!hapd->mlo_link)
+		return;
+
+	/*
+	 * Mark that BSS Term timeout has happened
+	 */
+	hapd->mlo_link->reconfig_remove.bss_term_timeout = 1;
+
+	/*
+	 * BSS is not terminated until both the BSS termination timeout
+	 * (within hostapd) and the TBTT=0 event (from driver) has happened
+	 */
+	if (hapd->mlo_link->reconfig_remove.tbtt_complete)
+		/*
+		 * This happens in SCENARIO-1 (which is the most likely
+		 * scenario) or SCENARIO-2
+		 * SCENARIO-1 has following sequence of events
+		 * 1. TBTT=0 event (implying tbtt_complete = 1)
+		 * 2. Disassoc timeout
+		 * 3. BSS-Term timeout
+		 *
+		 * SCENARIO-2 has the following sequence of events
+		 * 1. Disassoc timeout
+		 * 2. TBTT=0 event (implying tbtt_complete = 1)
+		 * 3. BSS-Term timeout
+		 *
+		 */
+		hostapd_disable_iface_reconfig(hapd->iface);
+}
+
+#define MLO_RECONFIG_TBTT_DISASSOC_OFFSET 2
+#define MLO_RECONFIG_TBTT_BSSTERM_OFFSET 4
