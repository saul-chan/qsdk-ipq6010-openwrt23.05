+#ifdef CONFIG_MLO
+static void qca_nl80211_update_tbtt(struct wpa_driver_nl80211_data *drv,
+		u8 *data, size_t len)
+{
+	struct nlattr *tb[QCA_WLAN_VENDOR_ATTR_TBTT_START_MAX + 1];
+	union wpa_event_data event;
+
+	if (nla_parse(tb, QCA_WLAN_VENDOR_ATTR_TBTT_START_MAX,
+		      (struct nlattr *) data, len, NULL)) {
+		wpa_printf(MSG_ERROR, "ERROR!! %s:FAILURE IN NLA_PARSE\n",
+			   __func__);
+		return;
+	}
+
+	if (!tb[QCA_WLAN_VENDOR_ATTR_TBTT_START_TSF]) {
+		wpa_printf(MSG_ERROR, "ERROR!! %s: No TSF VALUE IN NL\n",
+			   __func__);
+		return;
+	}
+
+	if (!tb[QCA_WLAN_VENDOR_ATTR_TBTT_START_TBTT]) {
+		wpa_printf(MSG_ERROR, "ERROR!! %s: No TBTT VALUE IN NL\n",
+			   __func__);
+		return;
+	}
+
+	if (!tb[QCA_WLAN_VENDOR_ATTR_TBTT_START_BCN_INT]) {
+		wpa_printf(MSG_ERROR, "ERROR!! %s: No BCNINT VALUE IN NL\n",
+			   __func__);
+		return;
+	}
+
+	event.tbtt_event_data.tsf =
+		nla_get_u64(tb[QCA_WLAN_VENDOR_ATTR_TBTT_START_TSF]);
+	event.tbtt_event_data.beacon_interval =
+		nla_get_u16(tb[QCA_WLAN_VENDOR_ATTR_TBTT_START_BCN_INT]);
+	event.tbtt_event_data.tbtt =
+		nla_get_u16(tb[QCA_WLAN_VENDOR_ATTR_TBTT_START_TBTT]);
+	/*wpa_printf(MSG_ERROR, "value of tbtt-event tsf is %" PRIu64 "\n",
+		   event.tbtt_event_data.tsf);*/
+	wpa_printf(MSG_ERROR, "value of tbtt-event beacon interval is %d\n",
+		   event.tbtt_event_data.beacon_interval);
+	wpa_printf(MSG_ERROR, "value of tbtt-event tbtt is %d\n",
+		   event.tbtt_event_data.tbtt);
+
+	wpa_supplicant_event(drv->ctx, EVENT_UPDATE_TBTT, &event);
+}
+#endif
 
 
