+static int driver_nl80211_reconfig_btmreq(void *priv, uint16_t disassoc,
+					  uint64_t bssterm)
+{
+	struct i802_bss *bss = priv;
+	struct wpa_driver_nl80211_data *drv = bss->drv;
+	struct nl_msg *msg;
+	struct nlattr *attr;
+	/*
+	 * Send broadcast BTM
+	 */
+	uint8_t bcast_mac[] = {0xff, 0xff, 0xff, 0xff, 0xff, 0xff};
+
+	if (!(msg = nl80211_drv_msg(drv, 0, NL80211_CMD_VENDOR)) ||
+			nla_put_u32(msg, NL80211_ATTR_VENDOR_ID, OUI_QCA) ||
+			nla_put_u32(msg, NL80211_ATTR_VENDOR_SUBCMD,
+				QCA_NL80211_VENDOR_SUBCMD_RECONFIG_BTMREQ) ||
+            !(attr = nla_nest_start(msg, NL80211_ATTR_VENDOR_DATA)) ||
+			nla_put(msg, QCA_WLAN_VENDOR_ATTR_RECONFIG_BTM_MAC, ETH_ALEN, bcast_mac) ||
+			nla_put_u16(msg, QCA_WLAN_VENDOR_ATTR_RECONFIG_BTM_DISASSOC, disassoc) ||
+			nla_put_u64(msg, QCA_WLAN_VENDOR_ATTR_RECONFIG_BTM_BSSTERM, bssterm)) {
+
+		nl80211_nlmsg_clear(msg);
+		nlmsg_free(msg);
+		wpa_printf(MSG_ERROR, "ERROR!! %s:NL put failure\n", __func__);
+		return -1;
+	}
+	nla_nest_end(msg, attr);
+
+	if (send_and_recv_msgs(drv, msg, NULL, NULL, NULL, NULL)) {
+		wpa_printf(MSG_ERROR, "ERROR!! %s: NL Send failure\n", __func__);
+		return -1;
+	}
+	return 0;
+}
