+#ifdef CONFIG_MLO
+static int add_bss_to_partner_link_config(struct hostapd_data *partner_hapd,
+					  struct hostapd_data *new_hapd)
+{
+	int i, j;
+	int partner_num_links = partner_hapd->conf->mld_link_mac_list.num_links;
+	int new_if_num_links = new_hapd->conf->mld_link_mac_list.num_links;
+	struct mld_link_macs *partner_mac_list;
+	struct mld_link_ids *partner_link_id_list;
+
+	if (partner_hapd == new_hapd)
+		return 0;
+
+	if (os_memcmp(partner_hapd->conf->mld_mac_addr, new_hapd->conf->mld_mac_addr, ETH_ALEN))
+		return 0;
+
+	partner_mac_list = &partner_hapd->conf->mld_link_mac_list;
+	partner_link_id_list = &partner_hapd->conf->mld_link_id_list;
+
+	if (partner_num_links != partner_link_id_list->num_links) {
+
+		wpa_printf(MSG_ERROR, "ERROR!! %s: link count mismatch for %s\n",
+			   __func__, partner_hapd->conf->iface);
+		return -1;
+	}
+
+	for (i = 0; i < new_if_num_links; i++) {
+
+		uint8_t *mac_addr_in_new_list;
+		uint8_t link_id_in_new_list;
+		bool found;
+
+		mac_addr_in_new_list =
+		new_hapd->conf->mld_link_mac_list.addr[i];
+		link_id_in_new_list =
+		new_hapd->conf->mld_link_id_list.link_id[i];
+
+		found = false;
+
+		/*
+		 * Check the link's presence in the partner's
+		 * link-mac database
+		 */
+		for (j = 0; j < partner_num_links; j++) {
+
+			uint8_t *mac_addr_in_partner_list;
+			uint8_t link_id_in_partner_list;
+
+			mac_addr_in_partner_list = partner_mac_list->addr[j];
+			link_id_in_partner_list =
+				partner_link_id_list->link_id[j];
+
+			/*
+			 * Link-id is different, skip to the next
+			 * entry in the partner-DB
+			 */
+			if (link_id_in_new_list != link_id_in_partner_list)
+				continue;
+			/*
+			 * Check for mismatch between partner interface mac db and
+			 * new interface mac db
+			 */
+			if (os_memcmp(mac_addr_in_partner_list,
+				      mac_addr_in_new_list, ETH_ALEN)) {
+				wpa_printf(MSG_ERROR, "ERROR!! %s mac address mismatch"
+				   "in entry %d\n"
+				   "new-if:%s:"MACSTR" partner:%s:"MACSTR"\n",
+				   __func__,
+				   i,
+				   new_hapd->conf->iface,
+				   MAC2STR(mac_addr_in_new_list),
+				   partner_hapd->conf->iface,
+				   MAC2STR(mac_addr_in_partner_list));
+				return -1;
+
+			}
+			found = true;
+			break;
+		}
+
+		/*
+		 * If the entry from new-link's DB is already there in the
+		 * partner DB, continue and get to the next entry in the incoming
+		 * new link's DB
+		 */
+		if (found)
+			continue;
+
+		/*
+		 * Add the entry to the partner's DB
+		 */
+		os_memcpy(partner_mac_list->addr[partner_num_links],
+				mac_addr_in_new_list, ETH_ALEN);
+		partner_link_id_list->link_id[partner_num_links] =
+			link_id_in_new_list;
+		partner_num_links++;
+	}
+
+	/*
+	 * Update the partner DB's num_links
+	 */
+	partner_link_id_list->num_links = partner_num_links;
+	partner_mac_list->num_links = partner_num_links;
+	return 0;
+}
+
+static int add_link_to_partner_link_config(struct hostapd_iface *partner_iface,
+					   void *ctx)
+{
+	struct hostapd_data *new_hapd = ctx;
+	int i;
+	for(i = 0; i < partner_iface->num_bss; i++) {
+		struct hostapd_data *partner_hapd = partner_iface->bss[i];
+
+		if (add_bss_to_partner_link_config(partner_hapd, new_hapd))
+			return -1;
+	}
+	return 0;
+
+}
+static int add_link_to_partner_link_configs(struct hostapd_iface *new_iface)
+{
+	int i;
+	for(i = 0; i < new_iface->num_bss; i++) {
+		struct hostapd_data *new_hapd;
+
+		new_hapd = new_iface->bss[i];
+		if (new_hapd->conf->mld_link_mac_list.num_links !=
+			new_hapd->conf->mld_link_id_list.num_links) {
+
+			wpa_printf(MSG_ERROR, "ERROR!! %s count mismatch between link and MAC array in %s\n",
+					__func__, new_hapd->conf->iface);
+			return -1;
+		}
+
+		if (hostapd_for_each_interface(new_iface->interfaces,
+					       add_link_to_partner_link_config,
+					       new_hapd))
+			return -1;
+	}
+	return 0;
+}
