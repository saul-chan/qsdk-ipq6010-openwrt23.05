+static void hostapd_reconfig_remove_tbtt_first(struct hostapd_data *hapd,
+					       uint16_t tbtt,
+					       uint16_t bcn_interval,
+					       uint64_t tsf)
+{
+	uint64_t bss_term_tsf;
+
+	if (bcn_interval > MLO_RECONFIG_BCN_INTERVAL_MAX) {
+		wpa_printf(MSG_ERROR, "ERROR!! %s: beacon interval greater than allowed %d\n", __func__, bcn_interval);
+		return;
+	}
+
+	if (tbtt > MLO_RECONFIG_TBTT_MAX) {
+		wpa_printf(MSG_ERROR, "ERROR!! %s: tbtt value greater than allowed %d\n", __func__, tbtt);
+		return;
+	}
+
+	bss_term_tsf = tsf+ ((tbtt+MLO_RECONFIG_TBTT_BSSTERM_OFFSET)*(bcn_interval*1000));
+	if (hostapd_drv_reconfig_btmreq(hapd->conf->iface, hapd,
+				tbtt+MLO_RECONFIG_TBTT_DISASSOC_OFFSET,
+				bss_term_tsf)) {
+		wpa_printf(MSG_ERROR, "ERROR!! %s: BTM Request send failed\n",
+				hapd->conf->iface);
+		return;
+	}
+	eloop_register_timeout(0,
+			((bcn_interval*1000*tbtt) +
+			 (MLO_RECONFIG_TBTT_DISASSOC_OFFSET*bcn_interval*1000)),
+			mlo_reconfig_disassoc_timeout, hapd, NULL);
+	eloop_register_timeout(0,
+			((bcn_interval*1000*tbtt) +
+			 (MLO_RECONFIG_TBTT_BSSTERM_OFFSET*bcn_interval*1000)),
+			mlo_reconfig_bssterm_timeout, hapd, NULL);
+
+}
+
+static void hostapd_reconfig_remove_tbtt_last(struct hostapd_data *hapd)
+{
+
+	uint8_t bcast_mac[] = {0xff, 0xff, 0xff, 0xff, 0xff, 0xff};
+
+	if (!hapd->mlo_link) {
+		wpa_printf(MSG_ERROR, "ERROR!! MLO-LINK is NULL in %s\n",
+				__func__);
+		return;
+	}
+
+	hapd->mlo_link->reconfig_remove.tbtt_complete = 1;
+	if (!hapd->mlo_link->reconfig_remove.disassoc_done &&
+			hapd->mlo_link->reconfig_remove.disassoc_timeout) {
+		/*
+		 * If disassoc was not sent to driver but the disassoc
+		 * timeout has happened, send the disassoc to driver now
+		 * This happens in the following cases
+		 * SCENARIO-2
+		 * 1. Disassoc timeout
+		 * 2. TBTT=0 event
+		 * 3. BSS-Term timeout
+		 *
+		 * or SCENARIO-3
+		 * 1. Disassoc timeout
+		 * 2. BSS-Term timeout
+		 * 3. TBTT=0 event
+		 */
+		hostapd_drv_sta_disassoc(hapd, bcast_mac, WLAN_REASON_DEAUTH_LEAVING);
+		hapd->mlo_link->reconfig_remove.disassoc_done = 1;
+	}
+
+	if (hapd->mlo_link->reconfig_remove.bss_term_timeout)
+		/*
+		 * If BSS was not terminated (stop-ap) but BSS-Term
+		 * timeout has happened, send the stop-ap to driver now
+		 * This happens in the following cases
+		 * hapd->mlo_link being not NULL implies that
+		 * the link was not removed from the MLD, i.e.,
+		 * BSS termination of this link was not done
+		 *
+		 * or SCENARIO-3
+		 * 1. Disassoc timeout
+		 * 2. BSS-Term timeout
+		 * 3. TBTT=0 event
+		 */
+		hostapd_disable_iface_reconfig(hapd->iface);
+}
+
+static void hostapd_reconfig_remove_tbtt_update(struct hostapd_data *hapd,
+		uint64_t tsf, uint16_t bcn_interval, uint16_t tbtt)
+{
+	if (!hapd->mlo_link)
+		return;
+
+	if (tbtt)
+		hostapd_reconfig_remove_tbtt_first(hapd, tbtt, bcn_interval,
+						   tsf);
+	else
+		hostapd_reconfig_remove_tbtt_last(hapd);
+}
