+static int get_deploy_type_6ghz_handler(struct nl_msg *msg, void *arg)
+{
+	struct wpa_driver_nl80211_data *drv;
+	struct nlattr *tb[NL80211_ATTR_MAX + 1];
+	struct genlmsghdr *genlh = nlmsg_data(nlmsg_hdr(msg));
+	struct nlattr *tb_vendor[QCA_WLAN_VENDOR_ATTR_MAX + 1], *nl_vendor;
+	union wpa_event_data event;
+
+	drv = (struct wpa_driver_nl80211_data *)arg;
+	if (!drv)
+		return NL_SKIP;
+
+	nla_parse(tb, NL80211_ATTR_MAX,  genlmsg_attrdata(genlh, 0),
+		  genlmsg_attrlen(genlh, 0), NULL);
+
+	if (!tb[NL80211_ATTR_VENDOR_DATA])
+		return NL_SKIP;
+	nl_vendor = tb[NL80211_ATTR_VENDOR_DATA];
+
+	nla_parse(tb_vendor, QCA_WLAN_VENDOR_ATTR_MAX, nla_data(nl_vendor),
+		  nla_len(nl_vendor), NULL);
+
+	if (!tb_vendor[QCA_WLAN_VENDOR_ATTR_PARAM_DATA])
+		return NL_SKIP;
+
+	event.deploy_type.type =
+	nla_get_u32(tb_vendor[QCA_WLAN_VENDOR_ATTR_PARAM_DATA]);
+	wpa_printf(MSG_DEBUG, "nl80211: Driver deployment type for 6 GHz=%u",
+		   event.deploy_type.type);
+	wpa_supplicant_event(drv->ctx, EVENT_DEPLOY_TYPE, &event);
+
+	return NL_SKIP;
+}
+
+static int driver_nl80211_get_deploy_type_6ghz(void *priv)
+{
+	struct wpa_driver_nl80211_data *drv = ((struct i802_bss *)priv)->drv;
+	int ret = -ENOBUFS;
+	struct nl_msg *msg;
+
+	if (!(msg = nl80211_drv_msg(drv, 0, NL80211_CMD_VENDOR)) ||
+	    nla_put_u32(msg, NL80211_ATTR_VENDOR_ID, OUI_QCA) ||
+	    nla_put_u32(msg, NL80211_ATTR_VENDOR_SUBCMD,
+			QCA_NL80211_VENDOR_SUBCMD_GET_DEV_DEPLOYMENT_TYPE)) {
+		nlmsg_free(msg);
+		goto exit;
+	}
+
+	ret = send_and_recv_msgs(drv, msg, get_deploy_type_6ghz_handler,
+				 drv, NULL, NULL);
+	if (ret)
+		wpa_printf(MSG_DEBUG,
+			   "nl80211: Failed to get deployment type: %s",
+			   strerror(-ret));
+
+exit:
+	return ret;
+}
