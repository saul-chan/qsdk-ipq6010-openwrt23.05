+static int check_mld_addr_sa_query(struct hostapd_data *hapd,
+				    u8 *sta_mld_addr)
+{
+	struct hostapd_data *hapd_ptr;
+	int i;
+	struct sta_info *sta_mld;
+
+	for (i=0; i < hapd->iface->interfaces->count; i++) {
+
+		hapd_ptr = hapd->iface->interfaces->iface[i]->bss[0];
+
+		if (!hapd_ptr)
+			continue;
+
+		sta_mld = ap_get_sta(hapd_ptr, sta_mld_addr);
+		if (!sta_mld)
+			continue;
+
+		if (check_sa_query(hapd_ptr, sta_mld, 0)) {
+			wpa_printf(MSG_ERROR,
+				   "ERROR!! AP already having STA entry in %s which has link addr is "
+				   "same as MLD MAC " MACSTR " of currently associating STA\n",
+				   hapd_ptr->conf->iface, MAC2STR(sta_mld_addr));
+			return WLAN_STATUS_ASSOC_REJECTED_TEMPORARILY;
+		} else if ((sta_mld->flags & WLAN_STA_AUTHORIZED) &&
+			   (sta_mld->auth_alg != WLAN_AUTH_FT)) {
+			wpa_printf(MSG_ERROR,
+				   "ERROR!! AP already having STA entry in %s which has link addr is "
+				   "same as MLD MAC " MACSTR " of currently associating STA\n",
+				   hapd_ptr->conf->iface, MAC2STR(sta_mld_addr));
+			ap_sta_disconnect(hapd_ptr, sta_mld, sta_mld_addr,
+					  WLAN_REASON_UNSPECIFIED);
+			return WLAN_STATUS_UNSPECIFIED_FAILURE;
+		}
+	}
+	return 0;
+}
