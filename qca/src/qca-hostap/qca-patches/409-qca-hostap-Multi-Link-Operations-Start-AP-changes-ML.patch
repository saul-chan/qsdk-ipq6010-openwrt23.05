--- a/src/ap/ieee802_11_shared.c
+++ b/src/ap/ieee802_11_shared.c
@@ -824,6 +824,150 @@ u8 hostapd_mbo_ie_len(struct hostapd_data *hapd)
 
 #endif /* CONFIG_MBO */
 
+#ifdef CONFIG_MLO
+size_t hostapd_eid_basic_mle_len(struct hostapd_data *hapd)
+{
+	struct link_info *link;
+	struct mld_device_info *mld;
+	int num_partner_links = 0;
+
+	if (!hapd->mlo_link)
+		return 0;
+
+	mld = hapd->mlo_link->mld;
+	if (!mld)
+		return 0;
+
+	dl_list_for_each (link, &mld->links, struct link_info, list) {
+		if (link == hapd->mlo_link)
+			continue;
+
+		num_partner_links++;
+	}
+
+	if (!num_partner_links)
+		return 0;
+
+	return (3/*EL/LEN/EXT*/ + MULTI_LINK_CONTROL_BYTES +
+		ETH_ALEN /*mld-mac*/ +
+		1/*Tx-AP-LInk-id*/ +
+		(num_partner_links * (1/*SUB-ELEM*/+
+				      1/*LEN*/+
+				      MULTI_LINK_PER_STA_CONTROL_BYTES +
+				      ETH_ALEN)));
+}
+
+u8 * hostapd_eid_basic_mle(struct hostapd_data *hapd, u8 *eid, size_t len)
+{
+	struct link_info *link;
+	u8 *pos = eid;
+	struct mld_device_info *mld;
+	u8 *per_sta_sub_elen_ptr;
+	u8 *elen_ptr;
+	u8 *per_sta_body_ptr;
+	u8 *mlo_ie_body_ptr;
+
+	if (!hapd->mlo_link)
+		return pos;
+
+	if (!hapd->mlo_link->mld)
+		return pos;
+
+	/*
+	 * Check for enough bytes for element-id(1 byte)
+	 * 			      len(1 byte) and
+	 * 			      extension-id (1 byte)
+	 * 			      = 3 bytes
+	 */
+	if (len < 3) {
+		wpa_printf(MSG_DEBUG,
+			   "MLO: Not enough room in the buffer for Multi-Link IE");
+		return pos;
+	}
+
+	*pos++ = WLAN_EID_EXTENSION;
+	len--;
+	elen_ptr = pos;
+	pos++;
+	len--;
+	mlo_ie_body_ptr = pos;
+	*pos++ = WLAN_EID_EXT_MULTI_LINK;
+	len--;
+	if (len < MULTI_LINK_CONTROL_BYTES) {
+		wpa_printf(MSG_ERROR, "ERROR!! No room %d\n", __LINE__);
+	}
+	//Common info control field
+	os_memset(pos, 0, MULTI_LINK_CONTROL_BYTES);
+	*pos |= MULTI_LINK_CONTROL_TYPE_BASIC &
+		MULTI_LINK_CONTROL_TYPE_BITMASK_MASK;
+	*pos |= ((1 & MULTI_LINK_CONTROL_MLD_MAC_BITMASK_MASK) <<
+		  MULTI_LINK_CONTROL_MLD_MAC_BITMASK_SHIFT);
+	*pos |= ((1 & MULTI_LINK_CONTROL_TX_AP_LINK_BITMASK_MASK) <<
+		 MULTI_LINK_CONTROL_TX_AP_LINK_BITMASK_SHIFT);
+	pos += MULTI_LINK_CONTROL_BYTES;
+	len -= MULTI_LINK_CONTROL_BYTES;
+
+	/*
+	 * Check for enough bytes to cover
+	 * MAC Address (6 bytes)
+	 * Link ID (1 byte)
+	 * Total = 7 bytes
+	 */
+	if (len < 7) {
+		wpa_printf(MSG_ERROR, "ERROR!! No room %d\n", __LINE__);
+		return pos;
+	}
+
+	// Common info fields
+	os_memcpy(pos, hapd->conf->mld_mac_addr, ETH_ALEN); //MLD Addr
+	pos += ETH_ALEN;
+	len -= ETH_ALEN;
+	*pos++ = (u8) (0x0F & hapd->mlo_link->link_id); // Self link id
+	len -= 1;
+
+	mld = hapd->mlo_link->mld;
+	dl_list_for_each (link, &mld->links, struct link_info, list) {
+		if (hapd->mlo_link == link)
+			continue;
+
+		/*
+		 * Check for enough bytes to cover for
+		 * Sub-element-id (1 byte)
+		 * Sub-element length (1 byte) (Total = 2 bytes)
+		 * Per-sta-control header
+		 * Per-sta Link MAC address
+		 */
+		if (len < (2 + MULTI_LINK_PER_STA_CONTROL_BYTES + ETH_ALEN)) {
+			wpa_printf(MSG_ERROR, "ERROR!! No room %d\n", __LINE__);
+			return pos;
+		}
+		*pos++ = 0x0; // Per STA profile sub element ID
+		per_sta_sub_elen_ptr = pos;
+		pos++;
+		per_sta_body_ptr = pos;
+		os_memset(pos, 0, MULTI_LINK_PER_STA_CONTROL_BYTES);
+		*pos = link->link_id & MULTI_LINK_PER_STA_LINK_ID_BITMASK_MASK;
+		*pos |= ((0 & MULTI_LINK_PER_STA_COMPLETE_BITMASK_MASK)<<
+			 MULTI_LINK_PER_STA_COMPLETE_BITMASK_SHIFT);
+		pos++;
+		*pos |= (1 & MULTI_LINK_PER_STA_MACADDR_BITMASK_MASK);
+		pos++;
+		/* MAC Address of Link */
+		memcpy(pos, link->hapd->own_addr, 6);
+		pos += 6;
+		/*
+		 * Fill the sub-element length
+		 */
+		*per_sta_sub_elen_ptr = (pos - per_sta_body_ptr);
+	}
+
+	/*
+	 * Fill the element length
+	 */
+	*elen_ptr = (pos - mlo_ie_body_ptr);
+	return pos;
+}
+#endif
 
