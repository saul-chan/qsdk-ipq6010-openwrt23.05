+};
+
+/* Per-STA Control 1st Byte */
+#define MULTI_LINK_PER_STA_CONTROL_BYTES 2
+#define MULTI_LINK_PER_STA_LINK_ID_BITMASK_MASK 0xf
+#define MULTI_LINK_PER_STA_LINK_ID_BITMASK_SHIFT 0
+#define MULTI_LINK_PER_STA_COMPLETE_BITMASK_MASK 0x1
+#define MULTI_LINK_PER_STA_COMPLETE_BITMASK_SHIFT 4
+#define MULTI_LINK_PER_STA_MACADDR_BITMASK_MASK 0x1
+#define MULTI_LINK_PER_STA_MACADDR_BITMASK_SHIFT 5
+#define MULTI_LINK_PER_STA_BINTVAL_BITMASK_MASK 0x1
+#define MULTI_LINK_PER_STA_BINTVAL_BITMASK_SHIFT 6
+#define MULTI_LINK_PER_STA_DTIM_BITMASK_MASK 0x1
+#define MULTI_LINK_PER_STA_DTIM_BITMASK_SHIFT 7
+
+/* Per-STA Control 2nd byte */
+#define MULTI_LINK_PER_STA_NSTR_LINK_BITMASK_MASK 0x1
+#define MULTI_LINK_PER_STA_NSTR_LINK_BITMASK_SHIFT 0
+#define MULTI_LINK_PER_STA_NSTR_MAP_BITMASK_MASK 0x1
+#define MULTI_LINK_PER_STA_NSTR_MAP_BITMASK_SHIFT 1
+
+struct ieee80211_ml_per_sta_control {
+	unsigned int link_id:4;
+	unsigned int complete:1;
+	unsigned int nstr_link_pair_present:1;
+	unsigned int nstr_bitmap_size:1;
