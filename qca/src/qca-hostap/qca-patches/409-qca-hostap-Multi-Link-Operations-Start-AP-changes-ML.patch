+#ifdef CONFIG_MLO
+static void hostapd_remove_mlo_partner_link(struct hostapd_data *hapd)
+{
+	struct link_info *link = hapd->mlo_link;
+	struct mld_device_info *mld;
+
+	if (!link)
+		return;
+
+	mld = link->mld;
+	mld->used_link_ids &= ~BIT(link->link_id);
+	dl_list_del(&link->list);
+	link->hapd = NULL;
+	link->mld = NULL;
+	os_free(link);
+
+	if (mld->used_link_ids == 0) {
+		dl_list_del(&mld->list);
+		os_free(mld);
+	}
+
+	hapd->mlo_link = NULL;
+}
+
+
+static int hostpad_find_mlo_link_id(struct hostapd_data *hapd)
+{
+	int cnt;
+
+	if (hapd->conf->mld_link_mac_list.num_links != hapd->conf->mld_link_id_list.num_links) {
+		wpa_printf(MSG_ERROR, "%s ERROR!! Number of MAC addresses and links are different\n", __func__);
+		return -1;
+	}
+
+	for(cnt=0; cnt < hapd->conf->mld_link_mac_list.num_links; cnt++)
+	{
+		if (os_memcmp(hapd->conf->mld_link_mac_list.addr[cnt], hapd->own_addr, ETH_ALEN) == 0)
+			return hapd->conf->mld_link_id_list.link_id[cnt];
+	}
+	wpa_printf(MSG_ERROR, "%s ERROR!! Unable to find link_id\n", __func__);
+	return -1;
+}
+
+int hostapd_update_mld_links(struct hostapd_data *hapd)
+{
+	struct hapd_interfaces *interfaces = hapd->iface->interfaces;
+	struct link_info *link;
+	struct mld_device_info *mld;
+	int mld_found;
+
+	if (!interfaces || !hapd->conf ||
+	    is_zero_ether_addr(hapd->conf->mld_mac_addr))
+		return 0;
+
+	if (hapd->mlo_link)
+		return 0;
+
+	mld_found = 0;
+	dl_list_for_each(mld, &interfaces->mlds, struct mld_device_info, list) {
+		if (os_memcmp(mld->mld_mac_addr, hapd->conf->mld_mac_addr,
+			      ETH_ALEN) == 0) {
+			mld_found = 1;
+			break;
+		}
+	}
+
+	if (!mld_found) {
+		mld = os_zalloc(sizeof(struct mld_device_info));
+		if (!mld)
+			return -1;
+
+		os_memcpy(mld->mld_mac_addr, hapd->conf->mld_mac_addr,
+			   ETH_ALEN);
+		dl_list_add(&interfaces->mlds, &mld->list);
+		dl_list_init(&mld->links);
+	}
+
+
+	link = os_zalloc(sizeof(struct link_info));
+	if (!link) {
+		if (!mld_found) {
+			dl_list_del(&mld->list);
+			os_free(mld);
+		}
+		return -1;
+	}
+
+	link->link_id = hostpad_find_mlo_link_id(hapd);
+	wpa_printf(MSG_DEBUG, "Link ID INFO: MLO:" MACSTR " %s:%d\n",
+		   MAC2STR(mld->mld_mac_addr), hapd->conf->iface, link->link_id);
+	link->hapd = hapd;
+	link->mld = mld;
+	dl_list_add(&mld->links, &link->list);
+	mld->used_link_ids |= BIT(link->link_id);
+	hapd->mlo_link = link;
+	return 0;
+}
+
+
+static int hostapd_mlo_iface_iter(struct hostapd_iface *iface, void *ctx)
+{
+	struct hostapd_data *hapd = ctx;
+	size_t i;
+
+	if (iface == hapd->iface ||
+	    iface->state != HAPD_IFACE_ENABLED)
+		return 0;
+
+	for (i = 0; i < iface->num_bss; i++) {
+		struct hostapd_data *bss = iface->bss[i];
+
+		if (os_memcmp(hapd->conf->mld_mac_addr,
+			      bss->conf->mld_mac_addr, ETH_ALEN) != 0)
+			continue;
+
+		if (bss->started == 0) {
+			wpa_printf(MSG_ERROR,
+				   "EHT: BSS interface %s not started - defer beacon update",
+				   bss->conf->iface);
+			continue;
+		}
+
+		wpa_printf(MSG_DEBUG,
+			   "EHT: Partner link info changed - update beacon data for %s",
+			   bss->conf->iface);
+		ieee802_11_set_beacon(bss);
+	}
+
+	return 0;
+}
+
+
+static void hostapd_mlo_update_partner_link_beacons(struct hostapd_data *hapd)
+{
+	struct hostapd_iface *iface = hapd->iface;
+
+	if (!hapd->mlo_link)
+		return;
+
+	if (!iface || !iface->interfaces ||
+	    !iface->interfaces->for_each_interface)
+		return;
+
+	iface->interfaces->for_each_interface(iface->interfaces,
+					      hostapd_mlo_iface_iter, hapd);
+}
+
+#endif
