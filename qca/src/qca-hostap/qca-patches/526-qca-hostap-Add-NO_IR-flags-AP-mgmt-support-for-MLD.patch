 	hostapd_cleanup_iface_partial(bss->iface);
 }
 
+#ifdef CONFIG_MLO
+void hostapd_no_ir_mlo_add_link_and_update_partners(struct hostapd_iface *iface,
+                                                    struct hostapd_data *hapd)
+{
+	hostapd_for_each_interface(iface->interfaces,
+                                   hostapd_no_ir_mlo_link_add,
+                                   hapd);
+	hostapd_mlo_update_partner_link_beacons(hapd);
+}
+
+
+static int hostapd_no_ir_mlo_link_add(struct hostapd_iface *iface, void *ctx)
+{
+        struct hostapd_data *hapd = ctx;
+        int ret = -1;
+        int i;
+
+        wpa_printf(MSG_DEBUG, "NO_IR: Attempting Link Addition for ctx=%s iface=%s",
+                   hapd->conf->iface, iface->bss[0]->conf->iface);
+
+        for(i = 0; i < iface->num_bss; i++) {
+                struct hostapd_data *bss = iface->bss[i];
+                int cnt;
+
+                if (bss->conf->mld_link_mac_list.num_links !=
+                    bss->conf->mld_link_id_list.num_links) {
+                        wpa_printf(MSG_ERROR,
+                                   "NO_IR: Link MAC and Link ID list length not matching for %s",
+                                   bss->conf->iface);
+                        goto out;
+                }
+                cnt = bss->conf->mld_link_mac_list.num_links - 1;
+
+                if ((bss == hapd) ||
+                    os_memcmp(hapd->conf->mld_mac_addr,
+                              bss->conf->mld_mac_addr, ETH_ALEN))
+                        continue;
+                hostapd_drv_stop_ap(bss);
+
+                if (!os_memcmp(bss->conf->mld_link_mac_list.addr[cnt+1],
+                                        hapd->own_addr, ETH_ALEN)) {
+                        bss->conf->mld_link_mac_list.num_links++;
+                        bss->conf->mld_link_id_list.num_links++;
+                }
+        }
+        ret = 0;
+
+out:
+        return ret;
+}
+
+static int hostapd_no_ir_mlo_link_remove(struct hostapd_iface *iface, void *ctx)
+{
+       struct hostapd_data *hapd = ctx;
+       int ret = -1;
+       int i;
+
+       wpa_printf(MSG_DEBUG, "NO_IR: Attempting Link Removal for ctx=%s iface=%s", hapd->conf->iface, iface->bss[0]->conf->iface);
+       for(i = 0; i < iface->num_bss; i++) {
+               struct hostapd_data *bss = iface->bss[i];
+               int cnt;
+
+               if (bss->conf->mld_link_mac_list.num_links !=
+                   bss->conf->mld_link_id_list.num_links) {
+                       wpa_printf(MSG_ERROR,
+                                  "NO_IR: Link MAC and Link ID list length not matching for %s",
+                                  bss->conf->iface);
+                       goto out;
+               }
+               cnt = bss->conf->mld_link_mac_list.num_links - 1;
+
+               if (os_memcmp(hapd->conf->mld_mac_addr,
+                             bss->conf->mld_mac_addr, ETH_ALEN))
+                       continue;
+
+               if (bss->beacon_set_done)
+                       hostapd_drv_stop_ap(bss);
+
+               if (!os_memcmp(bss->conf->mld_link_mac_list.addr[cnt],
+                              hapd->own_addr, ETH_ALEN)) {
+                       bss->conf->mld_link_mac_list.num_links--;
+                       bss->conf->mld_link_id_list.num_links--;
+               }
+       }
+       ret = 0;
+
+out:
+       return ret;
+}
+
+static int hostapd_no_ir_mlo_setup_link_remove(struct hostapd_iface *iface, void *ctx)
+{
+       struct hostapd_data *hapd = ctx;
+       int ret = -1;
+       int i;
+
+       for(i = 0; i < iface->num_bss; i++) {
+               struct hostapd_data *bss = iface->bss[i];
+               int num_links;
+
+               if ((bss == hapd) ||
+                   os_memcmp(hapd->conf->mld_mac_addr,
+                             bss->conf->mld_mac_addr, ETH_ALEN))
+                       continue;
+
+               if (hapd->conf->mld_link_mac_list.num_links !=
+                   hapd->conf->mld_link_id_list.num_links)
+                       goto out;
+               num_links = hapd->conf->mld_link_id_list.num_links - 1;
+
+               if (bss->iface->state == HAPD_IFACE_NO_IR &&
+                   !os_memcmp(hapd->conf->mld_link_mac_list.addr[num_links],
+                              bss->own_addr, ETH_ALEN)) {
+                       wpa_printf(MSG_DEBUG,
+                                  "NO_IR: 6 GHz Partner (%s) found in state "
+                                  "HAPD_IFACE_NO_IR. Remove info from MLD",
+                                  bss->conf->iface);
+                       hapd->conf->mld_link_mac_list.num_links--;
+                       hapd->conf->mld_link_id_list.num_links--;
+                       ret = 1;
+                       goto out;
+               }
+       }
+       ret = 0;
+
+out:
+       return ret;
+}
+
+static int hostapd_no_ir_mlo_stop_ap(struct hostapd_iface *iface, void *ctx)
+{
+        struct hostapd_data *hapd = ctx;
+        int i;
+
+        if (!hapd || iface == hapd->iface)
+                return 0;
+
+        for (i = 0; i < iface->num_bss; i++) {
+                if (os_memcmp(hapd->conf->mld_mac_addr,
+                              iface->bss[i]->conf->mld_mac_addr, ETH_ALEN))
+                        continue;
+                hostapd_drv_stop_ap(iface->bss[0]);
+        }
+
+        return 0;
+}
