+bool is_same_phy(struct hostapd_data *hapd1, struct hostapd_data *hapd2)
+{
+        const char *phy1, *phy2;
+
+        phy1 = hostapd_drv_get_radio_name(hapd1);
+        phy2 = hostapd_drv_get_radio_name(hapd2);
+
+        if (phy1 && phy2 &&
+            os_strcmp(phy1, phy2) == 0) {
+                return true;
+        }
+        return false;
+}
+
+bool is_radio_first_sta(struct hostapd_iface *iface, void *data)
+{
+	if (iface->bss[0]->wpa_auth->group->first_sta_seen)
+		return false;
+
+	return true;
+}
+
+bool set_bigtk_gen(struct hostapd_iface *iface, void *data)
+{
 
+	iface->bigtk_gen_done =  *((bool * )data);
+	return false;
+}
+
+int iter_iface_same_radio(struct hostapd_iface *iface, bool (*cb)(struct hostapd_iface *iface, void *data), void *data, bool check)
+{
+	int i, ret;
+
+	for (i = 0; i < iface->interfaces->count; i++)
+	{
+		if (iface == iface->interfaces->iface[i])
+			continue;
+
+		/*Ignore open vaps*/
+		if (!iface->interfaces->iface[i]->bss[0]->wpa_auth)
+			continue;
+		if (!is_same_phy(iface->bss[0], iface->interfaces->iface[i]->bss[0]))
+			continue;
+		ret = cb(iface->interfaces->iface[i], data);
+
+		if (check && !ret)
+			return false;
+	}
+
+	return true;
+}
