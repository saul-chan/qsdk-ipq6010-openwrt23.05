+static void wpa_mlo_link_supp_port(struct wpa_sm *sm,
+				   int auth)
+{
+	struct wpa_supplicant *wpa_s = ( struct wpa_supplicant *)sm->ctx->ctx;
+	struct wpa_global *global = wpa_s->global;
+	struct wpa_supplicant *local_wpa_s = global->ifaces;
+
+	wpa_for_each_mlo_link(local_wpa_s, global) {
+		if(wpa_partner_mlo_link(wpa_s , local_wpa_s)) {
+			if(local_wpa_s != wpa_s) {
+				//eapol_sm_notify_portValid(local_wpa_s->wpa->eapol, true);
+				wpa_dbg(local_wpa_s, MSG_INFO, "ML_STA: Authorize Link WDEV");
+				wpa_drv_set_supp_port(local_wpa_s, auth);
+			}
+		}
+	}
+
+	return ;
+}
