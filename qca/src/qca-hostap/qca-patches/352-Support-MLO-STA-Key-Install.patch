+static int wpa_mlo_link_gtk(struct wpa_sm *sm,
+			    const struct wpa_eapol_key *key,
+			    struct wpa_eapol_ie_parse *ie,
+			    int key_info)
+{
+	struct wpa_supplicant *wpa_s = ( struct wpa_supplicant *)sm->ctx->msg_ctx;
+	struct wpa_global *global = wpa_s->global;
+	struct wpa_supplicant *local_wpa_s = global->ifaces;
+	int ret = 0, link_id = 0;
+
+	wpa_for_each_mlo_link(local_wpa_s, global) {
+		if(wpa_partner_mlo_link(wpa_s , local_wpa_s)) {
+			link_id = local_wpa_s->link_id;
+			local_wpa_s->wpa->group_cipher = sm->group_cipher;
+			local_wpa_s->wpa->pairwise_cipher = sm->pairwise_cipher;
+			local_wpa_s->wpa->wpa_rsc_relaxation = sm->wpa_rsc_relaxation;
+			if( wpa_mlo_link_pairwise_gtk(local_wpa_s->wpa, key, ie->mlo_gtk[link_id], ie->mlo_gtk_len[link_id], key_info) < 0) {
+				ret = -1;
+			}
+		}
+	}
+
+	return ret;
+}
