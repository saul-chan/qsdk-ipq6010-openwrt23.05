+static int wpa_mlo_link_pairwise_gtk(struct wpa_sm *sm,
+				     const struct wpa_eapol_key *key,
+				     const u8 *mlo_gtk, size_t mlo_gtk_len,
+				     int key_info)
+{
+	struct wpa_gtk_data gd;
+	u8 key_rsc[6];
+
+	os_memset(&gd, 0, sizeof(gd));
+
+	if (mlo_gtk_len < 2 || mlo_gtk_len - 2 > sizeof(gd.gtk))
+		return -1;
+
+	gd.keyidx = mlo_gtk[0] & 0x3;
+	gd.tx = wpa_supplicant_gtk_tx_bit_workaround(sm,!!(mlo_gtk[0] & BIT(2)));
+
+	os_memcpy(key_rsc, mlo_gtk+1, 6);
+
+	/* Keyix(2bits)+Tx(1bit)+Reserved(1bit)+link_id(4bits)+PN(6Bytes) */
+	mlo_gtk +=(1+6);
+	mlo_gtk_len -=(1+6);
+
+	os_memcpy(gd.gtk, mlo_gtk, mlo_gtk_len);
+	gd.gtk_len = mlo_gtk_len;
+
+	wpa_dbg(sm->ctx->msg_ctx, MSG_DEBUG, "ML_STA: MLO Link WDEV GTK Install");
+	if (sm->group_cipher != WPA_CIPHER_GTK_NOT_USED &&
+	    (wpa_supplicant_check_group_cipher(sm, sm->group_cipher,
+					       mlo_gtk_len, mlo_gtk_len,
+					       &gd.key_rsc_len, &gd.alg) ||
+	     wpa_supplicant_install_gtk(sm, &gd, key_rsc, 0))) {
+		wpa_dbg(sm->ctx->msg_ctx, MSG_DEBUG,
+			"ML_STA: Failed to install MLO Link GTK");
+		forced_memzero(&gd, sizeof(gd));
+		return -1;
+	}
+	wpa_dbg(sm->ctx->msg_ctx, MSG_DEBUG, "ML_STA: MLO Link WDEV GTK Install Complete");
+
+	forced_memzero(&gd, sizeof(gd));
+
+	return 0;
+}
+
