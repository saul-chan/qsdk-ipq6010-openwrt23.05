+int wpa_mlo_link_install_ptk(struct wpa_sm *sm,
+			     const struct wpa_eapol_key *key,
+			     enum key_flag key_flag,
+			     struct wpa_ptk *mlo_ptk)
+{
+	struct wpa_supplicant *wpa_s = ( struct wpa_supplicant *)sm->ctx->ctx;
+	struct wpa_global *global = wpa_s->global;
+	struct wpa_supplicant *local_wpa_s = global->ifaces;
+	int ret =0 ;
+
+	wpa_for_each_mlo_link(local_wpa_s, global) {
+		if(wpa_partner_mlo_link(wpa_s , local_wpa_s)) {
+			local_wpa_s->wpa->pairwise_cipher = sm->pairwise_cipher;
+			local_wpa_s->wpa->keyidx_active = sm->keyidx_active;
+			local_wpa_s->wpa->use_ext_key_id = sm->use_ext_key_id;
+
+			/* Copy the PMK from Assoc WDEV to MLO_Link WDEV SM's */
+			local_wpa_s->wpa->pmk_len = sm->pmk_len;
+			os_memcpy(local_wpa_s->wpa->pmk, sm->pmk, sm->pmk_len);
+
+			/* Copy the PTK from Assoc WDEV to MLO_Link WDEV SM's */
+			local_wpa_s->wpa->ptk.kck_len = mlo_ptk->kck_len;
+			local_wpa_s->wpa->ptk.kek_len = mlo_ptk->kek_len;
+			local_wpa_s->wpa->ptk.tk_len = mlo_ptk->tk_len;
+			local_wpa_s->wpa->ptk.kck2_len = mlo_ptk->kck2_len;
+			local_wpa_s->wpa->ptk.kek2_len = mlo_ptk->kek2_len;
+			local_wpa_s->wpa->ptk.installed = mlo_ptk->installed;
+
+			os_memcpy(local_wpa_s->wpa->ptk.kck, mlo_ptk->kck, mlo_ptk->kck_len);
+			os_memcpy(local_wpa_s->wpa->ptk.kek, mlo_ptk->kek, mlo_ptk->kek_len);
+			os_memcpy(local_wpa_s->wpa->ptk.kck2, mlo_ptk->kck2, mlo_ptk->kck2_len);
+			os_memcpy(local_wpa_s->wpa->ptk.kek2, mlo_ptk->kek2, mlo_ptk->kek2_len);
+			os_memcpy(local_wpa_s->wpa->ptk.tk, mlo_ptk->tk, mlo_ptk->tk_len);
+
+			os_memcpy(local_wpa_s->wpa->bssid, local_wpa_s->bssid, sizeof(sm->bssid));
+
+			wpa_dbg(sm->ctx->msg_ctx, MSG_INFO, "ML_STA: Installing Link WDEV PTK \n");
+			wpa_hexdump_key(MSG_DEBUG, "ML_STA: KEY_DATA", local_wpa_s->wpa->ptk.tk, local_wpa_s->wpa->ptk.tk_len);
+			if( wpa_supplicant_install_ptk(local_wpa_s->wpa, key, KEY_FLAG_RX_TX))
+				ret = -1;
+		}
+	}
+	return ret;
+}
