+
+				mlo_bigtk = (const struct wpa_mlo_bigtk_kde *) ie->mlo_bigtk[local_wpa_s->link_id];
+				os_memcpy(bigtk.keyid, mlo_bigtk->keyid, 2);
+				os_memcpy(bigtk.pn, mlo_bigtk->pn, sizeof(mlo_bigtk->pn));
+				os_memcpy(bigtk.bigtk, mlo_bigtk->mlo_bigtk, sizeof(mlo_bigtk->mlo_bigtk));
+
+				wpa_msg(local_wpa_s, MSG_DEBUG, "ML_STA: Install Partner BIGTK");
+				if (wpa_supplicant_install_bigtk(local_wpa_s->wpa, &bigtk, 0) < 0)
+					ret = -1;
+			}
+
+		}
+	}
+	return ret;
+}
