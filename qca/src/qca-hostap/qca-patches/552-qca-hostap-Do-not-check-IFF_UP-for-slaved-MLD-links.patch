diff --git a/src/drivers/linux_ioctl.c b/src/drivers/linux_ioctl.c
index 7edb9df..e56224b 100644
--- a/src/drivers/linux_ioctl.c
+++ b/src/drivers/linux_ioctl.c
@@ -16,6 +16,27 @@
 #include "linux_ioctl.h"
 
 
+int linux_iface_slave(int sock, const char *ifname)
+{
+	struct ifreq ifr;
+	int ret;
+
+	if (sock < 0)
+		return 0;
+
+	os_memset(&ifr, 0, sizeof(ifr));
+	os_strlcpy(ifr.ifr_name, ifname, IFNAMSIZ);
+
+	if (ioctl(sock, SIOCGIFFLAGS, &ifr) != 0) {
+		ret = errno ? -errno : -999;
+		wpa_printf(MSG_ERROR, "Could not read interface %s flags: %s",
+			   ifname, strerror(errno));
+		return ret;
+	}
+
+	return !!(ifr.ifr_flags & IFF_SLAVE);
+}
+
 int linux_set_iface_flags(int sock, const char *ifname, int dev_up)
 {
 	struct ifreq ifr;
@@ -51,6 +72,7 @@ int linux_set_iface_flags(int sock, const char *ifname, int dev_up)
 			   ifname, dev_up ? "UP" : "DOWN", strerror(errno));
 		return ret;
 	}
+	wpa_printf(MSG_DEBUG, "Interface %s flags set (%s)", ifname, dev_up ? "UP" : "DOWN");
 
 	return 0;
 }
