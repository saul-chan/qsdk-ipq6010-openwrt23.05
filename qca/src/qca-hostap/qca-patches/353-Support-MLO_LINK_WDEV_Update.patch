diff --git a/src/drivers/driver_nl80211.c b/src/drivers/driver_nl80211.c
index 5a1e343..41ba756 100644
--- a/src/drivers/driver_nl80211.c
+++ b/src/drivers/driver_nl80211.c
@@ -11476,6 +11476,32 @@ static int get_wideband_support_handler(struct nl_msg *msg, void *arg)
 	return NL_SKIP;
 }
 
+#ifdef CONFIG_MLO
+static int nl80211_set_mlo_link_wdev(void *priv)
+{
+	struct i802_bss *bss = priv;
+	struct wpa_driver_nl80211_data *drv = bss->drv;
+	struct nl_msg *msg;
+        int ret = -ENOBUFS;
+
+	wpa_printf(MSG_DEBUG, "nl80211: ML_STA: Set mode iftype %d (%s)",
+		   NL80211_IFTYPE_MLO_LINK_DEVICE, nl80211_iftype_str(NL80211_IFTYPE_MLO_LINK_DEVICE));
+
+	msg = nl80211_cmd_msg(drv->first_bss, 0, NL80211_CMD_SET_INTERFACE);
+	if (!msg || nla_put_u32(msg, NL80211_ATTR_IFTYPE, NL80211_IFTYPE_MLO_LINK_DEVICE))
+		goto fail;
+
+	ret = send_and_recv_msgs(drv, msg, NULL, NULL, NULL, NULL);
+	msg = NULL;
+
+	if (!ret)
+		return 0;
+fail:
+	nlmsg_free(msg);
+	return ret;
+}
+#endif /* CONFIG_MLO */
+
 
