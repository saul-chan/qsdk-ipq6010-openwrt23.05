+static int wpa_triger_rescan_to_find_cacndidate(struct wpa_supplicant
+						*wpa_s)
+{
+	int timeout_sec = wpa_s->scan_interval;
+	int timeout_usec = 0;
+#ifdef CONFIG_P2P
+	int res;
+	res = wpas_p2p_scan_no_go_seen(wpa_s);
+	if (res == 2)
+		return 2;
+	if (res == 1)
+		return 0;
+
+	if (wpa_s->p2p_in_provisioning ||
+	    wpa_s->show_group_started ||
+	    wpa_s->p2p_in_invitation) {
+		/*
+		 * Use shorter wait during P2P Provisioning
+		 * state and during P2P join-a-group operation
+		 * to speed up group formation.
+		 */
+		timeout_sec = 0;
+		timeout_usec = 250000;
+		wpa_supplicant_req_new_scan(wpa_s, timeout_sec,
+					    timeout_usec);
+		return 0;
+	}
+#endif /* CONFIG_P2P */
+#ifdef CONFIG_INTERWORKING
+	if (wpa_s->conf->auto_interworking &&
+	    wpa_s->conf->interworking &&
+	    wpa_s->conf->cred) {
+		wpa_dbg(wpa_s, MSG_DEBUG, "Interworking: "
+			"start ANQP fetch since no matching "
+			"networks found");
+		wpa_s->network_select = 1;
+		wpa_s->auto_network_select = 1;
+		interworking_start_fetch_anqp(wpa_s);
+		return 1;
+	}
+#endif /* CONFIG_INTERWORKING */
+#ifdef CONFIG_WPS
+	if (wpa_s->after_wps > 0 || wpas_wps_searching(wpa_s)) {
+		wpa_dbg(wpa_s, MSG_DEBUG, "Use shorter wait during WPS processing");
+		timeout_sec = 0;
+		timeout_usec = 500000;
+		wpa_supplicant_req_new_scan(wpa_s, timeout_sec,
+					    timeout_usec);
+		return 0;
+	}
+#endif /* CONFIG_WPS */
+#ifdef CONFIG_OWE
+	if (wpa_s->owe_transition_search) {
+		wpa_dbg(wpa_s, MSG_DEBUG,
+			"OWE: Use shorter wait during transition mode search");
+		timeout_sec = 0;
+		timeout_usec = 500000;
+		wpa_supplicant_req_new_scan(wpa_s, timeout_sec,
+					    timeout_usec);
+		return 0;
+	}
+#endif /* CONFIG_OWE */
+	if (wpa_supplicant_req_sched_scan(wpa_s))
+		wpa_supplicant_req_new_scan(wpa_s, timeout_sec,
+					    timeout_usec);
+	wpa_msg_ctrl(wpa_s, MSG_INFO,
+		     WPA_EVENT_NETWORK_NOT_FOUND);
+
+	return 0;
+}
