 		data.deauth_info.reason_code = nla_get_u16(reason);
 	data.deauth_info.locally_generated = by_ap == NULL;
+	data.deauth_info.link_id = NL80211_MLO_INVALID_LINK_ID;
 	wpa_supplicant_event(drv->ctx, EVENT_DEAUTH, &data);
 }
 
