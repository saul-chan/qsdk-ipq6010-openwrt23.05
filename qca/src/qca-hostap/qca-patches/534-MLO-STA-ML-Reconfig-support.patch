diff --git a/wpa_supplicant/events.c b/wpa_supplicant/events.c
index eb8ab68..387eb89 100644
--- a/wpa_supplicant/events.c
+++ b/wpa_supplicant/events.c
@@ -5500,6 +5500,29 @@ static void wpas_event_deauth(struct wpa_supplicant *wpa_s,
 		}
 		wpa_hexdump(MSG_DEBUG, "Deauthentication frame IE(s)",
 			    ie, ie_len);
+
+#ifdef CONFIG_MLO
+		if (info->link_id >= 0 && info->link_id <= 15
+		    && wpa_s->ml_connect) {
+			struct wpa_global *global = wpa_s->global;
+			struct wpa_supplicant *local_wpa_s = global->ifaces;
+			wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: Attempting ML-Reconfig Link Remove link_id = %d", info->link_id);
+
+			wpa_for_each_mlo_link(local_wpa_s, global) {
+
+				if (!wpa_is_mlo_link(wpa_s , local_wpa_s))
+					continue;
+
+				wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: local_wpa_link_id = %d", local_wpa_s->link_id);
+
+				if (local_wpa_s->link_id == info->link_id) {
+					local_wpa_s->active_ml_sta = false;
+					wpa_dbg(local_wpa_s, MSG_DEBUG, "ML_STA: Link Remove link-id=%d", info->link_id);
+					return;
+				}
+			}
+		}
+#endif
 	}
 
 	wpa_reset_ft_completed(wpa_s->wpa);
