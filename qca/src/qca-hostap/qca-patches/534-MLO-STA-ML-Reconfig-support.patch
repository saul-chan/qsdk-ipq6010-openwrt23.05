--- a/src/drivers/driver_nl80211_event.c
+++ b/src/drivers/driver_nl80211_event.c
@@ -1193,7 +1193,7 @@ static void mlme_event_connect(struct wpa_driver_nl80211_data *drv,
 
 static void mlme_event_disconnect(struct wpa_driver_nl80211_data *drv,
 				  struct nlattr *reason, struct nlattr *addr,
-				  struct nlattr *by_ap)
+				  struct nlattr *by_ap, struct nlattr *link_id)
 {
 	union wpa_event_data data;
 	unsigned int locally_generated = by_ap == NULL;
@@ -1220,12 +1220,31 @@ static void mlme_event_disconnect(struct wpa_driver_nl80211_data *drv,
 			   "event first");
 	}
 
+#ifdef CONFIG_MLO
+	if (link_id) {
+		u8 local_link_id = nla_get_u8(link_id);
+		if (local_link_id >= 0 && local_link_id <= 15) {
+			wpa_printf(MSG_DEBUG, "nl80211: Link Delete");
+			os_memset(&data, 0, sizeof(data));
+			if (reason)
+				data.deauth_info.reason_code = nla_get_u16(reason);
+			data.deauth_info.link_id = local_link_id;
+			data.deauth_info.locally_generated = by_ap == NULL;
+			wpa_supplicant_event(drv->ctx, EVENT_DEAUTH, &data);
+			return;
+		} else {
+			wpa_printf(MSG_DEBUG, "nl80211: Invalid Link-id in disconnect, Ignore");
+		}
+	}
+#endif
+
 	wpa_printf(MSG_DEBUG, "nl80211: Disconnect event");
 	nl80211_mark_disconnected(drv);
 	os_memset(&data, 0, sizeof(data));
