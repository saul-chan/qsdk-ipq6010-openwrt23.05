@@ -3432,6 +3432,19 @@ static u16 check_and_skip_buf(uint8_t **buf, uint8_t *length, uint8_t skip_len)
 	} \
 }
 
+static int compare_with_other_link_addresses(struct sta_info_ml *sta_ml,
+					     u8 *buf, int link_id)
+{
+	int cnt;
+	for (cnt=0; cnt<MAX_MLD_LINKS; cnt++) {
+		if (memcmp(sta_ml->partner_link_addr[cnt], buf, ETH_ALEN) == 0) {
+			wpa_printf(MSG_ERROR, "ERROR!! ML-IE partner link address duplicate %d %d\n", link_id, cnt);
+			return -1;
+		}
+	}
+	return 0;
+}
+
 static void parse_mlo_sta_profile(struct sta_info_ml *sta_ml,
 				  u8 *buf, size_t length, int is_assoc)
 {
@@ -3457,17 +3470,24 @@ static void parse_mlo_sta_profile(struct sta_info_ml *sta_ml,
 	control.mac_address_present =
 		((*buf) >> MULTI_LINK_PER_STA_MACADDR_BITMASK_SHIFT) &
 		           MULTI_LINK_PER_STA_MACADDR_BITMASK_MASK;
+	control.tsf_offset_present =
+		((*buf) >> MULTI_LINK_PER_STA_TSF_BITMASK_SHIFT) &
+			   MULTI_LINK_PER_STA_TSF_BITMASK_MASK;
+
+	buf++;
+	length--;
 	control.dtim_info_present =
 		((*buf) >> MULTI_LINK_PER_STA_DTIM_BITMASK_SHIFT) &
 			   MULTI_LINK_PER_STA_DTIM_BITMASK_MASK;
-	buf++;
-	length--;
 	control.nstr_link_pair_present =
 		((*buf) >> MULTI_LINK_PER_STA_NSTR_LINK_BITMASK_SHIFT) &
 			   MULTI_LINK_PER_STA_NSTR_LINK_BITMASK_MASK;
 	control.nstr_bitmap_size =
 		((*buf) >> MULTI_LINK_PER_STA_NSTR_MAP_BITMASK_SHIFT) &
 			   MULTI_LINK_PER_STA_NSTR_MAP_BITMASK_MASK;
+	control.bss_param_present =
+		((*buf) >> MULTI_LINK_PER_STA_BSS_PARAM_BITMASK_SHIFT) &
+			   MULTI_LINK_PER_STA_BSS_PARAM_BITMASK_MASK;
 	buf++;
 	length--;
 
@@ -3490,6 +3510,8 @@ static void parse_mlo_sta_profile(struct sta_info_ml *sta_ml,
 			return;
 		}
 
+		if (compare_with_other_link_addresses(sta_ml, buf, control.link_id))
+			return;
 		memcpy(sta_ml->partner_link_addr[control.link_id], buf, 6);
 		buf += 6;
 		sta_info_length -= 6;
@@ -3499,13 +3521,18 @@ static void parse_mlo_sta_profile(struct sta_info_ml *sta_ml,
 		return;
 	}
 
-	CHECK_AND_SKIP(control.beacon_interval_present, &buf, &sta_info_length, 1,
+	CHECK_AND_SKIP(control.beacon_interval_present, &buf, &sta_info_length, 2,
 			"PER_STA_BEACON_INTERVAL");
+	CHECK_AND_SKIP(control.tsf_offset_present, &buf, &sta_info_length, 8,
+			"PER_STA_TSF_OFFSET");
 	CHECK_AND_SKIP(control.dtim_info_present, &buf, &sta_info_length, 2,
 			"PER_STA_DTIM_INFO");
 	CHECK_AND_SKIP(control.nstr_link_pair_present, &buf, &sta_info_length,
 		       control.nstr_bitmap_size+1, /* 0 = 1 octet, 1 = 2 octets */
 		       "PER_STA_NTSR_LINK_PAIR_BITMAP");
+	CHECK_AND_SKIP(control.bss_param_present, &buf, &sta_info_length, 1,
+			"PER_STA_BSS_PARAM_CHANGE_COUNT");
+
 	if (sta_info_length != 0) {
 		wpa_printf(MSG_ERROR, "%s ERROR!! STA-INFO length mismatch\n",
 			   __func__);
@@ -3647,6 +3674,10 @@ void parse_ml_element(struct hostapd_data *hapd, struct sta_info *sta,
 	ml_control.u.basic.mld_cap_present =
 		((*buf) >> MULTI_LINK_CONTROL_MLD_CAP_BITMASK_SHIFT) &
 			   MULTI_LINK_CONTROL_MLD_CAP_BITMASK_MASK;
+	ml_control.u.basic.mld_id_present =
+		((*buf) >> MULTI_LINK_CONTROL_MLD_ID_BITMASK_SHIFT) &
+			   MULTI_LINK_CONTROL_MLD_ID_BITMASK_MASK;
+
 
 	buf++;
 	len--;
@@ -3706,6 +3737,8 @@ void parse_ml_element(struct hostapd_data *hapd, struct sta_info *sta,
 		       &buf, &common_info_length, 2, "MLO_EML_CAP_PRESENT");
 	CHECK_AND_SKIP(ml_control.u.basic.mld_cap_present,
 		       &buf, &common_info_length, 2, "MLO_MLD_CAP_PRESENT");
+	CHECK_AND_SKIP(ml_control.u.basic.mld_id_present,
+		       &buf, &common_info_length, 1, "MLO_MLD_ID_PRESENT");
 	if (common_info_length != 0) {
 		wpa_printf(MSG_ERROR, "%s: ERROR!! common-info byte length does not match the value on the ML-IE\n",
 				__func__);
