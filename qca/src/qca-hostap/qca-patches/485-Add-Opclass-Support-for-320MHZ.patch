+static int get_center_320mhz(struct hostapd_hw_modes *mode, u8 channel,
+			     int is6ghz)
+{
+	static const u8 *center_channels;
+	u8 num_channels;
+	unsigned int i;
+
+	if (is6ghz) {
+		center_channels = center_channels_320mhz_6G;
+		num_channels =  ARRAY_SIZE(center_channels_320mhz_6G);
+	} else {
+		center_channels = NULL;
+		num_channels = 0;
+	}
+
+	if (mode->mode != HOSTAPD_MODE_IEEE80211A)
+		return 0;
+
+	for (i = 0; i < num_channels; i++) {
+		/*
+		 * In 320 MHz, the bandwidth "spans" 60 channels (e.g., 33-93),
+		 * so the center channel is 30 channels away from the start/end.
+		 */
+		if (channel >= center_channels[i] - 30 &&
+		    channel <= center_channels[i] + 30)
+			return center_channels[i];
+	}
+
+	return 0;
+}
 
