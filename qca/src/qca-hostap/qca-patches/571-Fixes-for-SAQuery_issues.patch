+static bool check_sa_query_on_all_hapd_ptrs(struct hostapd_data *hapd,
+					    struct sta_info *sta, int reassoc)
+{
+	struct sta_info *temp_sta;
+	struct hostapd_data *hapd_ptr;
+	int i;
+
+	for (i=0; i < hapd->iface->interfaces->count; i++) {
+		hapd_ptr = hapd->iface->interfaces->iface[i]->bss[0];
+
+		if (!hapd_ptr)
+			continue;
+		temp_sta = ap_get_sta(hapd_ptr, sta->addr);
+
+		if (!temp_sta)
+			continue;
+
+		if (check_sa_query(hapd_ptr, temp_sta, reassoc)) {
+			wpa_printf(MSG_ERROR,
+				   "ERROR!! AP already having STA entry in %s "
+				   "which has link addr as " MACSTR " \n",
+				   hapd_ptr->conf->iface, MAC2STR(sta->addr));
+			temp_sta->mld_sa_query_osta = sta;
+			sta->mld_sa_query_osta = temp_sta;
+			return true;
+		}
+	}
+
+	return false;
+}
 
