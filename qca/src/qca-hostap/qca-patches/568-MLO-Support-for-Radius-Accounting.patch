+	hostapd_drv_sta_clear_stats(hapd, sta->ml ? sta->ml->addr : sta->addr);
+#else
 	hostapd_drv_sta_clear_stats(hapd, sta->addr);
+#endif
 
 	if (!hapd->conf->radius->acct_server)
