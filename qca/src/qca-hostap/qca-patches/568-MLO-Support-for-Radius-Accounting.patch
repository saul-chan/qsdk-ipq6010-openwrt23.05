 				       struct hostap_sta_driver_data *data)
 {
+#ifdef CONFIG_MLO
+	if (hostapd_drv_read_sta_data(hapd, data, sta->ml ? sta->ml->addr : sta->addr))
+#else
 	if (hostapd_drv_read_sta_data(hapd, data, sta->addr))
