+#ifdef CONFIG_MLO
+	    radius_client_send(hapd->radius, msg, RADIUS_ACCT, sta->ml ? sta->ml->addr : sta->addr) < 0)
+#else
+	    radius_client_send(hapd->radius, msg, RADIUS_AUTH, sta->addr) < 0)
+#endif
 		radius_msg_free(msg);
 
 	sta->acct_session_started = 1;
@@ -349,9 +361,15 @@ static void accounting_sta_report(struct hostapd_data *hapd,
 		goto fail;
 	}
 
+#ifdef CONFIG_MLO
+	if (radius_client_send(hapd->radius, msg,
+			       stop ? RADIUS_ACCT : RADIUS_ACCT_INTERIM,
+			       sta->ml ? sta->ml->addr : sta->addr) < 0)
+#else
 	if (radius_client_send(hapd->radius, msg,
 			       stop ? RADIUS_ACCT : RADIUS_ACCT_INTERIM,
 			       sta->addr) < 0)
+#endif
 		goto fail;
 	return;
 
