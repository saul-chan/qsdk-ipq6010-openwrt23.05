@@ -255,7 +263,11 @@ void accounting_sta_start(struct hostapd_data *hapd, struct sta_info *sta)
 
 	msg = accounting_msg(hapd, sta, RADIUS_ACCT_STATUS_TYPE_START);
 	if (msg &&
