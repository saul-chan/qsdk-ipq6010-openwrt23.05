+int dpp_map_bss_conf_resp(struct dpp_authentication *auth, const char *cmd)
+{
+	char *curve = NULL;
+	char *confobj = NULL;
+	size_t confobjlen = 0;
+	int ret = -1;
+
+	curve = get_param(cmd, " curve=");
