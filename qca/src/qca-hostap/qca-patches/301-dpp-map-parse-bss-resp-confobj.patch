+char *get_confobj(const char *cmd, const char *param)
+{
+	const char *pos;
+	char *val;
+	size_t len;
+
+	pos = os_strstr(cmd, param);
+	if (!pos)
+		return NULL;
+	pos += os_strlen(param);
+	len = os_strlen(cmd) - (pos - cmd);
+
+	val = os_malloc(len + 1);
+	if (!val)
+		return NULL;
+	os_memcpy(val, pos, len);
+	val[len] = '\0';
+	return val;
+}
 
