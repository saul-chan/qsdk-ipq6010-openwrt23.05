+static bool wpa_mlo_check_for_mlo_skip_link(struct wpa_supplicant *wpa_s)
+{
+	if (!wpa_support_link_skip(wpa_s)) {
+		wpa_dbg(wpa_s, MSG_DEBUG, "MLO Link Downgrade/Skip feature Not-Supported");
+		return false;
+	}
+
+	if (wpa_s->skip_link) {
+		wpa_dbg(wpa_s, MSG_DEBUG, "ML_STR: Skip this link because of downgrade");
+		/* reset flags */
+		wpa_supplicant_cancel_skip_link_timer(wpa_s);
+		wpa_s->skip_link = false;
+		return true;
+	}
+	wpa_supplicant_req_skip_link_timer(wpa_s);
+	wpa_dbg(wpa_s, MSG_DEBUG, "ML_STA: Invalid RNR-IE, incompatible with scan entry");
+
+	return false;
+}
