+#ifdef CONFIG_MLO
+static int wpa_config_process_sta_mld_addr(
+	const struct global_parse_data *data,
+	struct wpa_config *config, int line, const char *pos)
+{
+	if (hwaddr_aton2(pos, config->sta_mld_addr) < 0) {
+		wpa_printf(MSG_ERROR, "Line %d: Invalid sta_mld_addr '%s'",
+				line, pos);
+		return -1;
+	}
+	wpa_printf(MSG_DEBUG, "STA MLD Addr " MACSTR , MAC2STR(config->sta_mld_addr));
+	return 0;
+}
