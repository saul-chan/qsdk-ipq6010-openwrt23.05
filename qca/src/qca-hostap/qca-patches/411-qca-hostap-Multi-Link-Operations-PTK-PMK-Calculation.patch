index ee6be25..f11e5bc 100644
--- a/src/ap/ieee802_11_shared.c
+++ b/src/ap/ieee802_11_shared.c
@@ -970,6 +970,84 @@ u8 * hostapd_eid_basic_mle(struct hostapd_data *hapd, u8 *eid, size_t len)
 	*elen_ptr = (pos - mlo_ie_body_ptr);
 	return pos;
 }
+
+size_t hostapd_eid_mle_auth_len(struct hostapd_data *hapd, struct sta_info *sta)
+{
+	if (!hapd || !hapd->mlo_link || !sta || !sta->ml)
+		return 0;
+
+	return (3/*EL/LEN/EXT*/ + MULTI_LINK_CONTROL_BYTES +
+		1 /*COMMON-INFO-LEN field */+
+		ETH_ALEN /*mld-mac*/);
+}
+
+u8 * hostapd_eid_mle_auth(struct hostapd_data *hapd, struct sta_info *sta,
+			  u8 *eid, size_t len)
+{
+	u8 *pos = eid;
+	u8 *elen_ptr;
+	u8 *mlo_ie_body_ptr;
+
+	if (!hapd->mlo_link || !sta->ml)
+		return pos;
+
+	/*
+	 * Check for enough bytes for element-id(1 byte)
+	 * 			      len(1 byte) and
+	 * 			      extension-id (1 byte)
+	 * 			      = 3 bytes
+	 */
+	if (len < 3) {
+		wpa_printf(MSG_DEBUG,
+			   "MLO: Not enough room in the buffer for Multi-Link IE");
+		return pos;
+	}
+
+	*pos++ = WLAN_EID_EXTENSION;
+	len--;
+	elen_ptr = pos;
+	pos++;
+	len--;
+	mlo_ie_body_ptr = pos;
+	*pos++ = WLAN_EID_EXT_MULTI_LINK;
+	len--;
+	if (len < MULTI_LINK_CONTROL_BYTES) {
+		wpa_printf(MSG_ERROR, "ERROR!! No room %d\n", __LINE__);
+	}
+	//Common info control field
+	os_memset(pos, 0, MULTI_LINK_CONTROL_BYTES);
+	*pos |= MULTI_LINK_CONTROL_TYPE_BASIC &
+		MULTI_LINK_CONTROL_TYPE_BITMASK_MASK;
+	pos += MULTI_LINK_CONTROL_BYTES;
+	len -= MULTI_LINK_CONTROL_BYTES;
+
+	/*
+	 * Check for enough bytes to cover
+	 * Common-info length place holder (1 byte)
+	 * MAC Address (6 bytes)
+	 * Total = 7 bytes
+	 */
+	if (len < 7) {
+		wpa_printf(MSG_ERROR, "ERROR!! No room %s:%d\n",
+			   __func__, __LINE__);
+		return pos;
+	}
+	*pos = 7;
+	pos++;
+	len--;
+
+	// Common info fields
+	os_memcpy(pos, hapd->conf->mld_mac_addr, ETH_ALEN); //MLD Addr
+	pos += ETH_ALEN;
+	len -= ETH_ALEN;
+
+	/*
+	 * Fill the element length
+	 */
+	*elen_ptr = (pos - mlo_ie_body_ptr);
+	return pos;
+}
+
 #endif
 
