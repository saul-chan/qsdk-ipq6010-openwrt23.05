+++ b/src/utils/wpa_debug.c
@@ -521,6 +521,29 @@ void wpa_hexdump_ascii_key(int level, const char *title, const void *buf,
 }
 
 
+#define MB 1000000
+int is_log_sizelimit(char *limit)
+{
+	unsigned long int  size;
+	double max_limit;
+
+	if (!out_file)
+		return 0;
+
+	if (limit)
+		max_limit = atof(limit)*MB;
+	else
+		max_limit = MB;
+
+	size = ftell(out_file);
+
+	if (size >= max_limit) {
+		wpa_printf(MSG_ERROR ,"Size limit exceeded MAX_FILE_SIZE_LIMIT: %f current file size: %lu", max_limit, size);
+		wpa_debug_stop_log();
+	}
+	return 0;
+}
