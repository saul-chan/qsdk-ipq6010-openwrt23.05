+int dpp_csign_get_kid_hash(void *msg_ctx, struct wpabuf * csign_pub,
+			   char *buf, size_t buflen)
+{
+	struct crypto_ec_key *csign = NULL;
+	const u8 *addr[1];
+	size_t len[1];
+	int ret = -1;
+	int res;
+	u8 hash[SHA256_MAC_LEN];
+	char hex[2 * SHA256_MAC_LEN + 1];
+	struct wpabuf *uncomp;
+	const unsigned char *p;
+
+	p = wpabuf_head(csign_pub);
+	csign = (struct crypto_ec_key *)d2i_PUBKEY(NULL, &p, wpabuf_len(csign_pub));
+	if (!csign) {
+		wpa_printf(MSG_ERROR,
+			   "DPP: Failed to parse local C-sign-key information");
+		return -1;
+	}
+
+	uncomp = crypto_ec_key_get_pubkey_point(csign, 1);
+	crypto_ec_key_deinit(csign);
+	if (!uncomp)
+		return -1;
+	addr[0] = wpabuf_head(uncomp);
+	len[0] = wpabuf_len(uncomp);
+	res = sha256_vector(1, addr, len, hash);
+	wpabuf_free(uncomp);
+
+	if (res < 0) {
+		wpa_printf(MSG_DEBUG,
+			   "DPP: Failed to derive kid for C-sign-key");
+		return -1;
+	}
+
+	wpa_hexdump(MSG_DEBUG, "DPP: kid = SHA256(uncompressed C-sign key)",
+		    hash, SHA256_MAC_LEN);
+	ret = wpa_snprintf_hex(buf, buflen, hash, sizeof(hash));
+
+	wpa_snprintf_hex(hex, sizeof(hex), hash, sizeof(hash));
+	wpa_msg(msg_ctx, MSG_INFO, DPP_EVENT_CSIGN_KID "%s", hex);
+
+	return ret;
+}
+
 
