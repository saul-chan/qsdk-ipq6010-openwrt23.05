diff --git a/wpa_supplicant/events.c b/wpa_supplicant/events.c
index 55bb0a2..3419d25 100644
--- a/wpa_supplicant/events.c
+++ b/wpa_supplicant/events.c
@@ -2341,14 +2341,19 @@ static int wpa_mlo_link_scan_done(struct wpa_supplicant *wpa_s)
 {
 	struct wpa_global *global = wpa_s->global;
 	struct wpa_supplicant *local_wpa_s = global->ifaces;
-	int ret = 1;
+	int ret = 1, link_count = 1;
 
 	wpa_for_each_mlo_link(local_wpa_s, global) {
 		if(wpa_partner_mlo_link(wpa_s , local_wpa_s)) {
+			link_count++;
 			if(local_wpa_s->scan_done == false)
 				ret=0;
 		}
 	}
+	/* Postpone candidate selection till all links are discovered */
+	if (link_count != wpa_s->conf->num_mlo_links) {
+		ret = 0;
+	}
 	return ret;
 }
 
