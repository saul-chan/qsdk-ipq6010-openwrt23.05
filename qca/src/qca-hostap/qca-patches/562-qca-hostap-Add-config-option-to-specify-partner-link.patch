 }
+
+static int driver_nl80211_get_if_mac_addr(void *priv, const uint8_t *ifname,
+				      uint8_t *if_addr)
+{
+	char path[128];
+	FILE *fp;
+	/* Length of mac address xx:xx:xx:xx:xx:xx */
+	char mac_addr_str[ETH_ALEN*3];
+
+	os_snprintf(path, sizeof(path), "/sys/class/net/%s/address", ifname);
+	fp = fopen(path, "r");
+	if (fp == NULL) {
+		wpa_printf(MSG_ERROR, "ERROR!! %s Failed to open %s\n", __func__, path);
+		return -1;
+	}
+	if (fgets(mac_addr_str, sizeof(mac_addr_str), fp) == NULL) {
+		wpa_printf(MSG_ERROR, "ERROR!! %s Failed to get mac from %s\n", __func__, path);
+		fclose(fp);
+		return -1;
+	}
+	fclose(fp);
+
+	return hwaddr_aton(mac_addr_str, if_addr);
+}
