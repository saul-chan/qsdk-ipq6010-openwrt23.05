+#ifdef CONFIG_MLO
+static int convert_mld_link_if_names_to_macs(struct hostapd_data *hapd)
+{
+	int num_links;
+	int cnt;
+	if (!hapd || !hapd->conf)
+		return -1;
+	if (!hapd->conf->mld_link_interface_list)
+		return 0;
+
+	num_links = hapd->conf->mld_link_interface_list->num_links;
+
+	for (cnt = 0; cnt < num_links; cnt++) {
+		uint8_t *ifname;
+		uint8_t if_addr[ETH_ALEN];
+		int is_conf_mld_mac_set;
+
+		ifname = hapd->conf->mld_link_interface_list->ifname[cnt];
+                if (hostapd_drv_get_if_mac_addr(hapd, ifname, if_addr)) {
+			os_free(hapd->conf->mld_link_interface_list);
+			return -1;
+		}
+		is_conf_mld_mac_set =
+		!is_zero_ether_addr(hapd->conf->mld_link_mac_list.addr[cnt]);
+
+		if (is_conf_mld_mac_set) {
+			if (os_memcmp(hapd->conf->mld_link_mac_list.addr[cnt],
+			    if_addr, ETH_ALEN) != 0) {
+				wpa_printf(MSG_ERROR, "%s ERROR!! Partner MAC "
+					   "mismatch %d" MACSTR " " MACSTR "\n",
+					   __func__,
+					   cnt,
+					   MAC2STR(hapd->conf->mld_link_mac_list.addr[cnt]),
+					   MAC2STR(if_addr));
+				return -1;
+			}
+		} else {
+			os_memcpy(hapd->conf->mld_link_mac_list.addr[cnt], if_addr, ETH_ALEN);
+		}
+		wpa_printf(MSG_ERROR, "%s Conf MAC Address[%d] = "MACSTR"\n",
+			   hapd->conf->iface, cnt,
+			   MAC2STR(hapd->conf->mld_link_mac_list.addr[cnt]));
+	}
+	os_free(hapd->conf->mld_link_interface_list);
+	hapd->conf->mld_link_mac_list.num_links = num_links;
+	return 0;
+}
+#endif
 
