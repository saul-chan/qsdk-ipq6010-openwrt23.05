+static int add_mld_link_interfaces(struct hostapd_bss_config *bss, char *value)
+{
+	char *pos, *next;
+	int cnt;
+
+	next = value;
+	bss->mld_link_interface_list = os_zalloc(sizeof(*bss->mld_link_interface_list));
+	bss->mld_link_interface_list->num_links = 0;
+	cnt = 0;
+	while (cnt < MAX_MLO_LINKS)
+	{
+		uint8_t str_length;
+		pos = next;
+		next = os_strchr(pos, ' ');
+
+		if (next)
+			str_length = next - pos;
+		else
+			str_length = os_strlen(pos);
+		os_memcpy(bss->mld_link_interface_list->ifname[cnt], pos, str_length);
+		/* Null-terminate */
+		bss->mld_link_interface_list->ifname[cnt][str_length] = 0;
+
+		cnt++;
+		if (next == NULL)
+		       break;
+		next++;
+	}
+	bss->mld_link_interface_list->num_links = cnt;
+
+	wpa_printf(MSG_DEBUG, "MLO Partner interfaces for %s\n", bss->iface);
+	for (cnt=0; cnt < bss->mld_link_interface_list->num_links; cnt++)
+	{
+		wpa_printf(MSG_DEBUG, "Interface: %s\n",
+			   bss->mld_link_interface_list->ifname[cnt]);
+	}
+	return 0;
+
+}
