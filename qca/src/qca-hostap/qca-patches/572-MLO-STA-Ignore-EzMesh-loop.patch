--- a/wpa_supplicant/events.c
+++ b/wpa_supplicant/events.c
@@ -1475,6 +1475,54 @@ static int mlo_6ghz_dep_type_match(struct wpa_supplicant *wpa_s,
 	return 0;
 }
 
+#define EZMESH_INVALID_ROOT_AP_DISTANCE	255
+#define WHC_IE_VENDOR_TYPE		0x8cfdf000
+#define QCA_OUI_WHC_AP_INFO_SUBTYPE	0x00
+#define QCA_OUI_WHC_AP_INFO_VERSION     0x01
+struct ieee80211_whc {
+	u8	id;           /* IEEE80211_ELEMID_VENDOR */
+	u8	len;          /* length in bytes */
+	u8	oui[3];       /* 0x8c, 0xfd, 0xf0 */
+	u8	type;
+	u8	subtype;
+	u8	version;
+	u16	caps;/* SON/WDS/both */
+	u8	root_ap_dist; /* in hops */
+	u8	is_root_ap; /* is rootap or not */
+	u8	num_conn_re; /* number of connected REs to this device */
+	u8	uplink_bssid[ETH_ALEN]; /* Parent device's BSSID */
+	u16	uplink_rate; /* Rate in Mbps with parent device */
+	u8	bssid_5g[ETH_ALEN]; /* This device's 5G backhaulAP BSSID */
+	u8	bssid_2g[ETH_ALEN]; /* This device's 2.4G backhaulAP BSSID */
+};
+
+/**
+ * wpa_bss_get_son_vendor_ie - Fetch a SON vendor information element from a BSS entry
+ * @bss: BSS table entry
+ * @vendor_type: Vendor type (four octets starting the IE payload)
+ * Returns: Pointer to the information element (id field) or %NULL if not found
+ *
+ * This function returns the first matching information element in the BSS
+ * entry.
+ */
+const u8 * wpa_bss_get_son_vendor_ie(const struct wpa_bss *bss, u32 vendor_type)
+{
+	const u8 *ies;
+	const struct element *elem;
+
+	ies = wpa_bss_ie_ptr(bss);
+
+	for_each_element_id(elem, WLAN_EID_VENDOR_SPECIFIC, ies, bss->ie_len) {
+		if (elem->datalen >= 9 &&
+		    vendor_type == WPA_GET_BE32(elem->data) &&
+		    elem->data[4] == QCA_OUI_WHC_AP_INFO_SUBTYPE &&
+		    elem->data[5] == QCA_OUI_WHC_AP_INFO_VERSION)
+			return &elem->id;
+	}
+
+	return NULL;
+}
+	
 
 #endif /* CONFIG_MLO */
 
@@ -1895,6 +1943,23 @@ skip_assoc_disallow:
 
 		}
 	}
+
+	ie = wpa_bss_get_son_vendor_ie(bss, WHC_IE_VENDOR_TYPE);
+	if (ie) {
+		const struct ieee80211_whc *whc =
+			(const struct ieee80211_whc *) ie;
+
+		debug_print = 1;
+
+		wpa_dbg(wpa_s, MSG_DEBUG, "STA: WHC IE Root-AP Dist = %d", whc->root_ap_dist);
+
+		if (whc->root_ap_dist == EZMESH_INVALID_ROOT_AP_DISTANCE) {
+			if (debug_print)
+				wpa_dbg(wpa_s, MSG_DEBUG,
+					"   skip - based on Ezmesh WHC Loop detection setting");
+			return false;
+		}
+	}
 #endif
 
