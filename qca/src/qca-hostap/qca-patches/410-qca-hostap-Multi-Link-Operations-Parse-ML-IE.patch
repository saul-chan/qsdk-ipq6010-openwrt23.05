+#ifdef CONFIG_MLO
+static u16 check_and_skip_buf(uint8_t **buf, uint8_t *length, uint8_t skip_len)
+{
+	if (*length < skip_len) {
+		return WLAN_STATUS_UNSPECIFIED_FAILURE;
+	}
+
+	*buf += skip_len;
+	*length -= skip_len;
+	return WLAN_STATUS_SUCCESS;
+}
+
+#define CHECK_AND_SKIP(field_var, bufptr, lenptr, field_len, field_str) \
+{ \
+	if (field_var) { \
+		if (check_and_skip_buf(bufptr, lenptr, field_len)) { \
+			wpa_printf(MSG_ERROR, "%s: incomplete\n", field_str); \
+			return; \
+		} \
+	} \
+}
+
+static void parse_mlo_sta_profile(struct sta_info_ml *sta_ml,
+				  u8 *buf, u8 length, int is_assoc)
+{
+	struct ieee80211_ml_per_sta_control control = {0};
+
+	if (length < MULTI_LINK_PER_STA_CONTROL_BYTES) {
+		wpa_printf(MSG_ERROR, "ERROR! %s:%d incomplete\n", __func__,
+				      __LINE__);
+		return;
+	}
+
+	control.link_id =
+		(((*buf) >> MULTI_LINK_PER_STA_LINK_ID_BITMASK_SHIFT) &
+			   MULTI_LINK_PER_STA_LINK_ID_BITMASK_MASK);
+	control.complete =
+		(((*buf) >> MULTI_LINK_PER_STA_COMPLETE_BITMASK_SHIFT) &
+			   MULTI_LINK_PER_STA_COMPLETE_BITMASK_MASK);
+	control.beacon_interval_present =
+		((*buf) >> MULTI_LINK_PER_STA_BINTVAL_BITMASK_SHIFT) &
+		           MULTI_LINK_PER_STA_BINTVAL_BITMASK_MASK;
+	control.mac_address_present =
+		((*buf) >> MULTI_LINK_PER_STA_MACADDR_BITMASK_SHIFT) &
+		           MULTI_LINK_PER_STA_MACADDR_BITMASK_MASK;
+	control.dtim_info_present =
+		((*buf) >> MULTI_LINK_PER_STA_DTIM_BITMASK_SHIFT) &
+			   MULTI_LINK_PER_STA_DTIM_BITMASK_MASK;
+	buf++;
+	length--;
+	control.nstr_link_pair_present =
+		((*buf) >> MULTI_LINK_PER_STA_NSTR_LINK_BITMASK_SHIFT) &
+			   MULTI_LINK_PER_STA_NSTR_LINK_BITMASK_MASK;
+	control.nstr_bitmap_size =
+		((*buf) >> MULTI_LINK_PER_STA_NSTR_MAP_BITMASK_SHIFT) &
+			   MULTI_LINK_PER_STA_NSTR_MAP_BITMASK_MASK;
+	buf++;
+	length--;
+
+	if (control.mac_address_present) {
+
+		if (length < 6) {
+			wpa_printf(MSG_ERROR, "%s ERROR!! Not enough bytes for"
+				  " MLD MAC in the ML-IE\n", __func__);
+			return;
+		}
+
+		memcpy(sta_ml->partner_link_addr[control.link_id], buf, 6);
+		buf += 6;
+		length -= 6;
+
+	} else {
+		wpa_printf(MSG_ERROR, "ERROR!! STA PROFILE SHOULD HAVE MAC\n");
+		return;
+	}
+
+	CHECK_AND_SKIP(control.beacon_interval_present, &buf, &length, 1,
+			"PER_STA_BEACON_INTERVAL");
+	CHECK_AND_SKIP(control.dtim_info_present, &buf, &length, 2,
+			"PER_STA_DTIM_INFO");
+	CHECK_AND_SKIP((control.nstr_link_pair_present &&
+			control.nstr_bitmap_size), &buf, &length, 1,
+			"PER_STA_NTSR_LINK_PAIR_BITMAP");
+
+	if (control.complete && is_assoc) {
+		sta_ml->ie_assoc_reassoc_data[control.link_id] = buf;
+		sta_ml->ie_assoc_reassoc_len[control.link_id] = length;
+	}
+}
+
+static void parse_mlo_subelements(struct sta_info_ml *sta_ml,
+				  u8 *buf, size_t len, int is_assoc)
+{
+	uint8_t elem_id, elem_len;
+
+	while(len >= (sizeof(elem_id) + sizeof(elem_len))) {
+
+		elem_id = *buf;
+		buf++;
+		len--;
+
+		elem_len = *buf;
+		buf++;
+		len--;
+
+		if (elem_len > len) {
+			wpa_printf(MSG_ERROR, "ERROR! %s: not enough length\n",
+				   __func__);
+			return;
+		}
+
+
+		switch (elem_id)
+		{
+			case MULTI_LINK_SUBELEM_ID_PER_STA_PROFILE:
+				parse_mlo_sta_profile(sta_ml, buf, elem_len,
+						      is_assoc);
+				break;
+			default:
+				wpa_printf(MSG_ERROR, "INFO! %s unhandled %d\n",
+						__func__, elem_id);
+				break;
+		}
+		buf += elem_len;
+		len -= elem_len;
+	}
+}
+
+void parse_ml_element(struct sta_info *sta,
+		      const u8 *mlo_ie_buf, u8 len, int is_assoc)
+{
+	struct ieee80211_ml_control ml_control = {0};
+	uint8_t *buf;
+
+	if ((mlo_ie_buf == NULL) || len == 0)
+		return;
+
+	buf = (uint8_t *)mlo_ie_buf;
+
+	if (!sta->ml)
+		sta->ml = os_zalloc(sizeof(*sta->ml));
+
+	if (sta->ml == NULL) {
+		wpa_printf(MSG_ERROR, "ERROR!! %s: failed to allocate sta->ml\n",
+				__func__);
+		return;
+	}
+
+	if (len < MULTI_LINK_CONTROL_BYTES) {
+		wpa_printf(MSG_ERROR, "ERROR! %s:%d incomplete\n",
+				__func__, __LINE__);
+		goto free_ml;
+	}
+
+	ml_control.type = (*buf) & MULTI_LINK_CONTROL_TYPE_BITMASK_MASK;
+	if (ml_control.type != MULTI_LINK_CONTROL_TYPE_BASIC)
+		/*
+		 * Handle only BASIC MLO IE for now
+		 */
+		goto free_ml;
+
+	ml_control.u.basic.mld_mac_addr_present =
+		((*buf) >> MULTI_LINK_CONTROL_MLD_MAC_BITMASK_SHIFT) &
+			   MULTI_LINK_CONTROL_MLD_MAC_BITMASK_MASK;
+	ml_control.u.basic.tx_ap_link_id_present =
+		((*buf) >> MULTI_LINK_CONTROL_TX_AP_LINK_BITMASK_SHIFT) &
+			   MULTI_LINK_CONTROL_TX_AP_LINK_BITMASK_MASK;
+	ml_control.u.basic.bss_param_change_count =
+		((*buf) >> MULTI_LINK_CONTROL_AP_CHANGE_BITMASK_SHIFT) &
+			   MULTI_LINK_CONTROL_AP_CHANGE_BITMASK_MASK;
+	ml_control.u.basic.mld_cap_present =
+		((*buf) >> MULTI_LINK_CONTROL_MLD_CAP_BITMASK_SHIFT) &
+			   MULTI_LINK_CONTROL_MLD_CAP_BITMASK_MASK;
+	buf++;
+	len--;
+	ml_control.u.basic.eml_cap_present =
+		((*buf) >> MULTI_LINK_CONTROL_MLD_CAP_BITMASK_SHIFT) &
+			   MULTI_LINK_CONTROL_MLD_CAP_BITMASK_MASK;
+	buf++;
+	len--;
+	/*
+	 * Common-Info
+	 */
+	if (ml_control.u.basic.mld_mac_addr_present) {
+		if (len < 6) {
+			wpa_printf(MSG_ERROR, "%s ERROR!! Not enough bytes"
+				   " for MLD MAC address\n", __func__);
+			goto free_ml;
+		}
+		memcpy(sta->ml->addr, buf, 6);
+		buf += 6;
+		len -= 6;
+	} else {
+		wpa_printf(MSG_ERROR, "ERROR!! NO MLD MAC PRESENT IN ML IE\n");
+		goto free_ml;
+	}
+	if (ml_control.u.basic.tx_ap_link_id_present) {
+		uint8_t reporting_sta_link_id;
+		if (len < 1) {
+			wpa_printf(MSG_ERROR, "ERROR! %s:%d incomplete\n", __func__,
+					__LINE__);
+			goto free_ml;
+		}
+
+		/*
+		 * Setting pointers to reporting STA
+		 */
+		reporting_sta_link_id = *((uint8_t *)buf) &
+					MULTI_LINK_COMMON_INFO_LINK_ID_MASK;
+		sta->ml->sta[reporting_sta_link_id] = sta;
+		memcpy(sta->ml->partner_link_addr[reporting_sta_link_id],
+		       sta->addr, 6);
+
+		buf += 1;
+		len -= 1;
+	}
+	CHECK_AND_SKIP(ml_control.u.basic.bss_param_change_count,
+		       &buf, &len, 1, "MLO_BSS_PARAM_CHANGE_PRESENT");
+	CHECK_AND_SKIP(ml_control.u.basic.mld_cap_present,
+		       &buf, &len, 2, "MLO_MLD_CAP_PRESENT");
+	CHECK_AND_SKIP(ml_control.u.basic.eml_cap_present,
+		       &buf, &len, 4, "MLO_EML_CAP_PRESENT");
+
+	/*
+	 * Link-Info
+	 */
+	parse_mlo_subelements(sta->ml, buf, len, is_assoc);
+	return;
+free_ml:
+	os_free(sta->ml);
+	sta->ml = NULL;
+
+}
