+static int hostapd_wpa_auth_add_rsnie_of_all_links_cb(struct hostapd_data *hapd,
+						      struct sta_info *sta,
+						      void *data)
+{
+	struct links_rsnie *links = (struct links_rsnie *)data;
+	struct wpa_auth_config *conf;
+	u8 res = 0, rsn[255] = {0};
+
+	conf = &hapd->wpa_auth->conf;
+	res = wpa_write_rsn_ie(conf, rsn, sizeof(rsn), links->pmkid);
+	if (res < 0)
+		return -1;
+
+	links->links_rsnie[links->no_of_links] = (u8 *)os_zalloc(res + 1);
+	if (!links->links_rsnie[links->no_of_links]) {
+		wpa_printf(MSG_ERROR, "Failed to allocate memory");
+		return -1;
+	}
+
+	links->links_rsnie[links->no_of_links] = (u8 *)os_zalloc(res+1);
+	links->link_id[links->no_of_links] = hapd->mlo_link->link_id;
+	links->links_rsnie[links->no_of_links][0] = res;
+	os_memcpy(links->links_rsnie[links->no_of_links] + 1, rsn, res);
+	links->no_of_links++;
+
+	return 0;
+}
