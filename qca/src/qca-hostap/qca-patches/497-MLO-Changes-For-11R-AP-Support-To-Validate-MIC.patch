+static void free_allocated_memory_for_ml_params(u8 **links_addr, u8 **links_rsnie,
+						u8 **links_rsnx, u8 no_of_links){
+	u8 i;
+
+	for (i=0; i < no_of_links; i++){
+		if (links_addr) {
+			if (links_addr[i]) {
+				os_free(links_addr[i]);
+				links_addr[i] = NULL;
+			}
+		}
+		if (links_rsnie) {
+			if (links_rsnie[i]) {
+				os_free(links_rsnie[i]);
+				links_rsnie[i] = NULL;
+			}
+		}
+		if (links_rsnx) {
+			if (links_rsnx[i]) {
+				os_free(links_rsnx[i]);
+				links_rsnx[i] = NULL;
+			}
+		}
+	}
+	if (links_addr) {
+		os_free(links_addr);
+		links_addr = NULL;
+	}
+	if (links_rsnie) {
+		os_free(links_rsnie);
+		links_rsnie = NULL;
+	}
+	if (links_rsnx) {
+		os_free(links_rsnx);
+		links_rsnx = NULL;
+	}
+}
