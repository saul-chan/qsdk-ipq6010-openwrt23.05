+static u8 hostapd_wpa_auth_get_no_of_links(void *ctx, u8 *addr)
+{
+	struct hostapd_data *hapd = ctx;
+	struct sta_info *sta;
+
+	if (!hapd->mlo_link || !hapd->mlo_link->mld)
+		return 0;
+
+	sta = ap_get_sta(hapd, addr);
+
+	if (!sta || !sta->ml)
+		return 0;
+
+	return sta->ml->link_count;
+}
+
+void sort_mlo_link_elems(u8 **mlo_elems, u8 *link_id, u8 no_of_links)
+{
+	u8 i, j, temp_link_id;
+	u8 *temp;
+
+	for (i = 0; i < no_of_links; i++){
+		for (j = 0; j < (no_of_links - 1); j++){
+			if (link_id[j] > link_id[j+1]) {
+				temp_link_id = link_id[j];
+				link_id[j] = link_id[j+1];
+				link_id[j+1] = temp_link_id;
+				temp = mlo_elems[j];
+				mlo_elems[j] = mlo_elems[j+1];
+				mlo_elems[j+1] = temp;
+			}
+		}
+	}
+}
+
+static int hostapd_wpa_auth_get_links_addr_cb(struct hostapd_data *hapd,
+					      struct sta_info *sta,
+					      void *data)
+{
+	struct links_addr *links = (struct links_addr *)data;
+
+	links->links_addr[links->no_of_links] = (u8 *)os_zalloc(ETH_ALEN);
+
+	if (!links->links_addr[links->no_of_links]) {
+		wpa_printf(MSG_ERROR, "Failed to allocate memory");
+		return -1;
+	}
+
+	links->link_id[links->no_of_links] = hapd->mlo_link->link_id;;
+	if (links->is_ap)
+		os_memcpy(links->links_addr[links->no_of_links], hapd->own_addr, 6);
+	else
+		os_memcpy(links->links_addr[links->no_of_links], sta->addr, ETH_ALEN);
+	links->no_of_links++;
+
+	return 0;
+}
+
+static u8 **hostapd_wpa_auth_get_links_addr(void *ctx, u8 *addr, bool is_ap)
+{
+	struct hostapd_data *hapd = ctx;
+	struct sta_info *sta;
+	struct links_addr links;
+
+	if (!hapd->mlo_link || !hapd->mlo_link->mld)
+		return NULL;
+
+	sta = ap_get_sta(hapd, addr);
+
+	if (!sta || !sta->ml)
+		return NULL;
+
+	links.links_addr = (u8 **)os_zalloc(sta->ml->link_count *
+					    sizeof(*(links.links_addr)));
+	if (!links.links_addr) {
+		wpa_printf(MSG_ERROR, "Failed to allocate memory");
+		return NULL;
+	}
+	links.link_id = (u8 *)os_zalloc(sta->ml->link_count * sizeof(u8));
+
+	if (!links.link_id) {
+		wpa_printf(MSG_ERROR, "Failed to allocate memory");
+		return NULL;
+	}
+	links.no_of_links = 0;
+	links.is_ap = is_ap;
+	if (hostapd_wpa_auth_get_links_addr_cb(hapd, sta, &links) < 0)
+		return NULL;
+	if (set_for_each_partner_link_sta(hapd, sta->ml, &links,
+					  hostapd_wpa_auth_get_links_addr_cb) < 0)
+		return NULL;
+
