+static u8 **hostapd_wpa_auth_add_rsnie_of_all_links(void *ctx, u8 *addr,
+						    u8 *pmkid)
+{
+	struct hostapd_data *hapd = ctx;
+	struct sta_info *sta;
+	struct links_rsnie links;
+
+	if (!hapd->mlo_link || !hapd->mlo_link->mld)
+		return NULL;
+
+	sta = ap_get_sta(hapd, addr);
+
+	if (!sta || !sta->ml)
+		return NULL;
+
+	links.links_rsnie = (u8 **)os_zalloc(sta->ml->link_count *
+					     sizeof(*(links.links_rsnie)));
+	if (!links.links_rsnie) {
+		wpa_printf(MSG_ERROR, "Failed to allocate memory");
+		return NULL;
+	}
+
+	links.link_id = (u8 *)os_zalloc(sta->ml->link_count * sizeof(u8));
+	if (!links.link_id) {
+		wpa_printf(MSG_ERROR, "Failed to allocate memory");
+		return NULL;
+	}
+
+	links.no_of_links = 0;
+	links.pmkid = pmkid;
+
+	if (hostapd_wpa_auth_add_rsnie_of_all_links_cb(hapd, sta, &links) < 0)
+		return NULL;
+	if (set_for_each_partner_link_sta(hapd, sta->ml, &links,
+					  hostapd_wpa_auth_add_rsnie_of_all_links_cb) < 0)
+		return NULL;
+
+	/* Ensure RSNIE's of accepted links should be in increasing order of link-id */
+	sort_mlo_link_elems(links.links_rsnie, links.link_id,
+			    links.no_of_links);
+	os_free(links.link_id);
+
+	return links.links_rsnie;
+}
