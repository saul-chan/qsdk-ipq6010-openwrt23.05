@@ -666,6 +666,10 @@ static void wpa_supplicant_cleanup(struct wpa_supplicant *wpa_s)
 	eloop_cancel_timeout(wpas_network_reenabled, wpa_s, NULL);
 	eloop_cancel_timeout(wpas_clear_disabled_interface, wpa_s, NULL);
 
+#ifdef CONFIG_MLO
+        wpa_supplicant_cancel_skip_link_timer(wpa_s);
+#endif
+
 	wpas_wps_deinit(wpa_s);
 
 	wpabuf_free(wpa_s->pending_eapol_rx);
@@ -3617,6 +3621,67 @@ bool wpa_ml_sta(struct wpa_supplicant *wpa_s)
 		return true;
 	return false;
 }
+
+bool wpa_support_link_skip(struct wpa_supplicant *wpa_s)
+{
+	if (wpa_s->conf->mlo_skip_link_time <= 0)
+		return false;
+
+	return true;
+}
+
+void wpa_supplicant_skip_link(void *eloop_ctx, void *timeout_ctx)
+{
+	struct wpa_supplicant *wpa_s = eloop_ctx;
+
+	if (!wpa_support_link_skip(wpa_s)) {
+		wpa_dbg(wpa_s, MSG_DEBUG, "MLO Link Downgrade/Skip feature Not-Supported");
+		return;
+	}
+	wpa_dbg(wpa_s, MSG_DEBUG, "Skip Timer handler");
+
+	wpa_s->skip_link_timer_running = false;
+	wpa_s->skip_link = true;
+
+	return;
+}
+
+void wpa_supplicant_cancel_skip_link_timer(struct wpa_supplicant *wpa_s)
+{
+	if (!wpa_support_link_skip(wpa_s)) {
+		wpa_dbg(wpa_s, MSG_DEBUG, "MLO Link Downgrade/Skip feature Not-Supported");
+		return;
+	}
+
+	if (!wpa_s->skip_link_timer_running)
+		return;
+
+	wpa_dbg(wpa_s, MSG_DEBUG, "Cancelling skip link timer");
+	eloop_cancel_timeout(wpa_supplicant_skip_link, wpa_s, NULL);
+	wpa_s->skip_link_timer_running = false;
+	wpa_s->skip_link = false;
+
+	return;
+}
+
+void wpa_supplicant_req_skip_link_timer(struct wpa_supplicant *wpa_s)
+{
+	if (!wpa_support_link_skip(wpa_s)) {
+		wpa_dbg(wpa_s, MSG_DEBUG, "MLO Link Downgrade/Skip feature Not-Supported");
+		return;
+	}
+
+	if (wpa_s->skip_link_timer_running) {
+		wpa_dbg(wpa_s, MSG_DEBUG, "MLO Link Downgrade/Skip timer is running");
+		return;
+	}
+
+	wpa_dbg(wpa_s, MSG_DEBUG, "Starting skip link timer: %d(s)", wpa_s->conf->mlo_skip_link_time);
+	wpa_s->skip_link_timer_running = true;
+	eloop_register_timeout(wpa_s->conf->mlo_skip_link_time, 0, wpa_supplicant_skip_link, wpa_s, NULL);
+
+	return;
+}
 #endif /* CONFIG_MLO */
 
