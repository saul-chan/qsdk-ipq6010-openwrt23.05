+/**
+ * wpa_mlo_validate_security - Combine common RSN in MLD
+ * @wpa_supplicant: The Assoc supplicant interface
+ * @bss: scan entry
+ * @ie: RSN IE data
+ * @ap_mld_mac: AP MLD mac addr
+ *
+ * Configure the RSN-IE of all partner links of AP-MLD.
+ */
+int wpa_mlo_validate_security(struct wpa_supplicant *wpa_s,
+				     struct wpa_bss *bss,
+				     struct wpa_ie_data *ie,
+				     u8 ap_mld_mac[ETH_ALEN])
+{
+	struct wpa_global *global = wpa_s->global;
+	struct wpa_supplicant *local_wpa_s = global->ifaces;
+	struct wpa_bss *temp_bss;
+	u8 temp_ap_mld_mac[ETH_ALEN];
+	struct wpa_ie_data temp_ie;
+	int i = 0;
+
+	wpa_for_each_mlo_link(local_wpa_s, global) {
+
+		if (wpa_s == local_wpa_s)
+			continue;
+
+		if (!wpa_partner_mlo_link(wpa_s , local_wpa_s))
+			continue;
+
+		for (i = 0; i < local_wpa_s->last_scan_res_used; i++) {
+			temp_bss = local_wpa_s->last_scan_res[i];
+			const u8 *ml_ie = get_ie_ext((const u8 *) (temp_bss + 1), temp_bss->ie_len, WLAN_EID_EXT_MULTI_LINK);
+
+			if (ml_ie) {
+				os_memcpy(temp_ap_mld_mac, ml_ie+5, ETH_ALEN);
+				if(os_memcmp(temp_ap_mld_mac, ap_mld_mac, ETH_ALEN) == 0) {
+					/* Matching MLD scan entry found */
+					const u8 *temp_rsn_ie = wpa_bss_get_ie(temp_bss, WLAN_EID_RSN);
+
+					wpa_parse_wpa_ie(temp_rsn_ie, 2 + temp_rsn_ie[1], &temp_ie);
+
+					ie->pairwise_cipher &= temp_ie.pairwise_cipher;
+					ie->has_pairwise &= temp_ie.has_pairwise;
+					ie->group_cipher &= temp_ie.group_cipher;
+					ie->has_group &= temp_ie.has_group;
+					ie->key_mgmt &= temp_ie.key_mgmt;
+				}
+			}
+		}
+	}
+	return 0;
+}
