+/* Limit total available 20M channels within the channel list */
+static void dfs_limit_n_chans(struct hostapd_iface *iface, int start_chan_idx,
+                   struct hostapd_hw_modes *mode, int *n_chans)
+{
+    if ((start_chan_idx + (*n_chans)) > mode->num_channels) {
+        wpa_printf(MSG_DEBUG, "DEBUG!! %s:%s channel index can go"
+                   " out of bounds -- start:%d "
+                   "width_n_chans:%d num_channels:%d\n",
+                   iface->phy, __func__, start_chan_idx, *n_chans,
+                   mode->num_channels);
+        *n_chans = mode->num_channels - start_chan_idx;
+    }
+}
 
