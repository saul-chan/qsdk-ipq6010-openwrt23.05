+void wpa_supplicant_cleanup_ml_link_probe(struct wpa_supplicant *wpa_s)
+{
+	struct wpa_global *global = wpa_s->global;
+	struct wpa_supplicant *local_wpa_s;
+	struct wpa_bss *bss;
+
+	/* Clean-up ml-connect params for all links */
+	wpa_for_each_mlo_link(local_wpa_s, global) {
+		if (!wpa_partner_mlo_link(wpa_s, local_wpa_s))
+			continue;
+
+		local_wpa_s->ml_connect = false;
+		local_wpa_s->primary_link = false;
+		local_wpa_s->active_ml_sta = false;
+		local_wpa_s->link_id = -1;
+		os_memset(local_wpa_s->bssid, 0, ETH_ALEN);
+	}
+
+	/* Clean-up bss ML probe entries */
+	bss = wpa_s->ml_connect_probe_bss;
+	bss->n_missing_mld_links = 0;
+	os_memset(bss->missing_mld_links, 0, sizeof(bss->missing_mld_links));
+	bss->n_mld_links = 0;
+	os_memset(bss->mld_links, 0, sizeof(bss->mld_links));
+
+	/* Clean-up wpa_s ML probe entries */
+	wpa_s->ml_probe_mld_id = -1;
+	wpa_s->ml_probe_links = 0;
+	os_memset(wpa_s->ml_probe_bssid, 0, ETH_ALEN);
+	wpa_s->ml_connect_probe_bss = NULL;
+	wpa_s->ml_connect_probe_ssid = NULL;
+}
+
+static void wpas_ml_probe_req_new_scan(void *eloop_ctx, void *timeout_ctx)
+{
+	struct wpa_supplicant *wpa_s = eloop_ctx;
+	struct wpa_global *global = wpa_s->global;
+	struct wpa_supplicant *local_wpa_s;
+
+	wpa_dbg(wpa_s, MSG_INFO, "ML_STA: Request a new scan after ML probe expiry");
+	wpa_for_each_mlo_link(local_wpa_s, global) {
+		if (!wpa_partner_mlo_link(wpa_s, local_wpa_s))
+			continue;
+		wpa_supplicant_req_new_scan(wpa_s, wpa_s->scan_interval, 0);
+	}
+}
+
+void wpa_supplicant_ml_link_probe_scan_timeout(void *ctx, void *noop)
+{
+	struct wpa_supplicant *wpa_s = ctx;
+
+	if (!wpa_s->conf->ml_probing)
+		return;
+
+	if (!wpa_s->ml_connect_probe_ssid || !wpa_s->ml_connect_probe_bss)
+		return;
+
+	wpa_s->ml_link_probe_retry_count++;
+	radio_remove_works(wpa_s, "scan", 0);
+	if (wpa_s->ml_link_probe_retry_count >= ML_LINK_PROBE_RETRY_MAX) {
+		wpa_supplicant_cleanup_ml_link_probe(wpa_s);
+
+		/* Trigger a new scan to trigger skip_link if enabled */
+		eloop_cancel_timeout(wpas_ml_probe_req_new_scan, wpa_s, NULL);
+		eloop_register_timeout(0, 0, wpas_ml_probe_req_new_scan, wpa_s, NULL);
+		return;
+	}
+
+	/* Retry ML probing one more time */
+	wpa_scan_retry_ml_link_probe(wpa_s, wpa_s->ml_connect_probe_bss,
+				     wpa_s->ml_connect_probe_ssid);
+}
