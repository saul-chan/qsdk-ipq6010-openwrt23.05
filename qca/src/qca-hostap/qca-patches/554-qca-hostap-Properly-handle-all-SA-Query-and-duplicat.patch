+static int mlo_partner_sta_sa_query(struct hostapd_data *hapd, u8 *buf,
+				    int link_id)
+{
+	struct hostapd_data *partner_hapd;
+	struct sta_info *partner_sta;
+
+	partner_hapd = get_partner_hapd(hapd, link_id);
+	if (!partner_hapd)
+		return 0;
+
+	partner_sta = ap_get_sta(partner_hapd, buf);
+	if (!partner_sta)
+		return 0;
+
+	wpa_printf(MSG_ERROR, "ERROR!! Partner STA already exist outside of"
+			"ML %s STAMAC:"MACSTR"\n",
+			partner_hapd->conf->iface,
+			MAC2STR(buf));
+
+	if (check_sa_query(partner_hapd, partner_sta, 0)) {
+		wpa_printf(MSG_DEBUG, "DEBUG!! SA Query initiated\n");
+		return WLAN_STATUS_ASSOC_REJECTED_TEMPORARILY;
+	} else {
+		ap_sta_disconnect(partner_hapd, partner_sta, partner_sta->addr,
+				  WLAN_REASON_UNSPECIFIED);
+		return WLAN_STATUS_UNSPECIFIED_FAILURE;
+	}
+}
