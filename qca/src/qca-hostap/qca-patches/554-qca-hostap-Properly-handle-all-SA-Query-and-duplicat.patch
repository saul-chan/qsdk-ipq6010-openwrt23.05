+static int validate_sta_profile_address(struct hostapd_data *hapd,
+					struct sta_info_ml *sta_ml, u8 *buf,
+					int link_id)
+{
+	if (!sta_ml->assoc_req_received) {
+		os_memcpy(sta_ml->partner_link_addr[link_id], buf, ETH_ALEN);
+		return 0;
+	}
+
+	/*
+	 * If assoc-request was received previously, that
+	 * means the partner link information is there.
+	 * We need to now compare the incoming partner STAs
+	 * with previous partner STAs and flag if they don't
+	 * match
+	 */
+	if (os_memcmp(sta_ml->partner_link_addr[link_id], buf, ETH_ALEN) == 0)
+		return 0;
+
+	wpa_printf(MSG_ERROR, "ERROR!! MLD with different MLD Partner addresses"
+		   "for link-id %d\nexisting:"MACSTR" new:"MACSTR"\n",link_id,
+		   MAC2STR(sta_ml->partner_link_addr[link_id]),
+		   MAC2STR(buf));
+
+	if (check_sa_query(hapd, sta_ml->assoc_link_sta, 0))
+		return WLAN_STATUS_ASSOC_REJECTED_TEMPORARILY;
+
+	/*
+	 * NOTE: branch never taken
+	 * This will not be taken since driver makes
+	 * sure the STA is disassociated in case
+	 * the existing STA is not PMF
+	 */
+	wpa_printf(MSG_ERROR, "ERROR!! hostapd received duplicate "
+		   "assoc-request on a non-PMF STA\n");
+	ap_sta_disconnect(hapd, sta_ml->assoc_link_sta,
+			  sta_ml->assoc_link_sta->addr,
+			  WLAN_REASON_UNSPECIFIED);
+	return WLAN_STATUS_UNSPECIFIED_FAILURE;
+}
