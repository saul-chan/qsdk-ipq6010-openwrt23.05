+int check_ml_ie_sa_query(struct hostapd_data *hapd, struct sta_info *sta,
+			 struct sta_info_ml *sta_ml_obj)
+{
+	bool self_sa_query = false, self_disconnect = false;
+	int osta_sa_query_status = 0;
+
+	if (sta_ml_obj) {
+		if ((sta->ml == sta_ml_obj) && (sta_ml_obj->assoc_link_sta == sta))
+			return 0;
+	} else if (!sta->ml)
+		return 0;
+
+	if (sta->ml || ((sta->flags & WLAN_STA_ASSOC) && sta_ml_obj)) {
+		/*
+		 * SA Query should go to the self station as well as any other
+		 * existing ML station which has this same MLD mac address
+		 */
+		self_sa_query = check_sa_query(hapd, sta, 0);
+		if (!self_sa_query) {
+
+			wpa_printf(MSG_ERROR, "ERROR!!! %s:%d This can NEVER HAPPEN. ASSERT FAILURE\n",
+				   __func__, __LINE__);
+			ap_sta_disconnect(hapd, sta, sta->addr, WLAN_REASON_UNSPECIFIED);
+			self_disconnect = true;
+		}
+	}
+
+	if ((sta->ml != sta_ml_obj) && sta_ml_obj && sta_ml_obj->assoc_link_sta) {
+		/*
+		 * if sta->ml == sta_ml_obj, then SA Query on the STA would
+		 * suffice
+		 */
+		struct sta_info *osta = sta_ml_obj->assoc_link_sta;
+		osta_sa_query_status =
+		mlo_partner_sta_sa_query(hapd, osta->addr, osta->multi_link_id);
+	}
+
+	if (self_sa_query)
+		return WLAN_STATUS_ASSOC_REJECTED_TEMPORARILY;
+	else if (self_disconnect)
+		return WLAN_STATUS_UNSPECIFIED_FAILURE;
+	else if (osta_sa_query_status)
+		return osta_sa_query_status;
+	else
+		return 0;
+}
