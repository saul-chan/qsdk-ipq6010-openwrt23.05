+static struct hostapd_data *get_partner_hapd(struct hostapd_data *hapd,
+					     int link_id)
+{
+	struct link_info *item;
+
+	if (!hapd->mlo_link->mld) {
+		wpa_printf(MSG_ERROR, "ERROR!! %s: mld is NULL\n", __func__);
+		return NULL;
+	}
+
+	if (hapd->mlo_link->link_id == link_id)
+		return hapd;
+
+	dl_list_for_each (item, &hapd->mlo_link->mld->links, struct link_info, list) {
+		struct hostapd_data *hapd_ptr;
+
+		hapd_ptr = item->hapd;
+		if (!hapd_ptr || (hapd_ptr == hapd))
+			continue;
+		if (hapd_ptr->mlo_link->link_id == link_id)
+			return hapd_ptr;
+	}
+	return NULL;
+}
