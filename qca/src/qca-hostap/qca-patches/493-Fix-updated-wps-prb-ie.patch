+static struct wpabuf * get_wps_ie(const u_int8_t *ie, int len, u32 vendor_type)
+{
+	struct wpabuf *buf;
+	const u8 *end, *pos;
+	int found_wps_ie = 0;
+	buf = wpabuf_alloc(len);
+	if (buf == NULL)
+		return NULL;
+
+	pos = ie;
+	end = ie + len;
+
+	while (end - pos > 1) {
+		u8 ie, len;
+
+		ie = pos[0];
+		len = pos[1];
+		if (len > end - pos - 2)
+			break;
+		pos += 2;
+		if (ie == WLAN_EID_VENDOR_SPECIFIC && len >= 4 &&
+		    vendor_type == WPA_GET_BE32(pos)) {
+			wpabuf_put_data(buf, pos + 4, len - 4);
+			found_wps_ie = 1;
+			break;
+		}
+		pos += len;
+	}
+
+	if (!found_wps_ie) {
+		wpabuf_free(buf);
+		buf = NULL;
+	}
+
+	return buf;
+}
 
