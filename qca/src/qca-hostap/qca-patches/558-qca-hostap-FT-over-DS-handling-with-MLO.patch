+#ifdef CONFIG_MLO
+const u8 * get_basic_mle_mld_addr(const u8 *buf, size_t len)
+{
+#define MULTI_LINK_CONTROL_TYPE_MASK 0x07
+	const size_t mld_addr_pos =
+		2 /* Control field */ +
+		1 /* Common Info Length field */;
+	const size_t fixed_len = mld_addr_pos +
+		ETH_ALEN /* MLD MAC Address field */;
+
+	if (len < fixed_len)
+		return NULL;
+
+	if ((buf[0] & MULTI_LINK_CONTROL_TYPE_MASK) !=
+	    MULTI_LINK_CONTROL_TYPE_BASIC)
+		return NULL;
+
+	return &buf[mld_addr_pos];
+}
+
+static const u8 *
+hostapd_mlie_to_get_mld_addr_from_assoc(struct hostapd_data *hapd,
+					const struct ieee80211_mgmt *mgmt,
+					size_t len, int reassoc)
+{
+	struct ieee802_11_elems elems;
+	const u8 *pos;
+	int assoc_ies_len;
+
+	if (!hapd->conf->mld_mac_addr)
+		return NULL;
+
+	pos = (reassoc ? mgmt->u.reassoc_req.variable : mgmt->u.assoc_req.variable);
+	if (!pos)
+		return NULL;
+
+	if (reassoc) {
+		len -= offsetof(struct ieee80211_mgmt, u.reassoc_req.variable);
+		assoc_ies_len = (int)len - (pos - mgmt->u.reassoc_req.variable);
+	} else {
+		len -= offsetof(struct ieee80211_mgmt, u.assoc_req.variable);
+		assoc_ies_len = (int)len - (pos - mgmt->u.assoc_req.variable);
+	}
+
+	if (ieee802_11_parse_elems(pos, assoc_ies_len,
+				   &elems, 0) == ParseFailed) {
+		wpa_printf(MSG_DEBUG,
+			   "MLD: Failed parsing Authentication frame");
+	}
+
+	if (!elems.mlo || !elems.mlo_len)
+		return NULL;
+
+	return get_basic_mle_mld_addr(elems.mlo, elems.mlo_len);
+}
+
+static struct sta_info *
+get_sta_from_ft_ds_list(struct hostapd_data *hapd,
+			const struct ieee80211_mgmt *mgmt,
+			size_t len, int reassoc)
+{
+	struct ft_over_ds_ml_entry *entry;
+	const u8 *sta_mld;
+	struct wpa_state_machine *wpa_sm;
+	struct sta_info *sta;
+	int sa_query_status = 0;
+
+	if (!hapd->mlo_link || !hapd->mlo_link->mld)
+		return NULL;
+
+	sta_mld = hostapd_mlie_to_get_mld_addr_from_assoc(hapd, mgmt, len, reassoc);
+	entry = ap_get_ft_ds_ml_sta(hapd, sta_mld);
+	if (!entry)
+		return NULL;
+
+	wpa_sm = entry->wpa_sm;
+	eloop_cancel_timeout(hostap_ft_ds_ml_sta_timeout, entry, NULL);
+	dl_list_del(&entry->list);
+	os_free(entry);
+
+	if (wpa_sm) {
+		wpa_auth_sta_addr_change(wpa_sm, mgmt->sa);
+		wpa_init_partner_link_group(wpa_sm, hapd->wpa_auth, NULL);
+		wpa_auth_sta_set_next_active_auth(wpa_sm, entry->wpa_auth, hapd->wpa_auth);
+	} else {
+		/*
+		 * WPA-SM was not newly allocated during
+		 * DS FT-Request. This means that there may be an existing
+		 * MLD-STA (with same MLD mac) which has an initialized wpa-sm 
+		 * and we do not want to modify this state machine without going
+		 * through the SA Query cycle (i.e., ensuring this new STA is 
+		 * not a spoof/fake)
+		 *
+		 * So this new STA has to be responded with
+		 * assoc-failure, either with TEMP-REJECT (in case of a valid
+		 * SA Query scenario, or UNSPECIFIED failure). 
+		 * Currently we cannot handle dynamic changing of the MLD 
+		 * structure, i.e., change in link information for a given
+		 * MLD mac address
+		 */
+		struct sta_info_ml *osta_ml;
+
+		osta_ml = ap_get_sta_mlo_obj(hapd, sta_mld);
+		if (!osta_ml)
+			return NULL;
+		if (!osta_ml->assoc_link_sta)
+			return NULL;
+
+		sa_query_status =
+		mlo_partner_sta_sa_query(hapd, osta_ml->assoc_link_sta->addr,
+					 osta_ml->assoc_link_sta->multi_link_id);
+		if (!sa_query_status)
+			/*
+			 * Unless the WPA-SM was newly allocated during
+			 * the FT-REQUEST, we cannot handle
+			 * the Assoc frame, without receiving Auth frame
+			 * also, i.e., without a sta_info node in place
+			 * So even if SA-Query status is 0, we have to
+			 * respond failure to this station
+			 */
+			sa_query_status = WLAN_STATUS_UNSPECIFIED_FAILURE;
+	}
+
+	sta = ap_sta_add(hapd, mgmt->sa);
+	if (!sta) {
+		if (wpa_sm)
+			wpa_auth_sta_deinit(wpa_sm);
+		return NULL;
+	}
+
+	sta->auth_alg = WLAN_AUTH_FT;
+	sta->ft_over_ds = 1;
+	sta->wpa_sm = wpa_sm;
+	sta->ft_over_ds_saquery_status = sa_query_status;
+
+	return sta;
+}
