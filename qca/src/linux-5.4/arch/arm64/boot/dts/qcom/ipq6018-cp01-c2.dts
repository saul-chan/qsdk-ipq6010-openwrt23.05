/dts-v1/;
#include "ipq6018.dtsi"
#include "ipq6018-cpr-regulator.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. IPQ6018/AP-CP01-C2";
	compatible = "qcom,ipq6018-ap-cp01-c2",  "qcom,ipq6018";

	aliases {
		serial0 = &blsp1_uart3;
		serial1 = &blsp1_uart1;  // 恢复uart1
		serial2 = &blsp1_uart2;
		serial3 = &blsp1_uart5;  // 恢复uart5
		sdhc1 = &sdhc_1;
		/*
		 * Aliases as required by u-boot
		 * to patch MAC addresses
		 */
		ethernet0 = "/soc/dp1";
		ethernet1 = "/soc/dp2";
		ethernet2 = "/soc/dp3";
		ethernet3 = "/soc/dp4";
		ethernet4 = "/soc/dp5";
	};

	chosen {
		stdout-path = "serial0:115200n8";
		bootargs-append = " swiotlb=1";
	};
};


&blsp1_uart3 {
	pinctrl-0 = <&serial_3_pins>;
	pinctrl-names = "default";
	status = "ok";
};

&blsp1_uart2 {
	pinctrl-0 = <&hsuart_pins>;
	pinctrl-names = "default";
	qca,bt-rfr-fixup;
	dmas = <&blsp_dma 2>,
		<&blsp_dma 3>;
	dma-names = "tx", "rx";
	status = "ok";
};

// 添加缺失的串口设备配置
&blsp1_uart1 {
    pinctrl-0 = <&uart0_pins>;
    pinctrl-names = "default";
    status = "ok";
};

&blsp1_uart5 {
    pinctrl-0 = <&uart2_pins>;
    pinctrl-names = "default";
    status = "ok";
};


&tlmm {
	mdio_pins: mdio_pinmux {
		mux_0 {
			pins = "gpio64";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};
		mux_1 {
			pins = "gpio65";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
		mux_2 {
			pins = "gpio75";
			function = "gpio";
			bias-pull-up;
		};
		mux_3 {
			pins = "gpio77";
			function = "gpio";
			bias-pull-up;
		};
	};

	hsuart_pins: hsuart_pins {
		mux {
			pins = "gpio71", "gpio72", "gpio69", "gpio70";
			function = "blsp1_uart";
			drive-strength = <8>;
			bias-disable;
		};
	};
	
	// 添加对应的pin配置
    uart0_pins: uart0_pins {
        mux {
            pins = "gpio40", "gpio41";
            function = "blsp0_uart";
            drive-strength = <8>;
            bias-pull-down;
        };
    };

    uart2_pins: uart2_pins {
        mux {
            pins = "gpio57", "gpio58"; 
            function = "blsp4_uart";
            drive-strength = <8>;
            bias-pull-down;
        };
    };
		
	button_pins: button_pins {
		reset_button {
			pins = "gpio79";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

   /*
	* do1_hog {
    *    gpio-hog; 
    *    gpios = <33 GPIO_ACTIVE_HIGH>; 
    *    output-high;
    *    line-name = "do1";
    * };

    * din1_hog {
    *    gpio-hog;
    *    gpios = <30 GPIO_ACTIVE_HIGH>;
    *    input; 
    *    bias-pull-up; 
    *    line-name = "din1";
    * };
	*/
	
	leds_pins: leds_pins {
		led_5g {
			pins = "gpio35";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
		led_2g {
			pins = "gpio37";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
		led_system {
			pins = "gpio34";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
		led_rssi1 {
			pins = "gpio18";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
		led_rssi2 {
			pins = "gpio22";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
		led_rssi3 {
			pins = "gpio23";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
		led_rssi4 {
			pins = "gpio24";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};	
		led_rssi5 {
			pins = "gpio29";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
		led_rssi6 {
			pins = "gpio31";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
		led_rssi7 {
			pins = "gpio32";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
		led_rssi8 {
			pins = "gpio33";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
		};
		m_gpio {
			pins = "gpio0","gpio20","gpio25","gpio30","gpio38","gpio39","gpio61","gpio73";
			function = "gpio";
			drive-strength = <4>;
			bias-pull-down;
		};
	};

};

&soc {
	mdio: mdio@90000 {
		pinctrl-0 = <&mdio_pins>;
		pinctrl-names = "default";
		phy-reset-gpio = <&tlmm 75 0 &tlmm 77 0>;
		status = "ok";
		phy0: ethernet-phy@0 {
			reg = <0>;
		};
		phy1: ethernet-phy@1 {
			reg = <1>;
		};
		phy2: ethernet-phy@2 {
			reg = <2>;
		};
		phy3: ethernet-phy@3 {
			reg = <3>;
		};
		phy4: ethernet-phy@4 {
			reg = <4>;
		};
	};

	dp1 {
		device_type = "network";
		compatible = "qcom,nss-dp";
		qcom,id = <1>;
		reg = <0x3a001000 0x200>;
		qcom,mactype = <0>;
		local-mac-address = [000000000000];
		qcom,link-poll = <1>;
		qcom,phy-mdio-addr = <0>;
		phy-mode = "sgmii";
	};

	dp2 {
		device_type = "network";
		compatible = "qcom,nss-dp";
		qcom,id = <2>;
		reg = <0x3a001200 0x200>;
		qcom,mactype = <0>;
		local-mac-address = [000000000000];
		qcom,link-poll = <1>;
		qcom,phy-mdio-addr = <1>;
		phy-mode = "sgmii";
	};

	dp3 {
		device_type = "network";
		compatible = "qcom,nss-dp";
		qcom,id = <3>;
		reg = <0x3a001400 0x200>;
		qcom,mactype = <0>;
		local-mac-address = [000000000000];
		qcom,link-poll = <1>;
		qcom,phy-mdio-addr = <2>;
		phy-mode = "sgmii";
	};

	dp4 {
		device_type = "network";
		compatible = "qcom,nss-dp";
		qcom,id = <4>;
		reg = <0x3a001600 0x200>;
		qcom,mactype = <0>;
		local-mac-address = [000000000000];
		qcom,link-poll = <1>;
		qcom,phy-mdio-addr = <3>;
		phy-mode = "sgmii";
	};
	
	dp5 {
		device_type = "network";
		compatible = "qcom,nss-dp";
		qcom,id = <5>;
		reg = <0x3a001800 0x200>;
		qcom,mactype = <0>;
		local-mac-address = [000000000000];
		qcom,link-poll = <1>;
		qcom,phy-mdio-addr = <4>;
		phy-mode = "sgmii";
	};
	
	ess-switch@3a000000 {
		switch_cpu_bmp = <0x1>;  /* cpu port bitmap */
		switch_lan_bmp = <0x1e>; /* lan port bitmap */
		switch_wan_bmp = <0x20>; /* wan port bitmap */
		switch_inner_bmp = <0xc0>; /*inner port bitmap*/
		switch_mac_mode = <0x0>; /* mac mode for uniphy instance0*/
		switch_mac_mode1 = <0xff>; /* mac mode for uniphy instance1*/
		switch_mac_mode2 = <0xff>; /* mac mode for uniphy instance2*/
		qcom,port_phyinfo {
			port@0 {
				port_id = <1>;
				phy_address = <0>;
			};
			port@1 {
				port_id = <2>;
				phy_address = <1>;
			};
			port@2 {
				port_id = <3>;
				phy_address = <2>;
			};
			port@3 {
				port_id = <4>;
				phy_address = <3>;
			};
			port@4 {
				port_id = <5>;
				phy_address = <4>;
			};
		};
	};
	
 	gpio_keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&tlmm 79 GPIO_ACTIVE_LOW>;
			linux,input-type = <1>;
			debounce-interval = <60>;
		};
	}; 

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&leds_pins>;
		pinctrl-names = "default";

		led@35 {
			label = "led_5g";
			gpios = <&tlmm 35 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "led_5g";
			default-state = "off";
		};
		led@37 {
			label = "led_2g";
			gpios = <&tlmm 37 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "led_2g";
			default-state = "off";
		};
		led@34 {
			label = "led_system";
			gpios = <&tlmm 34 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "timer";
			default-state = "off";
		};
		led@18 {
			label = "led_rssi1";
			gpios = <&tlmm 18 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "rssi1";
			default-state = "off";
		};
		led@22 {
			label = "led_rssi2";
			gpios = <&tlmm 22 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "rssi2";
			default-state = "off";
		};
		led@23 {
			label = "led_rssi3";
			gpios = <&tlmm 23 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "rssi3";
			default-state = "off";
		};
		led@24 {
			label = "led_rssi4";
			gpios = <&tlmm 24 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "rssi4";
			default-state = "off";
		};
		led@29 {
			label = "led_rssi5";
			gpios = <&tlmm 29 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "rssi5";
			default-state = "off";
		};
		led@31 {
			label = "led_rssi6";
			gpios = <&tlmm 31 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "rssi6";
			default-state = "off";
		};
		led@32 {
			label = "led_rssi7";
			gpios = <&tlmm 32 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "rssi7";
			default-state = "off";
		};
		led@33 {
			label = "led_rssi8";
			gpios = <&tlmm 33 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "rssi8";
			default-state = "off";
		};
		led@30 {
			label = "sim_sw";
			gpios = <&tlmm 30 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "sim_sw";
			default-state = "on";
		};

		led@25 {
			label = "pwr_pci";
			gpios = <&tlmm 25 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "pwr_pci";
			default-state = "on";
		};
		led@61 {
			label = "pwr_usb";
			gpios = <&tlmm 61 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "pwr_usb";
			default-state = "on";
		};
		led@38 {
			label = "gps_en";
			gpios = <&tlmm 38 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "gps_en";
			default-state = "off";
		};
		led@0 {
			label = "can_rst";
			gpios = <&tlmm 0 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "can_rst";
			default-state = "off";
		};
		led@20 {
			label = "can_cfg";
			gpios = <&tlmm 20 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "can_cfg";
			default-state = "off";
		};
		led@73 {
			label = "poe_en";
			gpios = <&tlmm 73 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "poe_en";
			default-state = "off";
		};
		led@39 {
			label = "rs232_en";
			gpios = <&tlmm 39 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "rs232_en";
			default-state = "on";
		};
	};
};

&qpic_bam {
	status = "ok";
};

&pcie_phy {
	status = "ok";
};

&pcie0 {
	status = "ok";
};

&qusb_phy_1 {
	status = "ok";
};

&usb2 {
	status = "ok";
};

&qusb_phy_0 {
	status = "ok";
};

&ssphy_0 {
	status = "ok";
};

&usb3 {
	status = "ok";
};

&nss_crypto {
	status = "ok";
};

&sdhc_1 {
	status = "ok";
};
